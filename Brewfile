# Brewfile - Homebrew bundle for macOS development environment

# ============================================================================
# Taps
# ============================================================================
tap "homebrew/bundle"
tap "homebrew/cask"
tap "homebrew/cask-fonts"
tap "homebrew/core"
tap "mongodb/brew"

# ============================================================================
# Core Utilities
# ============================================================================
brew "coreutils"        # GNU core utilities
brew "moreutils"        # Additional Unix utilities
brew "findutils"        # GNU find, locate, updatedb, xargs
brew "gnu-sed"          # GNU sed
brew "gnu-tar"          # GNU tar
brew "grep"             # GNU grep
brew "wget"             # Internet file retriever
brew "curl"             # Command line tool for transferring data
brew "tree"             # Display directories as trees
brew "htop"             # Interactive process viewer
brew "tmux"             # Terminal multiplexer
brew "jq"               # JSON processor
brew "yq"               # YAML processor
brew "ripgrep"          # Fast search tool
brew "fzf"              # Fuzzy finder
brew "bat"              # Better cat with syntax highlighting
brew "exa"              # Modern replacement for ls
brew "fd"               # Simple, fast alternative to find
brew "tldr"             # Simplified man pages

# ============================================================================
# Version Control
# ============================================================================
brew "git"              # Distributed version control
brew "git-lfs"          # Git extension for large files
brew "gh"               # GitHub CLI
brew "tig"              # Text-mode interface for git

# ============================================================================
# Shell
# ============================================================================
brew "zsh"              # Zsh shell
brew "zsh-completions"  # Additional zsh completions
brew "zsh-syntax-highlighting"
brew "zsh-autosuggestions"

# ============================================================================
# Programming Languages
# ============================================================================

# Node.js
brew "node"             # Node.js
brew "nvm"              # Node version manager
brew "yarn"             # JavaScript package manager

# Python
