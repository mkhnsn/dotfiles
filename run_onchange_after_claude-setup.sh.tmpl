#!/usr/bin/env bash
# Claude Code: user-scope MCP servers and plugins. MCP servers live in ~/.claude.json,
# which Claude Code rewrites constantly, so they're registered with the CLI instead of
# deployed as a file. Runs when this script changes; enabledPlugins comes from
# dot_claude/modify_settings.json.
set -uo pipefail
{{ template "todo.sh" }}

command -v claude >/dev/null 2>&1 || { todo "Claude Code: install the CLI (brew install --cask claude-code), then chezmoi apply"; exit 0; }
# claude (Bun) can't use a terminal it didn't open as stdin; nothing here needs input.
exec </dev/null

# ---- MCP servers (user scope) ----
mcp() {  # mcp <name> <json>: (re)register so the definition here wins
  claude mcp remove --scope user "$1" </dev/null >/dev/null 2>&1 || true
  claude mcp add-json --scope user "$1" "$2" </dev/null >/dev/null || todo "Claude Code: couldn't register the $1 MCP server"
}
{{ if and (eq .chezmoi.os "darwin") (not (dig "is_server" false .)) -}}
# fusion and btt are local apps' own MCP endpoints (they answer only while the app runs);
# homeassistant is read-only, its token in the Keychain from mac-setup (ha-mcp --store-token).
# This script runs only when its rendered text changes, so a failed registration would stay
# missing. The line below lists the servers missing from ~/.claude.json at render time, plus
# a timestamp while any are: the script then re-runs on every apply until they're all there.
{{- $names := list }}
{{- range splitList "\n" (includeTemplate "claude-mcp-servers" .) }}{{ with regexFind "^\\S+" . }}{{ $names = append $names . }}{{ end }}{{ end }}
{{- $missing := output "sh" "-c" (printf "command -v jq >/dev/null || exit 0; sd='/Applications/Elgato Stream Deck.app/Contents/Helpers/streamdeck-mcp'; for n in %s $([ -x \"$sd\" ] && echo StreamDeck); do jq -e --arg n \"$n\" '.mcpServers[$n]' \"$HOME/.claude.json\" >/dev/null 2>&1 || printf '%%s ' \"$n\"; done; true" (join " " $names)) | trim }}
# Not registered: {{ $missing | default "none" }}{{ if $missing }} (retry {{ now | unixEpoch }}){{ end }}
while read -r name json; do
  [ -n "$name" ] && mcp "$name" "$json"
done <<'SERVERS'
{{ template "claude-mcp-servers" . }}
SERVERS
# Raycast registers its own server ("raycast", with a per-app token) from Raycast's
# settings: MCP Server > Connect App > Claude Code. The end-of-apply summary checks it.
# Stream Deck's MCP helper ships with Stream Deck 8 (beta from Elgato; Homebrew has 7.x).
# Re-runs once it's installed: {{ if stat "/Applications/Elgato Stream Deck.app/Contents/Helpers/streamdeck-mcp" }}present{{ else }}missing{{ end }}
sd_mcp="/Applications/Elgato Stream Deck.app/Contents/Helpers/streamdeck-mcp"
if [ -x "$sd_mcp" ]; then
  mcp StreamDeck "$(jq -cn --arg c "$sd_mcp" '{type:"stdio",command:$c,args:[]}')"
else
  claude mcp remove --scope user StreamDeck >/dev/null 2>&1 || true  # summary flags it
fi
{{ end -}}

# Cloudflare's API server, read-only (docs/cloudflare-mcp.md), on every machine that has the
# token: cf-mcp-headers reads it from the Keychain on macOS (mac-setup stores it) or from
# ~/.config/cf-mcp/token on Linux. Where it's definitely absent the server is removed, so
# sessions don't carry one that can't connect. With no token at connect time, the static
# "Bearer missing" is sent: the server rejects it, so Claude Code never falls back to an OAuth
# sign-in, which could grant write access. The lines below change when the token is stored or
# the server goes missing, so the script re-runs then.
{{- /* Whether the token exists, without reading it: no Keychain ACL prompt, and a locked
       Keychain (apply over SSH) gives "unknown", which leaves the registration alone.
       find-generic-password exits 44 only when the item isn't there. */}}
{{- $cfToken := "no" }}
{{- if eq .chezmoi.os "darwin" }}
{{- $cfToken = output "sh" "-c" "security find-generic-password -s cf-mcp -a cloudflare-readonly >/dev/null 2>&1; case $? in 0) echo yes ;; 44) echo no ;; *) echo unknown ;; esac" | trim }}
{{- else if stat (joinPath .chezmoi.homeDir ".config/cf-mcp/token") }}
{{- $cfToken = "yes" }}
{{- end }}
# Token stored: {{ $cfToken }}
{{- if eq $cfToken "yes" }}
# Registered: {{ output "sh" "-c" "command -v jq >/dev/null || { echo unknown; exit 0; }; jq -e '.mcpServers.cloudflare' \"$HOME/.claude.json\" >/dev/null 2>&1 && echo yes || echo \"no (retry $(date +%s))\"" | trim }}
mcp cloudflare '{"type":"http","url":"https://mcp.cloudflare.com/mcp","headers":{"Authorization":"Bearer missing"},"headersHelper":"~/.local/bin/cf-mcp-headers"}'
{{- else if eq $cfToken "no" }}
claude mcp remove --scope user cloudflare >/dev/null 2>&1 || true
{{- end }}

# ---- Plugins (official marketplace) ----
claude plugin marketplace list 2>/dev/null | grep -q claude-plugins-official ||
  claude plugin marketplace add anthropics/claude-plugins-official >/dev/null 2>&1 ||
  todo "Claude Code: couldn't add the official plugin marketplace"
for p in playwright frontend-design security-guidance context7 microsoft-docs; do
  claude plugin list 2>/dev/null | grep -q "$p@claude-plugins-official" ||
    claude plugin install --scope user "$p@claude-plugins-official" >/dev/null 2>&1 ||
    todo "Claude Code: couldn't install the $p plugin (claude plugin install $p@claude-plugins-official)"
done
exit 0
