#!/usr/bin/env bash
set -euo pipefail

{{ if and (eq .chezmoi.os "linux") (or .full_setup (dig "dev_openshift" false .)) -}}

{{ template "todo.sh" }}

# General dev tools on Linux: Node (fnm), pnpm, Python venv and Ansible. macOS gets node,
# pnpm, uv and ansible from the Brewfile. Not part of `dev_openshift`: that flag only adds
# what the client work needs (run_after_dev-openshift).
# Plain run_ (every apply, after run_install-packages has installed curl, unzip and uv): each
# step checks for its own tool, so a failed download is retried on the next apply.

mkdir -p "$HOME/.local/bin"
export PATH="$HOME/.local/bin:$PATH"

# Node through fnm (env.zsh wires up `fnm env --use-on-cd`), with the current LTS as the
# default unless a default is already set.
install_node() {
  command -v curl >/dev/null 2>&1 || return 0
  if ! command -v fnm >/dev/null 2>&1; then
    curl -fsSL https://fnm.vercel.app/install \
      | bash -s -- --install-dir "$HOME/.local/bin" --skip-shell >/dev/null 2>&1 || true
  fi
  if ! command -v fnm >/dev/null 2>&1; then
    todo "linux-dev-tools: fnm failed to install (no Node); run 'chezmoi apply' again"
    return 0
  fi
  # `fnm default` with no argument prints the default, or fails when there is none.
  if ! fnm default >/dev/null 2>&1; then
    if fnm install --lts >/dev/null 2>&1; then
      fnm default lts-latest >/dev/null 2>&1 || true
    else
      todo "linux-dev-tools: fnm install --lts failed (no Node); run 'chezmoi apply' again"
    fi
  fi
}

# pnpm 12 as its own executable (runs without Node; Node 25+ no longer ships corepack).
# https://pnpm.io/installation
install_pnpm() {
  command -v pnpm >/dev/null 2>&1 && return 0
  command -v curl >/dev/null 2>&1 || return 0
  local pnpm_arch
  case "$(uname -m)" in
    x86_64|amd64)  pnpm_arch="x64" ;;
    aarch64|arm64) pnpm_arch="arm64" ;;
    *)             return 0 ;;
  esac
  local PNPM_VERSION="12.23.0"
  local dest="$HOME/.local/share/pnpm-standalone"
  local tmpdir
  tmpdir="$(mktemp -d)"
  if curl -fsSL "https://github.com/pnpm/pnpm/releases/download/v${PNPM_VERSION}/pnpm-linux-${pnpm_arch}.tar.gz" \
      | tar -xz -C "$tmpdir" 2>/dev/null && [[ -x "$tmpdir/pnpm" ]]; then
    rm -rf "$dest"
    mkdir -p "$HOME/.local/share"
    mv "$tmpdir" "$dest"
    chmod 755 "$dest"
    ln -sf "$dest/pnpm" "$HOME/.local/bin/pnpm"
  else
    rm -rf "$tmpdir"
    todo "linux-dev-tools: pnpm failed to install; run 'chezmoi apply' again"
  fi
}

# Python with venv and pip (uv covers most uses; some tools still call python3 -m venv).
install_python_venv() {
  python3 -c 'import venv, ensurepip' >/dev/null 2>&1 && return 0
  local sudo=()
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
      sudo=(sudo)
    else
      todo "linux-dev-tools: python3 has no venv (sudo needs a password); run 'chezmoi apply' from a terminal"
      return 0
    fi
  fi
  if command -v apt-get >/dev/null 2>&1; then
    # noninteractive: python3-full pulls in tzdata, which otherwise stops to ask for a time zone.
    "${sudo[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y python3-venv python3-pip >/dev/null 2>&1 || true
    "${sudo[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y python3-full >/dev/null 2>&1 || true   # not on older releases
  elif command -v dnf >/dev/null 2>&1; then
    "${sudo[@]}" dnf install -y python3 python3-pip >/dev/null 2>&1 || true
  elif command -v pacman >/dev/null 2>&1; then
    "${sudo[@]}" pacman -Sy --noconfirm python python-pip >/dev/null 2>&1 || true
  fi
  python3 -c 'import venv, ensurepip' >/dev/null 2>&1 ||
    todo "linux-dev-tools: python3 still has no venv; install your distro's python3 venv package"
}

# Ansible, isolated as a uv tool (the ansible package's commands come from ansible-core).
install_ansible() {
  command -v ansible >/dev/null 2>&1 && return 0
  if ! command -v uv >/dev/null 2>&1; then
    todo "linux-dev-tools: uv is missing, so Ansible isn't installed; run 'chezmoi apply' again"
    return 0
  fi
  uv tool install --quiet --with ansible ansible-core || todo "linux-dev-tools: ansible failed to install"
}

install_node
install_pnpm
install_python_venv
install_ansible

{{ end -}}
