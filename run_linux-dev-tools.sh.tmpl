#!/usr/bin/env bash
set -euo pipefail

{{ if and (eq .chezmoi.os "linux") (or .full_setup (dig "dev_openshift" false .)) -}}

{{ template "todo.sh" }}

# General dev tools on Linux: mise (Node and pnpm), Python venv and Ansible. macOS gets mise,
# uv and ansible from the Brewfile. Not part of `dev_openshift`: that flag only adds what the
# client work needs (run_after_dev-openshift).
# Plain run_ (every apply, after run_install-packages has installed curl, unzip and uv): each
# step checks for its own tool, so a failed download is retried on the next apply.

mkdir -p "$HOME/.local/bin"
export PATH="$HOME/.local/bin:$PATH"

# mise in ~/.local/bin. It isn't in Fedora's repositories, so this is a pinned release,
# checked against its SHA-256 (the release's SHASUMS256.txt). To update, change the version
# and both sums. run_after_mise-tools then installs the Node and pnpm that
# ~/.config/mise/config.toml names; ~/.zshenv puts its shims on PATH.
# https://github.com/jdx/mise/releases
MISE_VERSION="2026.11.14"
install_mise() {
  local bin="$HOME/.local/bin/mise"
  [[ "$("$bin" --version 2>/dev/null)" == "$MISE_VERSION "* ]] && return 0
  command -v curl >/dev/null 2>&1 || return 0
  local arch sum
  case "$(uname -m)" in
    x86_64|amd64)  arch="x64";   sum="6fa596291e9758106f761fea4f8e7fac6c3e7ff4714d5c0b9a76e16068db14f6" ;;
    aarch64|arm64) arch="arm64"; sum="7bd3b2d5ffff077a7662ba186c09600e5b40c1eee9df0c264ed67642ce0a8698" ;;
    *) todo "linux-dev-tools: mise has no build for $(uname -m), so there's no Node or pnpm"; return 0 ;;
  esac
  local tmp
  tmp="$(mktemp)"
  if curl -fsSL "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/mise-v${MISE_VERSION}-linux-${arch}" -o "$tmp" &&
      printf '%s  %s\n' "$sum" "$tmp" | sha256sum -c --status; then
    install -m 0755 "$tmp" "$bin"
  else
    todo "linux-dev-tools: mise $MISE_VERSION failed to download or didn't match its checksum; run 'chezmoi apply' again"
  fi
  rm -f "$tmp"
}

# Python with venv and pip (uv covers most uses; some tools still call python3 -m venv).
install_python_venv() {
  python3 -c 'import venv, ensurepip' >/dev/null 2>&1 && return 0
  local sudo=()
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
      sudo=(sudo)
    else
      todo "linux-dev-tools: python3 has no venv (sudo needs a password); run 'chezmoi apply' from a terminal"
      return 0
    fi
  fi
  if command -v apt-get >/dev/null 2>&1; then
    # noninteractive: python3-full pulls in tzdata, which otherwise stops to ask for a time zone.
    "${sudo[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y python3-venv python3-pip >/dev/null 2>&1 || true
    "${sudo[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y python3-full >/dev/null 2>&1 || true   # not on older releases
  elif command -v dnf >/dev/null 2>&1; then
    "${sudo[@]}" dnf install -y python3 python3-pip >/dev/null 2>&1 || true
  elif command -v pacman >/dev/null 2>&1; then
    "${sudo[@]}" pacman -Sy --noconfirm python python-pip >/dev/null 2>&1 || true
  fi
  python3 -c 'import venv, ensurepip' >/dev/null 2>&1 ||
    todo "linux-dev-tools: python3 still has no venv; install your distro's python3 venv package"
}

# Ansible, isolated as a uv tool (the ansible package's commands come from ansible-core).
install_ansible() {
  command -v ansible >/dev/null 2>&1 && return 0
  if ! command -v uv >/dev/null 2>&1; then
    todo "linux-dev-tools: uv is missing, so Ansible isn't installed; run 'chezmoi apply' again"
    return 0
  fi
  uv tool install --quiet --with ansible ansible-core || todo "linux-dev-tools: ansible failed to install"
}

install_mise
install_python_venv
install_ansible

{{ end -}}
