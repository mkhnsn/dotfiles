[user]
  name = Mike Hansen
  email = mike@unstablestudios.com

[core]
  editor = nano
{{- if lookPath "delta" }}
  pager = delta
{{- else }}
  pager = less -FRX --mouse
{{- end }}

[push]
  autoSetupRemote = true

[pull]
  rebase = true
  
{{- if not (env "CODESPACES") }}
[user]
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMDSNoyopg2gar0Lwf2lT+tSQbbDel/oSD5zJwjq69Z1

[gpg]
  format = ssh

[commit]
  gpgsign = true

[gpg "ssh"]
  # Use a portable path so it works on macOS + Linux
  allowedSignersFile = ~/.config/git/allowed_signers
{{- else }}
[commit]
  gpgsign = false
{{- end }}

[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential

[include]
  path = ~/.gitconfig.local

{{- if lookPath "delta" }}
[interactive]
  diffFilter = delta --color-only

[include]
    path = ~/.config/git/delta/themes.gitconfig

[delta]
  features = arctic-fox
  navigate = true  # use n and N to move between diff sections
  side-by-side = true
  hyperlinks = true
  hyperlinks-file-link-format = "vscode://file/{path}:{line}"
  pager = less -FRX --mouse
{{- end }}

[merge]
  conflictStyle = zdiff3

[alias]
  sync = "!sh -c 'git fetch upstream --prune >/dev/null 2>&1 || true; cb=$(git rev-parse --abbrev-ref HEAD 2>/dev/null); ub=$(git remote show upstream 2>/dev/null | sed -n \"s/.*HEAD branch: //p\"); if [ -z \"$ub\" ]; then ub=$(git symbolic-ref --quiet --short refs/remotes/upstream/HEAD 2>/dev/null | sed \"s@^upstream/@@\"); fi; if [ -z \"$cb\" ]; then cb=DETACHED; fi; if [ -z \"$ub\" ]; then echo \"❌ No upstream default branch found. Run: git remote set-head upstream -a\"; echo \"(debug: cb=$cb, ub=$ub)\"; exit 1; fi; if [ \"$cb\" != \"$ub\" ]; then echo \"❌ Refusing to sync: you are on $cb (expected $ub)\"; exit 1; fi; git merge --no-edit \"upstream/$ub\"'"
  syncx = "!sh -c 'git fetch upstream --prune >/dev/null 2>&1 || true; ub=$(git remote show upstream 2>/dev/null | sed -n \"s/.*HEAD branch: //p\"); if [ -z \"$ub\" ]; then ub=$(git symbolic-ref --quiet --short refs/remotes/upstream/HEAD 2>/dev/null | sed \"s@^upstream/@@\"); fi; if [ -z \"$ub\" ]; then echo \"❌ No upstream default branch found. Run: git remote set-head upstream -a\"; exit 1; fi; git checkout \"$ub\" && git merge --no-edit \"upstream/$ub\"'"
  whoami = "!sh -c 'echo \"--- Remotes ---\"; git remote -v; echo; echo \"--- Identity ---\"; name=$(git config user.name); email=$(git config user.email); if [ -z \"$name\" ] || [ -z \"$email\" ]; then echo \"⚠️  Git identity NOT SET\"; else echo \"Name : $name\"; echo \"Email: $email\"; fi; echo; echo \"--- Branch ---\"; git branch --show-current'"