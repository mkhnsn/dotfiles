{{- if eq .chezmoi.os "darwin" -}}
{{- $macos := output "sw_vers" "-productVersion" | trim -}}
{{- if ge (atoi (index (splitList "." $macos) 0)) 27 -}}
#!/usr/bin/env bash
set -euo pipefail
# rendered for macOS {{ $macos }} — version embedded so OS upgrades re-trigger run_onchange

{{ template "todo.sh" }}

# macOS 27 Visual Intelligence shortcuts — disabled
#   261: Cmd+Shift+6     (Siri crosshair region select)
#   263: Cmd+Shift+Space (Ask Siri about active window — conflicts with 1Password Quick Access)
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 261 \
  '{ enabled = 0; value = { parameters = (54, 22, 1179648); type = standard; }; }'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 263 \
  '{ enabled = 0; value = { parameters = (32, 49, 1179648); type = standard; }; }'

/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u

echo "1Password: set Quick Access back to Cmd+Shift+Space (Settings → General → Show Quick Access)" >> "$DOTFILES_TODO"
{{- end -}}
{{- end }}