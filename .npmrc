# .npmrc - npm configuration

# Use exact versions by default when installing packages
save-exact=true

# Use https for registry
registry=https://registry.npmjs.org/

# Disable package-lock.json updates on every install (use npm ci for CI)
package-lock=true

# Show extended information about packages
loglevel=warn

# Don't save optional dependencies
save-optional=false

# Progress bar for long-running operations
progress=true

# Use a flat node_modules structure when possible
legacy-peer-deps=false

# Automatically install peer dependencies
install-links=true

# Set the init author name, email, url, and license defaults
# Uncomment and customize these as needed:
# init-author-name=Your Name
# init-author-email=your.email@example.com
# init-author-url=https://yourwebsite.com
# init-license=MIT
# init-version=1.0.0
