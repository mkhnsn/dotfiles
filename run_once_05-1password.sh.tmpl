#!/usr/bin/env bash
set -euo pipefail

{{ if and (eq .chezmoi.os "linux") (env "DOTFILES_FULL") -}}

SUDO=""
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  SUDO="sudo"
fi

# ---- Add 1Password repo and install ----
if command -v dnf >/dev/null 2>&1 || command -v yum >/dev/null 2>&1; then
  if [[ ! -f /etc/yum.repos.d/1password.repo ]]; then
    $SUDO rpm --import https://downloads.1password.com/linux/keys/1password.asc
    $SUDO tee /etc/yum.repos.d/1password.repo > /dev/null << 'REPO'
[1password]
name=1Password
baseurl=https://downloads.1password.com/linux/rpm/stable/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://downloads.1password.com/linux/keys/1password.asc
REPO
  fi
  command -v 1password >/dev/null 2>&1 || $SUDO dnf install -y 1password || true
  command -v op >/dev/null 2>&1 || $SUDO dnf install -y 1password-cli || true

elif command -v apt-get >/dev/null 2>&1; then
  if [[ ! -f /etc/apt/sources.list.d/1password.list ]]; then
    curl -fsSL https://downloads.1password.com/linux/keys/1password.asc | \
      $SUDO gpg --dearmor -o /usr/share/keyrings/1password-archive-keyring.gpg 2>/dev/null
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" | \
      $SUDO tee /etc/apt/sources.list.d/1password.list > /dev/null
    $SUDO mkdir -p /etc/debsig/policies/AC2D62742012EA22/
    curl -fsSL https://downloads.1password.com/linux/debian/debsig/1password.pol | \
      $SUDO tee /etc/debsig/policies/AC2D62742012EA22/1password.pol > /dev/null
    $SUDO mkdir -p /usr/share/debsig/keyrings/AC2D62742012EA22/
    curl -fsSL https://downloads.1password.com/linux/keys/1password.asc | \
      $SUDO gpg --dearmor -o /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg 2>/dev/null
    $SUDO apt-get update
  fi
  command -v 1password >/dev/null 2>&1 || $SUDO apt-get install -y 1password || true
  command -v op >/dev/null 2>&1 || $SUDO apt-get install -y 1password-cli || true

elif command -v pacman >/dev/null 2>&1; then
  # Arch: 1password is in AUR; CLI is available as a standalone download
  if ! command -v op >/dev/null 2>&1; then
    local arch
    arch="$(uname -m)"
    case "$arch" in
      x86_64)  curl -fsSL "https://cache.agilebits.com/dist/1P/op2/pkg/v2.30.3/op_linux_amd64_v2.30.3.zip" -o /tmp/op.zip ;;
      aarch64) curl -fsSL "https://cache.agilebits.com/dist/1P/op2/pkg/v2.30.3/op_linux_arm64_v2.30.3.zip" -o /tmp/op.zip ;;
      *)       echo "1password-cli: unsupported arch $arch"; exit 0 ;;
    esac
    $SUDO unzip -o /tmp/op.zip -d /usr/local/bin/ op 2>/dev/null || true
    rm -f /tmp/op.zip
  fi
fi

# ---- Ensure CLI config directory exists ----
mkdir -p ~/.config/op

echo ""
echo "1Password installed. Next steps:"
echo "  1. Open the 1Password desktop app and sign in"
echo "  2. Enable CLI integration in Settings > Developer"
echo "  3. Verify with: op whoami"

{{ end -}}
