#!/usr/bin/env bash
set -euo pipefail

{{ if and (eq .chezmoi.os "linux") .full_setup -}}

# Only on Fedora/dnf systems
command -v dnf >/dev/null 2>&1 || exit 0

SUDO=""
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  if command -v sudo >/dev/null 2>&1; then
    SUDO="sudo"
    if ! sudo -n true 2>/dev/null; then
      echo "fedora-repos: sudo requires password (non-interactive), skipping"
      exit 0
    fi
  else
    echo "fedora-repos: not root and sudo not available, skipping"
    exit 0
  fi
fi

# ---- RPM Fusion (free + nonfree) ----
if ! dnf repolist --enabled 2>/dev/null | grep -q 'rpmfusion-free'; then
  echo "fedora-repos: enabling RPM Fusion free..."
  $SUDO dnf install -y \
    "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
    || true
fi

if ! dnf repolist --enabled 2>/dev/null | grep -q 'rpmfusion-nonfree'; then
  echo "fedora-repos: enabling RPM Fusion nonfree..."
  $SUDO dnf install -y \
    "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm" \
    || true
fi

# Refresh appstream metadata after adding repos
$SUDO dnf group update core -y 2>/dev/null || true

# ---- Flathub (full, unfiltered) ----
if command -v flatpak >/dev/null 2>&1; then
  # Remove the neutered Fedora Flatpak remote (ships filtered subset)
  if flatpak remotes 2>/dev/null | grep -q 'fedora'; then
    echo "fedora-repos: removing filtered Fedora Flatpak remote..."
    flatpak remote-delete --force fedora 2>/dev/null || true
  fi

  if ! flatpak remotes 2>/dev/null | grep -q 'flathub'; then
    echo "fedora-repos: adding Flathub remote..."
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
  fi
fi

{{ end -}}
