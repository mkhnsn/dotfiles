#!/usr/bin/env bash
set -euo pipefail

DIR="$HOME/.config/zsh/plugins/pnpm-shell-completion"
BIN="$DIR/pnpm-shell-completion"

[[ -d "$DIR" ]] || exit 0
[[ -x "$BIN" ]] && exit 0

# Build if possible (uses Rust toolchain)
if command -v cargo >/dev/null 2>&1; then
  (cd "$DIR" && ./zplug.zsh) || true
fi