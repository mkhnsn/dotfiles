{{ if and .full_setup (eq (.op_mode | default "account") "service") -}}
#!/usr/bin/env bash
# Service-account boxes (Linux, WSL and macOS servers): save the 1Password token so
# later `chezmoi apply` runs and fresh shells (env.zsh sources the file) can read
# secrets without exporting it again. Runs every apply, so a token exported after the
# first apply is still saved; it never overwrites the file.
set -euo pipefail

TOKEN_ENV="$HOME/.config/op/service-account.env"
if [[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" && ! -f "$TOKEN_ENV" ]]; then
  mkdir -p "$HOME/.config/op"
  chmod 700 "$HOME/.config/op"
  (
    umask 077
    printf 'export OP_SERVICE_ACCOUNT_TOKEN=%q\n' "$OP_SERVICE_ACCOUNT_TOKEN" > "$TOKEN_ENV"
  )
  echo "1Password: saved service-account token to $TOKEN_ENV (0600)"
fi
{{ end -}}
