{{- if and (eq .chezmoi.os "darwin") (not (dig "is_server" false .)) -}}
#!/usr/bin/env bash
# Merge the saved app settings (macos/prefs) whenever they change.
# prefs hash: {{ output "sh" "-c" (printf "cat %q/macos/prefs/* | shasum" .chezmoi.sourceDir) | trim }}
set -uo pipefail
# Running apps are skipped (they'd write their own settings back); mac-setup re-checks.
# Exit 1 means running apps were skipped (it says which); 2 is an error. Neither fails the apply.
"$HOME/.local/bin/app-prefs" apply || true
{{ end -}}
