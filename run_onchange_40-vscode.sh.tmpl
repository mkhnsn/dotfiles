#!/usr/bin/env bash
set -euo pipefail

# Installs VS Code extensions from a list file.
# - Codespaces/devcontainers: installs the "codespace" list
# - Personal/full machines: if DOTFILES_FULL is set, installs the "full" list

# Need VS Code CLI available. In Codespaces it is usually `code` or `code-server`.
CODE_BIN=""
if command -v code >/dev/null 2>&1; then
  CODE_BIN="code"
elif command -v code-server >/dev/null 2>&1; then
  CODE_BIN="code-server"
else
  echo "vscode: code/code-server not found; skipping extension install."
  exit 0
fi

SOURCE_DIR="{{ .chezmoi.sourceDir }}"
LIST_DIR="$SOURCE_DIR/dot_config/vscode"

LIST_FILE="$LIST_DIR/extensions.codespace.txt"
if [[ -n "${DOTFILES_FULL:-}" ]]; then
  LIST_FILE="$LIST_DIR/extensions.full.txt"
fi

if [[ ! -r "$LIST_FILE" ]]; then
  echo "vscode: extension list not found: $LIST_FILE"
  exit 0
fi

echo "vscode: installing extensions from $LIST_FILE using $CODE_BIN"

# Read list, ignore blanks/comments, install one by one.
while IFS= read -r ext; do
  # trim whitespace
  ext="${ext#"${ext%%[![:space:]]*}"}"
  ext="${ext%"${ext##*[![:space:]]}"}"

  [[ -z "$ext" ]] && continue
  [[ "$ext" == \#* ]] && continue

  # Avoid failing the whole apply if one extension is unavailable.
  "$CODE_BIN" --install-extension "$ext" --force >/dev/null 2>&1 || {
    echo "vscode: failed to install $ext (continuing)"
  }
done < "$LIST_FILE"

exit 0