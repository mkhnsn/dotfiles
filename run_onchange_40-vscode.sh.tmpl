#!/usr/bin/env bash
set -euo pipefail

log() { printf "vscode: %s\n" "$*"; }

# Only run when the Code CLI is available. In Codespaces dotfiles phase,
# VS Code Server + `code` frequently isn't ready yet.
if ! command -v code >/dev/null 2>&1; then
  log "code CLI not found yet; skipping extension install"
  exit 0
fi

# Pick extension list
EXT_LIST=""
if [[ "${DOTFILES_FULL:-}" == "1" ]] || [[ "${DOTFILES_FULL:-}" == "true" ]]; then
  EXT_LIST="$HOME/.config/vscode/extensions.full.txt"
else
  EXT_LIST="$HOME/.config/vscode/extensions.minimal.txt"
fi

if [[ ! -r "$EXT_LIST" ]]; then
  log "extensions list not found: $EXT_LIST (skipping)"
  exit 0
fi

log "installing extensions from $EXT_LIST using code"

# Install each extension; never fail the whole run on one bad install
while IFS= read -r ext; do
  [[ -z "${ext// }" ]] && continue
  [[ "$ext" =~ ^# ]] && continue
  if ! code --install-extension "$ext" >/dev/null 2>&1; then
    log "failed to install $ext (continuing)"
  fi
done < "$EXT_LIST"

log "done"