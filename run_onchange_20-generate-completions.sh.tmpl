#!/usr/bin/env bash
set -euo pipefail

ZSH_COMPLETIONS_DIR="$HOME/.config/zsh/completions"
mkdir -p "$ZSH_COMPLETIONS_DIR"

# gh -> zsh completion
if command -v gh >/dev/null 2>&1; then
  gh completion -s zsh > "$ZSH_COMPLETIONS_DIR/_gh"
fi

# Rebuild compdump so new completions are picked up
rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"* 2>/dev/null || true