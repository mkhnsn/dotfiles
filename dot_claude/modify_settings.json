#!/bin/bash
# Merge chezmoi-managed settings into Claude Code settings.json.
# Preserves interactively-set keys (enabledPlugins, project-specific permissions, etc.)

set -euo pipefail

existing=$(cat)

# If file doesn't exist yet or is empty, start with empty object
if [ -z "$existing" ]; then
  existing='{}'
fi

# ---- hooks ----
hooks='{
  "PreToolUse": [{
    "matcher": "Bash",
    "hooks": [{
      "type": "command",
      "command": "bash ~/.claude/scripts/guard-destructive.sh",
      "timeout": 5
    }]
  },
  {
    "matcher": "Edit|Write",
    "hooks": [{
      "type": "command",
      "command": "bash ~/.claude/scripts/nudge-speckit.sh",
      "timeout": 3
    }]
  }],
  "PostToolUse": [{
    "matcher": "Edit|Write",
    "hooks": [{
      "type": "command",
      "command": "bash ~/.claude/scripts/post-edit-lint.sh",
      "timeout": 10,
      "async": true
    }]
  }]
}'

# ---- status line ----
statusline='{
  "type": "command",
  "command": "bash ~/.claude/scripts/statusline.sh"
}'

# ---- base permissions (merged into existing allow list) ----
base_permissions='[
  "Bash(git fetch)",
  "Bash(git fetch *)",
  "Bash(git pull)",
  "Bash(git pull *)",
  "Bash(git status)",
  "Bash(git status *)",
  "Bash(git log)",
  "Bash(git log *)",
  "Bash(git diff)",
  "Bash(git diff *)",
  "Bash(git branch)",
  "Bash(git branch *)",
  "Bash(git stash)",
  "Bash(git stash *)",
  "Bash(git remote *)",
  "Bash(git add *)",
  "Bash(git commit *)",
  "Bash(git push *)",
  "Bash(git push)",
  "Bash(git checkout *)",
  "Bash(git switch *)",
  "Bash(git merge *)",
  "Bash(git rebase *)",
  "Bash(gh pr:*)",
  "Bash(gh issue:*)",
  "Bash(gh api:*)",
  "Bash(gh run:*)",
  "Bash(gh repo:*)",
  "Bash(gh label:*)",
  "Bash(gh auth:*)",
  "Bash(ls:*)",
  "Bash(tree:*)",
  "Bash(wc:*)",
  "Bash(sort:*)",
  "Bash(mkdir:*)",
  "Bash(find-repo:*)",
  "mcp__ide__getDiagnostics",
  "WebFetch",
  "WebSearch",
  "Read(~/src/**)",
  "Edit(~/src/**)",
  "Write(~/src/**)"
]'

# Merge everything: hooks and statusLine are replaced; permissions.allow is merged + deduped
echo "$existing" | jq \
  --argjson hooks "$hooks" \
  --argjson statusline "$statusline" \
  --argjson base "$base_permissions" \
  '
    .hooks = $hooks |
    .statusLine = $statusline |
    .permissions.allow = ((.permissions.allow // []) + $base | unique) |
    .permissions.defaultMode = "bypassPermissions" |
    .env = ((.env // {}) + {"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"})
  '
