#!/usr/bin/env bash
set -euo pipefail
{{- if not (env "DOTFILES_FULL") }}
# Lite install — skip heavy dev tools
exit 0
{{- end }}

echo "[claude-code] Ensuring Claude Code CLI"

if command -v claude >/dev/null 2>&1; then
  echo "[claude-code] Found existing installation, checking for updates..."
  claude update || true
else
  echo "[claude-code] Installing via official installer..."
  curl -fsSL https://claude.ai/install.sh | sh
fi

echo "[claude-code] ✓ done"
