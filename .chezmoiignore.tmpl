scripts/
Makefile

# ─────────────────────────────────────────
# OS-specific ignore paths
# ─────────────────────────────────────────

{{- if eq .chezmoi.os "darwin" -}}
# VS Code on macOS uses ~/Library/Application Support/Code, not ~/.config/Code
.config/Code/
.config/Code/**
{{- end -}}

{{- if eq .chezmoi.os "linux" -}}
# VS Code on Linux uses ~/.config/Code, not ~/Library/Application Support/Code
Library/Application Support/Code/
Library/Application Support/Code/**
# iTerm2 is macOS-only
.config/iterm2/
.config/iterm2/**
{{- end -}}

{{- if env "CODESPACES" -}}
# GUI terminals are irrelevant in Codespaces
.config/ghostty/
.config/ghostty/**
.config/iterm2/
.config/iterm2/**
{{- end -}}

{{- /* ntfy config needs a working 1Password backend. Skip it when secrets can't
       be resolved: not a full setup, service mode with no token in the env yet,
       or account mode over SSH (the desktop app isn't reachable from an SSH
       session), so `chezmoi apply` degrades gracefully instead of hard-failing
       on op read. Ignored files are left as they are on disk. */ -}}
{{- $svc := and (hasKey . "op_mode") (eq .op_mode "service") -}}
{{- $svcNoToken := and $svc (not (env "OP_SERVICE_ACCOUNT_TOKEN")) -}}
{{- $acctOverSSH := and (not $svc) (env "SSH_CONNECTION") -}}
{{- $noOp := or $svcNoToken $acctOverSSH -}}
{{- if or (not .full_setup) $noOp }}
.ntfy.yml
{{- end -}}

{{- /* JFrog credentials: same 1Password gating as .ntfy.yml, and only on machines
       with the OpenShift toolchain, since the PL2/PL3 bundle builds are the only
       thing that uses them. */ -}}
{{- if or (not .full_setup) $noOp (not (dig "dev_openshift" false .)) }}
.config/jfrog-env
{{- end -}}
