# ─────────────────────────────────────────
# OS-specific ignore paths
# ─────────────────────────────────────────

{{- if eq .chezmoi.os "darwin" -}}
# VS Code on macOS uses ~/Library/Application Support/Code, not ~/.config/Code
.config/Code/
.config/Code/**
{{- end -}}

{{- if eq .chezmoi.os "linux" -}}
# VS Code on Linux uses ~/.config/Code, not ~/Library/Application Support/Code
Library/Application Support/Code/
Library/Application Support/Code/**
.config/iterm2/
.config/iterm2/**
{{- end -}}

{{- if not (env "CODESPACES") -}}
# VS Code Server (remote) config
.config/vscode-server/
.config/vscode-server/**
# VS Code Remote (Codespaces, WSL) config
.config/vscode-remote/
.config/vscode-remote/**
{{- end -}}