# ~/.local/share/chezmoi/.chezmoi.toml.tmpl (special filename read by `chezmoi init`)

{{- /* Hostname: default to current hostname, only prompt if not yet set */ -}}
{{- $hostname := .chezmoi.hostname -}}
{{- if and (hasKey . "hostname") (ne .hostname "") -}}
{{-   $hostname = .hostname -}}
{{- else -}}
{{-   $hostname = promptString (printf "Hostname for this machine (%s)" .chezmoi.hostname) -}}
{{-   if eq $hostname "" -}}
{{-     $hostname = .chezmoi.hostname -}}
{{-   end -}}
{{- end -}}

{{- /* Server flag: default No, only prompt if not yet set */ -}}
{{- $isServer := false -}}
{{- if hasKey . "is_server" -}}
{{-   $isServer = .is_server -}}
{{- else -}}
{{-   $isServer = promptBool "Is this a server/dev box? (y/N, default: No)" -}}
{{- end }}

{{- /* Full setup: enables 1Password, secrets. Env var seeds on first init, then persists. */ -}}
{{- $fullSetup := false -}}
{{- if hasKey . "full_setup" -}}
{{-   $fullSetup = .full_setup -}}
{{- else if env "DOTFILES_FULL" -}}
{{-   $fullSetup = true -}}
{{- else -}}
{{-   $fullSetup = promptBool "Full setup? (1Password, secrets) (y/N, default: No)" -}}
{{- end }}

{{- /* Ntfy title: only prompted on full_setup machines. Defaults to hostname. */ -}}
{{- $ntfyTitle := $hostname -}}
{{- if hasKey . "ntfy_title" -}}
{{-   $ntfyTitle = .ntfy_title -}}
{{- else if $fullSetup -}}
{{-   $ntfyTitle = promptString (printf "ntfy notification title (%s)" $hostname) -}}
{{-   if eq $ntfyTitle "" -}}
{{-     $ntfyTitle = $hostname -}}
{{-   end -}}
{{- end }}

[data]
  hostname = {{ $hostname | quote }}
  is_server = {{ $isServer }}
  full_setup = {{ $fullSetup }}
  ntfy_title = {{ $ntfyTitle | quote }}

{{- if lookPath "delta" }}

[diff]
pager = "delta"
{{- end }}

{{- if $fullSetup }}

[secret]
command = "op"

[onepassword]
mode = "account"
prompt = true
account = "unstablestudios" # subdomain is fine

{{- end }}
