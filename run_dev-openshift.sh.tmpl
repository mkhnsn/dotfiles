#!/usr/bin/env bash
set -euo pipefail

{{ if and (eq .chezmoi.os "linux") (dig "dev_openshift" false .) -}}

# OpenShift client dev toolchain (opt-in via the `dev_openshift` flag).
#   - Installs Node 22 LTS + Node 24, Python 3 + venv, Ansible, and Helm 3.x INSIDE WSL.
#   - On WSL, symlinks Podman / oc to the FIPS-approved Windows binaries
#     (does not install them — see scripts/windows-client.ps1 for the Windows side).
#     Helm is installed natively at v3.x because the Windows (winget) Helm is v4.x,
#     which breaks Helm-3 charts.
# Plain run_ (every apply): idempotent, each step guarded so it retries cleanly.

SUDO=""
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  command -v sudo >/dev/null 2>&1 && SUDO="sudo"
fi
mkdir -p "$HOME/.local/bin"

note() { printf '[dev-openshift] %s\n' "$*"; }

# ---- Node.js 22 LTS via fnm ----
if ! command -v fnm >/dev/null 2>&1; then
  note "installing fnm into ~/.local/bin"
  curl -fsSL https://fnm.vercel.app/install \
    | bash -s -- --install-dir "$HOME/.local/bin" --skip-shell >/dev/null 2>&1 || \
    note "fnm install failed; skipping Node"
fi
if command -v fnm >/dev/null 2>&1; then
  export PATH="$HOME/.local/bin:$PATH"
  eval "$(fnm env)" 2>/dev/null || true
  if ! fnm list 2>/dev/null | grep -q 'v22\.'; then
    note "installing Node 22 LTS"
    fnm install 22 >/dev/null 2>&1 || note "fnm install 22 failed"
  fi
  if ! fnm list 2>/dev/null | grep -q 'v24\.'; then
    note "installing Node 24 (some frontend repos pin it)"
    fnm install 24 >/dev/null 2>&1 || note "fnm install 24 failed"
  fi
  fnm alias default 22 >/dev/null 2>&1 || true
fi

# ---- Python 3 (full stdlib + venv) ----
if ! python3 -c 'import venv, ensurepip' >/dev/null 2>&1; then
  note "installing python3 + venv support"
  if command -v apt-get >/dev/null 2>&1; then
    $SUDO apt-get install -y python3-full python3-venv python3-pip 2>/dev/null || true
  elif command -v dnf >/dev/null 2>&1; then
    $SUDO dnf install -y python3 python3-pip 2>/dev/null || true
  elif command -v pacman >/dev/null 2>&1; then
    $SUDO pacman -Sy --noconfirm python python-pip 2>/dev/null || true
  fi
fi

# ---- Ansible (isolated; uv tool, falling back to a venv) ----
if ! command -v ansible >/dev/null 2>&1; then
  if command -v uv >/dev/null 2>&1; then
    note "installing ansible via uv tool"
    uv tool install --quiet ansible || note "uv tool install ansible failed"
  else
    note "uv not found; installing ansible into ~/.venvs/ansible"
    if python3 -m venv "$HOME/.venvs/ansible" 2>/dev/null; then
      "$HOME/.venvs/ansible/bin/pip" install --quiet --upgrade pip ansible || true
      ln -sf "$HOME/.venvs/ansible/bin/ansible"          "$HOME/.local/bin/ansible"
      ln -sf "$HOME/.venvs/ansible/bin/ansible-playbook" "$HOME/.local/bin/ansible-playbook"
    fi
  fi
fi

# ---- Helm 3.x (native; the Windows/winget Helm is 4.x, which breaks Helm-3 charts) ----
if ! { command -v helm >/dev/null 2>&1 && helm version --short 2>/dev/null | grep -q '^v3\.'; }; then
  note "installing Helm 3.x into ~/.local/bin"
  helm_tag="$(curl -fsSL 'https://api.github.com/repos/helm/helm/releases?per_page=40' 2>/dev/null | grep -oE '"tag_name": *"v3\.[0-9]+\.[0-9]+"' | head -1 | grep -oE 'v3\.[0-9.]+')"
  if [[ -n "$helm_tag" ]]; then
    helm_tmp="$(mktemp -d)"
    if curl -fsSL "https://get.helm.sh/helm-${helm_tag}-linux-amd64.tar.gz" | tar -xz -C "$helm_tmp" 2>/dev/null; then
      rm -f "$HOME/.local/bin/helm"   # drop any stale winget Helm 4 symlink
      install -m 0755 "$helm_tmp/linux-amd64/helm" "$HOME/.local/bin/helm"
      note "installed Helm $helm_tag"
    fi
    rm -rf "$helm_tmp"
  else
    note "could not resolve latest Helm 3 tag; skipping"
  fi
fi

# ---- Windows .exe shims (WSL only) ----
# Podman / oc come from the FIPS-approved Windows install, reached via WSL interop.
# Git stays WSL-native on purpose (shimming git.exe breaks path translation), and
# Helm is installed natively above (the Windows Helm is the wrong major). Best-effort.
if grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; then
  missing=()
  for tool in podman oc; do
    if exe="$(command -v "$tool.exe" 2>/dev/null)"; then
      ln -sf "$exe" "$HOME/.local/bin/$tool"
      note "linked $tool -> $exe"
    else
      missing+=("$tool")
    fi
  done

  # Build the exact "run it in Windows PowerShell" command, autodetecting the
  # Windows path to the bootstrap (no hardcoded distro name).
  src="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
  ps1="$src/scripts/windows-client.ps1"
  winps1=""
  if [[ -f "$ps1" ]] && command -v wslpath >/dev/null 2>&1; then
    winps1="$(wslpath -w "$ps1" 2>/dev/null || true)"
  fi

  if [[ ${#missing[@]} -gt 0 ]]; then
    echo ""
    echo "────────────────────────────────────────────────────────────────────"
    echo " OpenShift: Windows tools not found in WSL yet: ${missing[*]}"
    echo " Install them once from *Windows PowerShell* (not WSL):"
    echo ""
    if [[ -n "$winps1" ]]; then
      echo "   Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass"
      echo "   & \"$winps1\""
    else
      echo "   run: scripts/windows-client.ps1  (from the repo, in Windows PowerShell)"
    fi
    echo ""
    echo " Then re-run 'chezmoi apply' here to link podman/oc."
    echo "────────────────────────────────────────────────────────────────────"
  elif [[ -n "$winps1" ]]; then
    note "podman/oc linked. Windows bootstrap: & \"$winps1\""
  fi
fi

{{ end -}}
