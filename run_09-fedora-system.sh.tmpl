#!/usr/bin/env bash
set -euo pipefail

{{ if and (eq .chezmoi.os "linux") .full_setup -}}

command -v dnf >/dev/null 2>&1 || exit 0

{{ template "sudo-once.sh" "fedora-system" }}

# ---- Detect laptop vs desktop ----
# Match on sysfs type (names are driver-defined); ignore peripheral batteries
has_battery=false
for ps in /sys/class/power_supply/*; do
  [[ "$(cat "$ps/type" 2>/dev/null)" == "Battery" ]] || continue
  [[ "$(cat "$ps/scope" 2>/dev/null)" == "Device" ]] && continue
  has_battery=true
  break
done

# ---- TLP battery management (laptops only) ----
if [[ "$has_battery" == "true" ]]; then
  echo "fedora-system: battery detected, setting up TLP..."

  # TLP conflicts with tuned and power-profiles-daemon
  for svc in tuned power-profiles-daemon; do
    if systemctl is-active --quiet "$svc" 2>/dev/null || systemctl is-enabled --quiet "$svc" 2>/dev/null; then
      $SUDO systemctl disable --now "$svc" 2>/dev/null || true
      $SUDO systemctl mask "$svc" 2>/dev/null || true
    fi
  done

  $SUDO dnf install -y tlp tlp-rdw 2>/dev/null || true
  $SUDO systemctl enable --now tlp 2>/dev/null || true
  # Prevent systemd-rfkill from conflicting with TLP's radio management
  $SUDO systemctl mask systemd-rfkill.service systemd-rfkill.socket 2>/dev/null || true
else
  echo "fedora-system: no battery detected, skipping TLP"
fi

# Desktop auto-suspend (incl. the GDM greeter) is handled by run_no-suspend.sh.tmpl

# ---- Boot optimization ----
if systemctl is-enabled --quiet NetworkManager-wait-online.service 2>/dev/null; then
  echo "fedora-system: disabling NetworkManager-wait-online.service..."
  $SUDO systemctl disable NetworkManager-wait-online.service 2>/dev/null || true
fi

# ---- Flatpak auto-updates (systemd user timer) ----
if command -v flatpak >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1; then
  TIMER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  mkdir -p "$TIMER_DIR"

  if [[ ! -f "$TIMER_DIR/flatpak-update.service" ]]; then
    cat > "$TIMER_DIR/flatpak-update.service" << 'EOF'
[Unit]
Description=Update Flatpak apps
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak update -y --noninteractive
EOF
  fi

  if [[ ! -f "$TIMER_DIR/flatpak-update.timer" ]]; then
    cat > "$TIMER_DIR/flatpak-update.timer" << 'EOF'
[Unit]
Description=Daily Flatpak update

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
EOF
  fi

  systemctl --user daemon-reload 2>/dev/null || true
  systemctl --user enable --now flatpak-update.timer 2>/dev/null || true
  echo "fedora-system: flatpak auto-update timer enabled"
fi

# ---- Btrfs snapshots (only if root is btrfs) ----
root_fstype="$(findmnt -n -o FSTYPE / 2>/dev/null || true)"
if [[ "$root_fstype" == "btrfs" ]]; then
  echo "fedora-system: btrfs root detected, installing snapshot tools..."

  $SUDO dnf install -y btrfs-assistant snapper 2>/dev/null || true

  # Create default snapper config for root if not present
  if command -v snapper >/dev/null 2>&1; then
    if ! $SUDO snapper -c root list >/dev/null 2>&1; then
      $SUDO snapper -c root create-config / 2>/dev/null || true
    fi
    $SUDO systemctl enable --now snapper-timeline.timer 2>/dev/null || true
    $SUDO systemctl enable --now snapper-cleanup.timer 2>/dev/null || true
  fi
else
  echo "fedora-system: root is ${root_fstype:-unknown} (not btrfs), skipping snapshot tools"
fi

# ---- Dual-boot time fix ----
# Linux wants the hardware clock in UTC; Windows defaults to local time.
# Switching Linux alone makes Windows show the wrong time, so when a Windows
# install is present only print the two-sided fix.
if command -v timedatectl >/dev/null 2>&1; then
  if timedatectl show --property=LocalRTC --value 2>/dev/null | grep -q 'yes'; then
    has_windows=false
    if $SUDO test -d /boot/efi/EFI/Microsoft 2>/dev/null ||
      { command -v efibootmgr >/dev/null 2>&1 && efibootmgr 2>/dev/null | grep -qi 'windows boot manager'; }; then
      has_windows=true
    fi
    if [[ "$has_windows" == "true" ]]; then
      echo "fedora-system: RTC is in local time and Windows is installed; leaving it."
      echo "  To fix both sides: in an admin PowerShell on Windows run"
      echo "    reg add HKLM\\SYSTEM\\CurrentControlSet\\Control\\TimeZoneInformation /v RealTimeIsUniversal /t REG_DWORD /d 1 /f"
      echo "  then here: sudo timedatectl set-local-rtc 0 --adjust-system-clock"
    else
      echo "fedora-system: fixing RTC to UTC..."
      $SUDO timedatectl set-local-rtc 0 --adjust-system-clock || true
    fi
  fi
fi

# ---- Firmware updates ----
if command -v fwupdmgr >/dev/null 2>&1; then
  echo "fedora-system: checking for firmware updates..."
  fwupdmgr refresh --force 2>/dev/null || true
  fwupdmgr update -y --no-reboot 2>/dev/null || true
fi

{{ end -}}
