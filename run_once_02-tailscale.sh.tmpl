#!/usr/bin/env bash
set -euo pipefail

{{ if dig "is_server" false . -}}

{{ template "todo.sh" }}

# Only bring Tailscale up on a box that has never been logged in. Any other
# state (Running, Stopped after `tailscale down`, ...) means it's already set
# up; re-running `tailscale up` there conflicts with existing non-default
# flags (e.g. --operator) and would abort the whole apply.
if command -v tailscale >/dev/null 2>&1; then
  # `status --json` is pretty-printed ("BackendState": "Running"), so allow spaces.
  state="$(tailscale status --json 2>/dev/null | grep -Eo '"BackendState": *"[^"]*"' | head -1 | sed -E 's/.*"([^"]*)"$/\1/' || true)"
  case "$state" in
    ""|NoState|NeedsLogin) ;;
    *)
      echo "tailscale: already set up (state: $state)"
      exit 0
      ;;
  esac
fi

{{ if eq .chezmoi.os "linux" -}}
SUDO=""
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  SUDO="sudo"
fi

# Install if missing
if ! command -v tailscale >/dev/null 2>&1; then
  echo "tailscale: installing..."
  curl -fsSL https://tailscale.com/install.sh | sh
  $SUDO systemctl enable --now tailscaled
fi

# Connect with SSH enabled (Linux only)
echo "tailscale: connecting with SSH enabled..."
echo "tailscale: you'll need to authenticate in your browser."
if ! $SUDO tailscale up --ssh; then
  echo "tailscale: 'tailscale up' failed (see above)"
  todo "Tailscale: 'tailscale up --ssh' failed; run it by hand (add any flags it asks for)"
  exit 0
fi

{{ else -}}
# macOS: Tailscale is a GUI app; just connect if the CLI is available
if ! command -v tailscale >/dev/null 2>&1; then
  echo "tailscale: not installed. Install from App Store or: brew install --cask tailscale"
  exit 0
fi

echo "tailscale: connecting..."
echo "tailscale: you'll need to authenticate in your browser."
if ! tailscale up; then
  todo "Tailscale: 'tailscale up' failed; connect from the Tailscale app"
  exit 0
fi

{{ end -}}

echo "tailscale: connected"
echo ""
echo "REMINDER: Disable key expiry for this machine in the Tailscale admin console:"
echo "  https://login.tailscale.com/admin/machines"

{{ end -}}
