#!/usr/bin/env bash
set -euo pipefail

PNPM_DIR="$HOME/.config/zsh/plugins/pnpm-shell-completion"
PNPM_BIN="$PNPM_DIR/pnpm-shell-completion"
BUILD_SCRIPT="$PNPM_DIR/zplug.zsh"

# Only build if repo exists, helper missing, and we can actually build
if [[ -d "$PNPM_DIR" ]] && [[ ! -x "$PNPM_BIN" ]] && [[ -r "$BUILD_SCRIPT" ]]; then
  if command -v cargo >/dev/null 2>&1; then
    # Avoid noisy output / failures breaking apply
    (cd "$PNPM_DIR" && "$BUILD_SCRIPT") >/dev/null 2>&1 || true
  fi
fi