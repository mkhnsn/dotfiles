# GUI apps for workstation Macs (not servers: is_server = false).
# OpenSCAD is a vendor download in mac-setup: its cask was disabled (fails Gatekeeper).
# Installed by run_install-packages after the base Brewfile, with --adopt so apps
# already in /Applications are taken over instead of failing. App Store apps need
# you signed in to the App Store. Apps without a cask (vendor downloads, licenses)
# are mac-setup steps.

tap "steipete/tap"

brew "mas"
brew "dockutil"
brew "defaultbrowser"

# Everyday
cask "1password-cli" # op needs the 1Password desktop app (account mode)
cask "google-chrome"
cask "raycast"
cask "ghostty"
cask "claude"
cask "slack"
cask "fantastical"
cask "signal"
cask "whatsapp"
cask "discord"
cask "spotify"
cask "zoom"
cask "microsoft-outlook"
cask "microsoft-word"
cask "microsoft-excel"
cask "microsoft-powerpoint"
cask "microsoft-onenote"
cask "onedrive"
cask "microsoft-teams"
cask "pdf-expert"
cask "anylist"
cask "tailscale-app"

# Menu bar and window management
cask "bartender"
cask "betterdisplay"
cask "bettermouse"
cask "stats"
cask "alt-tab"
cask "steipete/tap/codexbar"
cask "daisydisk"
cask "keyboardcleantool"

# Dev
# Containers: Colima runs the Docker engine in a small VM; the docker CLI, compose and buildx
# use it (replaces Docker Desktop). mac-setup starts it at login.
brew "colima"
brew "docker"
brew "docker-compose"
brew "docker-buildx"
brew "docker-credential-helper"
# Local models; mac-setup runs its server at login.
brew "ollama"
cask "utm"
cask "parallels"
cask "realvnc-connect-viewer"
cask "netspot"
cask "figma"
cask "handbrake-app"

# Creative
cask "adobe-creative-cloud"

# CAD and making
cask "autodesk-fusion"
cask "prusaslicer"
cask "bambu-studio"
cask "blender"
cask "lightburn"
cask "xtool-studio"
cask "openrocket"

# Hardware and devices
cask "elgato-stream-deck" # 7.x; its MCP server needs Stream Deck 8 (beta from elgato.com) on top
cask "insta360-link-controller"
cask "raspberry-pi-imager"
cask "balenaetcher"
brew "wimlib" # echo-provision splits Windows 11 install.wim for FAT32
brew "ykman"
brew "avrdude"
brew "minicom"
brew "lsusb"
cask "qflipper"
cask "ledger-wallet"
cask "geekbench"
# VIA: use the web app at https://usevia.app (its cask was disabled, fails Gatekeeper)

# Personal
cask "steam"

# App Store
mas "Bear", id: 1091189122
mas "Telegram", id: 747648890
mas "The Unarchiver", id: 425424353
mas "Goodnotes", id: 1444383602
mas "Xcode", id: 497799835
mas "Shapr3D", id: 1091675654
mas "Vivid", id: 6443470555
mas "Equinox", id: 1591510203
mas "Raycast Companion", id: 6738274497
mas "1Password for Safari", id: 1569813296
