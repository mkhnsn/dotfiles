#!/usr/bin/env bash
set -euo pipefail
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
# cargo-packages: markless
# uv-tools: specify-cli

os="{{ .chezmoi.os }}"

# ---- Cargo packages (cross-platform) ----
CARGO_PACKAGES=(markless)

install_cargo_packages() {
  command -v cargo >/dev/null 2>&1 || return 0
  for pkg in "${CARGO_PACKAGES[@]}"; do
    command -v "$pkg" >/dev/null 2>&1 || cargo install "$pkg" || true
  done
}

install_uv_tools() {
  command -v uv >/dev/null 2>&1 || return 0
  command -v specify >/dev/null 2>&1 || uv tool install specify-cli || true
}

want_cmds=(git fzf bat zoxide)
# nice-to-haves: rg, gh, starship, eza
want_cmds_optional=(rg gh starship eza specify)

missing=0
for c in "${want_cmds[@]}" "${want_cmds_optional[@]}"; do
  command -v "$c" >/dev/null 2>&1 || missing=1
done

# On macOS, Brewfile can include items that don't provide commands (e.g., zsh-completions),
# so don't short-circuit before we run `brew bundle check`.
if [[ "$os" != "darwin" && "$missing" -eq 0 ]]; then
  exit 0
fi

if [[ "$os" == "darwin" ]]; then
  if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew not found. Install it first: https://brew.sh/"
    exit 1
  fi

  BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"

  # Ensure Brewfile state is satisfied (covers formulae that don't add a command, like zsh-completions)
  brew bundle check --file "$BREWFILE" >/dev/null 2>&1 || brew bundle --file "$BREWFILE"

  # Only run fzf install if key-bindings aren't set up yet (it prompts interactively)
  [[ -r "$HOME/.fzf.zsh" ]] || "$(brew --prefix)/opt/fzf/install" --key-bindings --completion --no-update-rc || true
  install_cargo_packages
  install_uv_tools
  exit 0
fi

[[ "$os" != "linux" ]] && exit 0

# ---- Linux helpers ----
SUDO=""
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  if command -v sudo >/dev/null 2>&1; then
    SUDO="sudo"
    if ! sudo -n true 2>/dev/null; then
      echo "sudo requires a password (non-interactive). Skipping package install."
      exit 0
    fi
  else
    echo "Not root and sudo not available. Skipping package install."
    exit 0
  fi
fi

install_starship_user() {
  if ! command -v starship >/dev/null 2>&1; then
    mkdir -p "$HOME/.local/bin"
    curl -fsSL https://starship.rs/install.sh | sh -s -- -y --bin-dir "$HOME/.local/bin" || true
    # Ensure it's usable immediately even if PATH hasn't been reloaded yet
    export PATH="$HOME/.local/bin:$PATH"
  fi
}

ensure_fzf_zsh_integration() {
  # On many Linux distros (including some Codespaces images), the `fzf` package
  # may not ship the zsh key-bindings/completion files we expect.
  # We standardize on the upstream fzf install which generates ~/.fzf.zsh.
  command -v git >/dev/null 2>&1 || return 0
  command -v fzf >/dev/null 2>&1 || return 0

  if [[ ! -r "$HOME/.fzf.zsh" ]]; then
    if [[ ! -d "$HOME/.fzf" ]]; then
      git clone --depth 1 https://github.com/junegunn/fzf.git "$HOME/.fzf" || return 0
    fi

    # Generate ~/.fzf.zsh without modifying rc files (no binary install here)
    "$HOME/.fzf/install" --completion --key-bindings --no-update-rc --no-bash --no-fish >/dev/null 2>&1 || true
  fi
}

install_fzf_upstream_linux() {
  # Install a newer upstream fzf binary on Linux and prefer it via ~/.local/bin.
  [[ "$(uname -s)" == "Linux" ]] || return 0

  # Need curl + tar to download/extract
  command -v curl >/dev/null 2>&1 || return 0
  command -v tar  >/dev/null 2>&1 || return 0

  local arch fzf_arch tmpdir
  arch="$(uname -m)"
  case "$arch" in
    x86_64|amd64)  fzf_arch="linux_amd64" ;;
    aarch64|arm64) fzf_arch="linux_arm64" ;;
    *)             fzf_arch="" ;;
  esac

  [[ -n "$fzf_arch" ]] || return 0

  # Pinned for reproducibility
  local FZF_VERSION="0.67.0"

  tmpdir="$(mktemp -d)"
  curl -fsSL \
    "https://github.com/junegunn/fzf/releases/download/v${FZF_VERSION}/fzf-${FZF_VERSION}-${fzf_arch}.tar.gz" \
    -o "${tmpdir}/fzf.tgz" || { rm -rf "$tmpdir"; return 0; }

  mkdir -p "$HOME/.local/bin"
  tar -xzf "${tmpdir}/fzf.tgz" -C "$HOME/.local/bin" || true
  rm -rf "$tmpdir"

  # Make it effective for the remainder of this script
  export PATH="$HOME/.local/bin:$PATH"
}

install_fd_find() {
  # Optional but recommended: makes fzf much faster and respects ignores.
  # Package names differ across distros, so try common ones.
  if command -v apt-get >/dev/null 2>&1; then
    $SUDO apt-get install -y fd-find || true
  elif command -v dnf >/dev/null 2>&1; then
    $SUDO dnf install -y fd-find || $SUDO dnf install -y fd || true
  elif command -v yum >/dev/null 2>&1; then
    $SUDO yum install -y fd-find || $SUDO yum install -y fd || true
  elif command -v pacman >/dev/null 2>&1; then
    $SUDO pacman -Sy --noconfirm fd || true
  fi
}

if command -v apt-get >/dev/null 2>&1; then
  $SUDO apt-get update
  $SUDO apt-get install -y git curl ca-certificates fzf bat zoxide ripgrep

  # Optional packages (don't fail the whole script if missing)
  $SUDO apt-get install -y gh || true
  $SUDO apt-get install -y eza 2>/dev/null || true
  $SUDO apt-get install -y zsh-syntax-highlighting zsh-autosuggestions wl-clipboard || true

elif command -v dnf >/dev/null 2>&1; then
  $SUDO dnf makecache -y || true
  $SUDO dnf install -y git curl ca-certificates fzf bat zoxide ripgrep || true
  $SUDO dnf install -y gh || true
  # eza: not in all Fedora/RHEL repos; suppress "No match" noise
  $SUDO dnf install -y eza 2>/dev/null || true
  $SUDO dnf install -y zsh-syntax-highlighting zsh-autosuggestions wl-clipboard || true

elif command -v yum >/dev/null 2>&1; then
  $SUDO yum makecache -y || true
  $SUDO yum install -y git curl ca-certificates fzf bat zoxide ripgrep || true
  $SUDO yum install -y gh || true
  $SUDO yum install -y eza 2>/dev/null || true

elif command -v pacman >/dev/null 2>&1; then
  $SUDO pacman -Sy --noconfirm git curl ca-certificates fzf bat zoxide ripgrep
  $SUDO pacman -Sy --noconfirm github-cli eza || true
  $SUDO pacman -Sy --noconfirm zsh-syntax-highlighting zsh-autosuggestions wl-clipboard || true

else
  echo "No supported package manager found (apt/dnf/yum/pacman). Skipping."
  exit 0
fi

install_fzf_upstream_linux
install_fd_find
ensure_fzf_zsh_integration
install_starship_user
install_cargo_packages
install_uv_tools
