#!/usr/bin/env bash
set -euo pipefail
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
# cargo-packages: markless
# uv-tools: specify-cli
# linux-pkg-v5

os="{{ .chezmoi.os }}"

# ---- Cargo packages (cross-platform) ----
CARGO_PACKAGES=(markless)

install_cargo_packages() {
  command -v cargo >/dev/null 2>&1 || return 0
  for pkg in "${CARGO_PACKAGES[@]}"; do
    command -v "$pkg" >/dev/null 2>&1 || cargo install "$pkg" || true
  done
}

install_uv_tools() {
  command -v uv >/dev/null 2>&1 || return 0
  command -v specify >/dev/null 2>&1 || uv tool install specify-cli || true
}

want_cmds=(git fzf bat zoxide)
want_cmds_optional=(rg gh starship eza delta ghq glow navi tldr micro mosh specify)

missing=0
for c in "${want_cmds[@]}" "${want_cmds_optional[@]}"; do
  command -v "$c" >/dev/null 2>&1 || missing=1
done

# On macOS, Brewfile can include items that don't provide commands (e.g., zsh-completions),
# so don't short-circuit before we run `brew bundle check`.
if [[ "$os" != "darwin" && "$missing" -eq 0 ]]; then
  exit 0
fi

if [[ "$os" == "darwin" ]]; then
  if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew not found. Install it first: https://brew.sh/"
    exit 1
  fi

  BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"

  # Ensure Brewfile state is satisfied (covers formulae that don't add a command, like zsh-completions)
  brew bundle check --file "$BREWFILE" >/dev/null 2>&1 || brew bundle --file "$BREWFILE"

  # Only run fzf install if key-bindings aren't set up yet (it prompts interactively)
  [[ -r "$HOME/.fzf.zsh" ]] || "$(brew --prefix)/opt/fzf/install" --key-bindings --completion --no-update-rc || true
  install_cargo_packages
  install_uv_tools
{{ if .full_setup }}
  brew install code-server 2>/dev/null || true
{{ end }}
  exit 0
fi

[[ "$os" != "linux" ]] && exit 0

# ---- Linux helpers ----
SUDO=""
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  if command -v sudo >/dev/null 2>&1; then
    SUDO="sudo"
    if ! sudo -n true 2>/dev/null; then
      echo "sudo requires a password (non-interactive). Skipping package install."
      exit 0
    fi
  else
    echo "Not root and sudo not available. Skipping package install."
    exit 0
  fi
fi

get_arch() {
  case "$(uname -m)" in
    x86_64|amd64)  echo "amd64" ;;
    aarch64|arm64) echo "arm64" ;;
    *)             echo "" ;;
  esac
}

install_starship_user() {
  command -v starship >/dev/null 2>&1 && return 0
  command -v curl >/dev/null 2>&1 || return 0
  mkdir -p "$HOME/.local/bin"
  curl -fsSL https://starship.rs/install.sh | sh -s -- -y --bin-dir "$HOME/.local/bin" || true
  export PATH="$HOME/.local/bin:$PATH"
}

install_uv_user() {
  command -v uv >/dev/null 2>&1 && return 0
  command -v curl >/dev/null 2>&1 || return 0
  curl -fsSL https://astral.sh/uv/install.sh | sh || true
  export PATH="$HOME/.local/bin:$PATH"
}

install_ghq_user() {
  command -v ghq >/dev/null 2>&1 && return 0
  command -v curl >/dev/null 2>&1 || return 0
  local arch
  arch="$(get_arch)"
  [[ -n "$arch" ]] || return 0

  local GHQ_VERSION="1.7.1"
  local tmpdir
  tmpdir="$(mktemp -d)"
  local url="https://github.com/x-motemen/ghq/releases/download/v${GHQ_VERSION}/ghq_linux_${arch}.zip"

  curl -fsSL "$url" -o "${tmpdir}/ghq.zip" || { rm -rf "$tmpdir"; return 0; }
  mkdir -p "$HOME/.local/bin"
  unzip -o -j "${tmpdir}/ghq.zip" "ghq_linux_${arch}/ghq" -d "$HOME/.local/bin" 2>/dev/null || true
  chmod +x "$HOME/.local/bin/ghq" 2>/dev/null || true
  rm -rf "$tmpdir"
  export PATH="$HOME/.local/bin:$PATH"
}

install_navi_user() {
  command -v navi >/dev/null 2>&1 && return 0
  command -v curl >/dev/null 2>&1 || return 0
  local arch
  arch="$(get_arch)"
  [[ -n "$arch" ]] || return 0

  # navi uses x86_64/aarch64 in its release names
  local navi_arch
  case "$arch" in
    amd64) navi_arch="x86_64" ;;
    arm64) navi_arch="aarch64" ;;
    *)     return 0 ;;
  esac

  local NAVI_VERSION="2.24.0"
  local tmpdir
  tmpdir="$(mktemp -d)"
  local url="https://github.com/denisidoro/navi/releases/download/v${NAVI_VERSION}/navi-v${NAVI_VERSION}-${navi_arch}-unknown-linux-musl.tar.gz"

  curl -fsSL "$url" -o "${tmpdir}/navi.tgz" || { rm -rf "$tmpdir"; return 0; }
  mkdir -p "$HOME/.local/bin"
  tar -xzf "${tmpdir}/navi.tgz" -C "$HOME/.local/bin" || true
  rm -rf "$tmpdir"
  export PATH="$HOME/.local/bin:$PATH"
}

install_delta_user() {
  # Install delta from GitHub releases (for distros where it's not in repos)
  command -v delta >/dev/null 2>&1 && return 0
  command -v curl >/dev/null 2>&1 || return 0
  local arch
  arch="$(get_arch)"
  [[ -n "$arch" ]] || return 0

  local DELTA_VERSION="0.18.2"
  local delta_arch
  case "$arch" in
    amd64) delta_arch="x86_64" ;;
    arm64) delta_arch="aarch64" ;;
    *)     return 0 ;;
  esac

  local tmpdir
  tmpdir="$(mktemp -d)"
  local url="https://github.com/dandavison/delta/releases/download/${DELTA_VERSION}/delta-${DELTA_VERSION}-${delta_arch}-unknown-linux-musl.tar.gz"

  curl -fsSL "$url" -o "${tmpdir}/delta.tgz" || { rm -rf "$tmpdir"; return 0; }
  tar -xzf "${tmpdir}/delta.tgz" -C "$tmpdir" || { rm -rf "$tmpdir"; return 0; }
  mkdir -p "$HOME/.local/bin"
  cp "${tmpdir}/delta-${DELTA_VERSION}-${delta_arch}-unknown-linux-musl/delta" "$HOME/.local/bin/delta" || true
  chmod +x "$HOME/.local/bin/delta" 2>/dev/null || true
  rm -rf "$tmpdir"
  export PATH="$HOME/.local/bin:$PATH"
}

install_tealdeer_user() {
  # Distro-packaged tealdeer < 1.8.0 is broken (upstream archive URL removed).
  # Override with upstream binary in ~/.local/bin if the installed version is < 1.8.
  command -v curl >/dev/null 2>&1 || return 0

  if command -v tldr >/dev/null 2>&1; then
    local ver
    ver="$(tldr --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)" || return 0
    local major minor
    major="${ver%%.*}"
    minor="${ver#*.}"
    # Only override if version < 1.8
    [[ "$major" -lt 1 || ( "$major" -eq 1 && "$minor" -lt 8 ) ]] || return 0
  fi

  local arch
  arch="$(get_arch)"
  [[ -n "$arch" ]] || return 0

  local tldr_arch
  case "$arch" in
    amd64) tldr_arch="x86_64" ;;
    arm64) tldr_arch="aarch64" ;;
    *)     return 0 ;;
  esac

  local TEALDEER_VERSION="1.8.1"
  mkdir -p "$HOME/.local/bin"
  curl -fsSL \
    "https://github.com/tealdeer-rs/tealdeer/releases/download/v${TEALDEER_VERSION}/tealdeer-linux-${tldr_arch}-musl" \
    -o "$HOME/.local/bin/tldr" || return 0
  chmod +x "$HOME/.local/bin/tldr"
  export PATH="$HOME/.local/bin:$PATH"
}

ensure_fzf_zsh_integration() {
  command -v git >/dev/null 2>&1 || return 0
  command -v fzf >/dev/null 2>&1 || return 0

  if [[ ! -r "$HOME/.fzf.zsh" ]]; then
    if [[ ! -d "$HOME/.fzf" ]]; then
      git clone --depth 1 https://github.com/junegunn/fzf.git "$HOME/.fzf" || return 0
    fi
    "$HOME/.fzf/install" --completion --key-bindings --no-update-rc --no-bash --no-fish >/dev/null 2>&1 || true
  fi
}

install_fzf_upstream_linux() {
  [[ "$(uname -s)" == "Linux" ]] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  command -v tar  >/dev/null 2>&1 || return 0

  local arch
  arch="$(get_arch)"
  [[ -n "$arch" ]] || return 0

  # fzf uses linux_amd64/linux_arm64
  local fzf_arch="linux_${arch}"
  local FZF_VERSION="0.67.0"

  local tmpdir
  tmpdir="$(mktemp -d)"
  curl -fsSL \
    "https://github.com/junegunn/fzf/releases/download/v${FZF_VERSION}/fzf-${FZF_VERSION}-${fzf_arch}.tar.gz" \
    -o "${tmpdir}/fzf.tgz" || { rm -rf "$tmpdir"; return 0; }

  mkdir -p "$HOME/.local/bin"
  tar -xzf "${tmpdir}/fzf.tgz" -C "$HOME/.local/bin" || true
  rm -rf "$tmpdir"
  export PATH="$HOME/.local/bin:$PATH"
}

install_fd_find() {
  command -v fd >/dev/null 2>&1 && return 0
  command -v fdfind >/dev/null 2>&1 && return 0
  if command -v apt-get >/dev/null 2>&1; then
    $SUDO apt-get install -y fd-find || true
  elif command -v dnf >/dev/null 2>&1; then
    $SUDO dnf install -y fd-find 2>/dev/null || $SUDO dnf install -y fd 2>/dev/null || true
  elif command -v yum >/dev/null 2>&1; then
    $SUDO yum install -y fd-find 2>/dev/null || $SUDO yum install -y fd 2>/dev/null || true
  elif command -v pacman >/dev/null 2>&1; then
    $SUDO pacman -Sy --noconfirm fd || true
  fi
}

install_bandwhich_user() {
  command -v bandwhich >/dev/null 2>&1 && return 0
  command -v curl >/dev/null 2>&1 || return 0
  # Available in pacman; skip GitHub install on Arch
  command -v pacman >/dev/null 2>&1 && return 0
  local arch
  arch="$(get_arch)"
  [[ -n "$arch" ]] || return 0

  local bw_arch
  case "$arch" in
    amd64) bw_arch="x86_64" ;;
    arm64) bw_arch="aarch64" ;;
    *)     return 0 ;;
  esac

  local BANDWHICH_VERSION="0.23.1"
  local tmpdir
  tmpdir="$(mktemp -d)"
  local url="https://github.com/imsnif/bandwhich/releases/download/v${BANDWHICH_VERSION}/bandwhich-v${BANDWHICH_VERSION}-${bw_arch}-unknown-linux-musl.tar.gz"

  curl -fsSL "$url" -o "${tmpdir}/bandwhich.tgz" || { rm -rf "$tmpdir"; return 0; }
  mkdir -p "$HOME/.local/bin"
  tar -xzf "${tmpdir}/bandwhich.tgz" -C "$HOME/.local/bin" bandwhich || true
  chmod +x "$HOME/.local/bin/bandwhich" 2>/dev/null || true
  rm -rf "$tmpdir"
  export PATH="$HOME/.local/bin:$PATH"
}

install_code_server_user() {
  command -v code-server >/dev/null 2>&1 && return 0
  command -v curl >/dev/null 2>&1 || return 0
  curl -fsSL https://code-server.dev/install.sh | sh -s -- --method=standalone || true
  export PATH="$HOME/.local/lib/code-server-*/bin:$PATH"
}

install_procs_user() {
  command -v procs >/dev/null 2>&1 && return 0
  command -v curl >/dev/null 2>&1 || return 0
  # Available in pacman; skip GitHub install on Arch
  command -v pacman >/dev/null 2>&1 && return 0
  local arch
  arch="$(get_arch)"
  [[ -n "$arch" ]] || return 0

  local procs_arch
  case "$arch" in
    amd64) procs_arch="x86_64" ;;
    arm64) procs_arch="aarch64" ;;
    *)     return 0 ;;
  esac

  local PROCS_VERSION="0.14.10"
  local tmpdir
  tmpdir="$(mktemp -d)"
  local url="https://github.com/dalance/procs/releases/download/v${PROCS_VERSION}/procs-v${PROCS_VERSION}-${procs_arch}-linux.zip"

  curl -fsSL "$url" -o "${tmpdir}/procs.zip" || { rm -rf "$tmpdir"; return 0; }
  mkdir -p "$HOME/.local/bin"
  unzip -o -j "${tmpdir}/procs.zip" -d "$HOME/.local/bin" 2>/dev/null || true
  chmod +x "$HOME/.local/bin/procs" 2>/dev/null || true
  rm -rf "$tmpdir"
  export PATH="$HOME/.local/bin:$PATH"
}

install_duf_user() {
  command -v duf >/dev/null 2>&1 && return 0
  command -v curl >/dev/null 2>&1 || return 0
  local arch
  arch="$(get_arch)"
  [[ -n "$arch" ]] || return 0

  local duf_arch
  case "$arch" in
    amd64) duf_arch="amd64" ;;
    arm64) duf_arch="arm64" ;;
    *)     return 0 ;;
  esac

  local DUF_VERSION="0.8.1"
  local tmpdir
  tmpdir="$(mktemp -d)"
  local url="https://github.com/muesli/duf/releases/download/v${DUF_VERSION}/duf_${DUF_VERSION}_linux_${duf_arch}.tar.gz"

  curl -fsSL "$url" -o "${tmpdir}/duf.tgz" || { rm -rf "$tmpdir"; return 0; }
  mkdir -p "$HOME/.local/bin"
  tar -xzf "${tmpdir}/duf.tgz" -C "$HOME/.local/bin" duf || true
  chmod +x "$HOME/.local/bin/duf" 2>/dev/null || true
  rm -rf "$tmpdir"
  export PATH="$HOME/.local/bin:$PATH"
}

# ---- Distro package installs ----
if command -v apt-get >/dev/null 2>&1; then
  $SUDO apt-get update
  $SUDO apt-get install -y git curl ca-certificates fzf bat zoxide ripgrep

  # Optional packages (don't fail the whole script if missing)
  $SUDO apt-get install -y gh || true
  $SUDO apt-get install -y eza 2>/dev/null || true
  $SUDO apt-get install -y chafa mosh micro tealdeer 2>/dev/null || true
  # git-delta and glow not in Ubuntu stable repos — installed via helpers below
  $SUDO apt-get install -y git-delta 2>/dev/null || true
  $SUDO apt-get install -y glow 2>/dev/null || true
  $SUDO apt-get install -y zsh-syntax-highlighting zsh-autosuggestions wl-clipboard || true

elif command -v dnf >/dev/null 2>&1; then
  $SUDO dnf makecache -y || true
  $SUDO dnf install -y git curl ca-certificates fzf bat zoxide ripgrep || true
  $SUDO dnf install -y gh git-delta glow chafa mosh micro tealdeer 2>/dev/null || true
  $SUDO dnf install -y eza 2>/dev/null || true
  $SUDO dnf install -y zsh-syntax-highlighting zsh-autosuggestions wl-clipboard 2>/dev/null || true

  # ---- Archive tools & FUSE/AppImage support ----
  $SUDO dnf install -y p7zip p7zip-plugins unrar 2>/dev/null || true
  $SUDO dnf install -y fuse fuse-libs 2>/dev/null || true

{{ if .full_setup -}}
  # ---- Multimedia codecs (requires RPM Fusion from 03-fedora-repos) ----
  if dnf repolist --enabled 2>/dev/null | grep -q 'rpmfusion'; then
    $SUDO dnf swap -y ffmpeg-free ffmpeg --allowerasing 2>/dev/null || true
    $SUDO dnf install -y \
      gstreamer1-plugins-good gstreamer1-plugins-bad-free \
      gstreamer1-plugins-ugly gstreamer1-plugin-openh264 \
      gstreamer1-plugin-libav 2>/dev/null || true
    $SUDO dnf install -y gstreamer1-plugins-bad-freeworld 2>/dev/null || true
  fi
  # OpenH264 from Cisco (Fedora ships it disabled by default)
  $SUDO dnf config-manager setopt fedora-cisco-openh264.enabled=1 2>/dev/null || true
  $SUDO dnf install -y openh264 mozilla-openh264 2>/dev/null || true

  # ---- Microsoft core fonts ----
  if ! rpm -q msttcore-fonts-installer >/dev/null 2>&1; then
    $SUDO dnf install -y curl cabextract xorg-x11-font-utils fontconfig 2>/dev/null || true
    $SUDO rpm -i https://downloads.sourceforge.net/project/mscorefonts2/rpms/msttcore-fonts-installer-2.6-1.noarch.rpm 2>/dev/null || true
  fi
{{ end -}}

elif command -v yum >/dev/null 2>&1; then
  $SUDO yum makecache -y || true
  $SUDO yum install -y git curl ca-certificates fzf bat zoxide ripgrep || true
  $SUDO yum install -y gh chafa mosh micro 2>/dev/null || true
  $SUDO yum install -y eza 2>/dev/null || true

elif command -v pacman >/dev/null 2>&1; then
  $SUDO pacman -Sy --noconfirm git curl ca-certificates fzf bat zoxide ripgrep
  $SUDO pacman -Sy --noconfirm github-cli eza git-delta glow chafa mosh micro tealdeer || true
  $SUDO pacman -Sy --noconfirm zsh-syntax-highlighting zsh-autosuggestions wl-clipboard || true

else
  echo "No supported package manager found (apt/dnf/yum/pacman). Skipping."
  exit 0
fi

# ---- System monitoring tools (full_setup only) ----
{{ if .full_setup -}}
if command -v apt-get >/dev/null 2>&1; then
  $SUDO apt-get install -y htop btop ncdu iftop iotop sysstat duf 2>/dev/null || true
elif command -v dnf >/dev/null 2>&1; then
  $SUDO dnf install -y htop btop ncdu iftop iotop sysstat duf 2>/dev/null || true
elif command -v yum >/dev/null 2>&1; then
  $SUDO yum install -y htop btop ncdu iftop iotop sysstat 2>/dev/null || true
elif command -v pacman >/dev/null 2>&1; then
  $SUDO pacman -Sy --noconfirm htop btop ncdu iftop iotop sysstat duf bandwhich procs || true
fi

install_duf_user
install_bandwhich_user
install_procs_user
install_code_server_user
systemctl --user enable --now code-server 2>/dev/null || true
{{ end -}}

# ---- Post-package-manager installs (GitHub releases / official installers) ----
install_fzf_upstream_linux
install_fd_find
ensure_fzf_zsh_integration
install_starship_user
install_delta_user
install_ghq_user
install_navi_user
install_tealdeer_user
install_uv_user
install_cargo_packages
install_uv_tools
