# .editorconfig - Editor configuration for consistent coding styles

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# JavaScript/TypeScript
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# HTML/CSS/SCSS
[*.{html,css,scss,sass,less}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Ruby
[*.rb]
indent_size = 2

# Python
[*.py]
indent_size = 4

# Go
[*.go]
indent_style = tab

# Shell scripts
[*.sh]
indent_size = 2

# XML
[*.xml]
indent_size = 2

# Package files
[{package.json,package-lock.json,composer.json}]
indent_size = 2

# Makefile
[Makefile]
indent_style = tab
