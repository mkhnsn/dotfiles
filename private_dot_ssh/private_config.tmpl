{{- /*
~/.ssh/config. The tailnet's MagicDNS suffix is read from Tailscale at apply time so it
isn't in this public repo; until Tailscale is connected the tailnet block is left out
(re-run chezmoi apply after the mac-setup Tailscale steps).
*/ -}}
{{- $suffix := output "sh" "-c" "for t in tailscale /usr/local/libexec/tailscale/tailscale /Applications/Tailscale.app/Contents/MacOS/Tailscale; do command -v \"$t\" >/dev/null 2>&1 || [ -x \"$t\" ] || continue; \"$t\" status --json --peers=false 2>/dev/null | sed -n 's/.*\"MagicDNSSuffix\": *\"\\([^\"]*\\)\".*/\\1/p' | head -1; break; done; true" | trim -}}
{{- /* Colima (workstations) adds this exact line, first in the file, on each start unless it's
       there; keeping it here stops chezmoi apply and Colima undoing each other. */ -}}
{{- if not (dig "is_server" false .) -}}
Include {{ .chezmoi.homeDir }}/.colima/ssh_config

{{ end -}}
# Managed by chezmoi (mkhnsn/dotfiles): edit the source, then chezmoi apply.

# Per-host keys that 1Password manages itself.
Include ~/.ssh/1Password/config

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- if $suffix }}

# Short tailnet names (ssh mikebook-pro) become their MagicDNS name, so the block below
# applies to them too.
Host *
  CanonicalizeHostname yes
  CanonicalDomains {{ $suffix }}
  CanonicalizeMaxDots 0

Host *.{{ $suffix }}
  # Tailnet Macs get rebuilt; trust a new machine's host key on first use.
  StrictHostKeyChecking accept-new
  ForwardAgent yes
{{- end }}
