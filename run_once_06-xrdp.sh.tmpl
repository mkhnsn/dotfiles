#!/usr/bin/env bash
set -euo pipefail

{{ if and (eq .chezmoi.os "linux") .full_setup -}}

# Skip if no display manager is enabled (no GUI login configured)
has_dm=false
for dm in gdm gdm3 sddm lightdm; do
  if systemctl is-enabled "$dm" >/dev/null 2>&1; then
    has_dm=true
    break
  fi
done
if [[ "$has_dm" != "true" ]]; then
  echo "remote-desktop: no display manager detected, skipping"
  exit 0
fi

# GNOME Remote Desktop (built-in RDP, GNOME 42+)
if command -v grdctl >/dev/null 2>&1; then
  if grdctl status 2>/dev/null | grep -q "RDP.*enabled"; then
    echo "remote-desktop: GNOME RDP already enabled"
  else
    echo "remote-desktop: enabling GNOME Remote Desktop (RDP)..."
    grdctl rdp enable
    echo ""
    echo "GNOME Remote Desktop enabled on port 3389."
    echo "Set credentials with:  grdctl rdp set-credentials <user> <password>"
    echo "Or enable in:          Settings > Sharing > Remote Desktop"
  fi
  exit 0
fi

# Fallback: install xrdp for non-GNOME desktops
SUDO=""
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  SUDO="sudo"
fi

if command -v xrdp >/dev/null 2>&1; then
  echo "xrdp: already installed"
else
  echo "xrdp: installing (non-GNOME fallback)..."
  if command -v apt-get >/dev/null 2>&1; then
    $SUDO apt-get install -y xrdp
  elif command -v dnf >/dev/null 2>&1; then
    $SUDO dnf install -y xrdp
  elif command -v pacman >/dev/null 2>&1; then
    $SUDO pacman -S --noconfirm xrdp
  else
    echo "xrdp: unsupported package manager, skipping"
    exit 0
  fi
fi

$SUDO systemctl enable --now xrdp

if getent group ssl-cert >/dev/null 2>&1; then
  $SUDO usermod -aG ssl-cert xrdp 2>/dev/null || true
fi

echo ""
echo "xrdp: installed and running on port 3389"

{{ end -}}
