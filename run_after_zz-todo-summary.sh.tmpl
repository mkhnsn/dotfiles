#!/usr/bin/env bash
set -euo pipefail
# Print every manual follow-up recorded during this apply in one block at the
# bottom, so skipped steps don't scroll past unnoticed. Runs on every apply.

{{ template "todo.sh" }}

items=()
if [[ -s "$DOTFILES_TODO" ]]; then
  while IFS= read -r line; do
    items+=("$line")
  done < <(awk 'NF && !seen[$0]++' "$DOTFILES_TODO")
fi

# Persistent checks: re-evaluated every apply, so the reminder stays until done.
# Tailscale reports Self.KeyExpiry only while key expiry is enabled.
if command -v tailscale >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  if tailscale status --json 2>/dev/null | python3 -c 'import json,sys; s=json.load(sys.stdin); sys.exit(0 if s.get("BackendState")=="Running" and (s.get("Self") or {}).get("KeyExpiry") else 1)' 2>/dev/null; then
    items+=("Tailscale: key expiry is on for this machine; disable it at https://login.tailscale.com/admin/machines")
  fi
fi

{{ if not (env "CODESPACES") -}}
# This machine's fallback key (run_once_11) must be on GitHub twice. As a signing key, or
# the commits Claude Code and SSH sessions sign show as Unverified: allowed_signers was just
# rebuilt from GitHub's list, so check against it. As an authentication key, or git over SSH
# fails in those sessions (git-ssh uses this key there): checked against the public list at
# github.com/<user>.keys, and skipped when GitHub can't be reached.
fallback_pub="$HOME/.ssh/id_ed25519_remote.pub"
if [[ -f "$fallback_pub" ]]; then
  fallback_key="$(awk '{print $2}' "$fallback_pub")"
  if ! grep -qF "$fallback_key" "$HOME/.config/git/allowed_signers" 2>/dev/null; then
    items+=("Git signing: add this machine's fallback key to GitHub as a signing key: gh auth refresh -h github.com -s admin:ssh_signing_key && gh ssh-key add $fallback_pub --type signing --title \"${HOSTNAME%%.*} fallback\", then chezmoi apply")
  fi
  if auth_keys="$(curl -fsS --max-time 5 https://github.com/mkhnsn.keys 2>/dev/null)" &&
     ! grep -qF "$fallback_key" <<<"$auth_keys"; then
    items+=("Git over SSH: add this machine's fallback key to GitHub as an authentication key, or SSH remotes fail in Claude Code and SSH sessions: gh auth refresh -h github.com -s admin:public_key && gh ssh-key add $fallback_pub --type authentication --title \"${HOSTNAME%%.*} fallback\"")
  fi
fi
{{ end -}}

{{ if and (eq .chezmoi.os "darwin") (not (dig "is_server" false .)) -}}
# Claude Code MCP servers that wait on something done by hand. Raycast registers its
# own; run_onchange_after_claude-setup registers Stream Deck's once the helper exists.
if command -v jq >/dev/null 2>&1 && ! jq -e '.mcpServers.raycast' "$HOME/.claude.json" >/dev/null 2>&1; then
  items+=("Claude Code: connect Raycast's MCP server (Raycast Settings > MCP Server > Connect App > Claude Code)")
fi
if [[ ! -x "/Applications/Elgato Stream Deck.app/Contents/Helpers/streamdeck-mcp" ]]; then
  items+=("Claude Code: the Stream Deck MCP server needs Stream Deck 8 (beta, from elgato.com); install it, then chezmoi apply")
fi
{{ end -}}

# Repo-only files that older versions deployed to $HOME. chezmoi doesn't delete
# a target once it's ignored, so flag leftovers (keep in sync with the
# "Repo-only documentation" block in .chezmoiignore.tmpl).
for f in CLAUDE.md Brewfile; do
  if [[ -e "$HOME/$f" ]]; then
    items+=("Stale ~/$f from an older dotfiles version (now repo-only); remove it: rm ~/$f")
  fi
done

# Targets a newer dotfiles version renamed or stopped deploying; chezmoi leaves
# the old copy behind, so flag it.
for f in .claude/skills/doctor .local/bin/__pycache__; do
  if [[ -e "$HOME/$f" ]]; then
    items+=("Stale ~/$f from an older dotfiles version (renamed or no longer deployed); remove it: rm -r ~/$f")
  fi
done

{{- /* Mirrors .chezmoiignore.tmpl: account-mode secrets are skipped over SSH. */}}
{{ if and .full_setup (ne (dig "op_mode" "account" .) "service") (env "SSH_CONNECTION") -}}
items+=("1Password-backed files (.ntfy.yml, jfrog-env, .ssh/authorized_keys) were skipped over SSH; run 'chezmoi apply' at the desktop to refresh them")
{{ end -}}

[[ ${#items[@]} -gt 0 ]] || exit 0

if [[ -t 1 ]]; then
  bold=$'\e[1m' yellow=$'\e[33m' reset=$'\e[0m'
else
  bold="" yellow="" reset=""
fi

rule="────────────────────────────────────────────────────────────────────"
echo ""
echo "${yellow}${rule}${reset}"
echo "${yellow}${bold} Needs your attention (${#items[@]}):${reset}"
echo "${yellow}${rule}${reset}"
for line in "${items[@]}"; do
  echo " ${yellow}•${reset} $line"
done
echo "${yellow}${rule}${reset}"
