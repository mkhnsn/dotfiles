#!/usr/bin/env python3
"""trigger-check: BTT named triggers from macos/btt/triggers.toml, checked and generated.

Each [[trigger]] becomes a BTT named trigger (type 643) running its command or BTT action, plus
one keyboard trigger per key: global, or in each of its `apps`' sections in BTT, so the key
only works there (and the same key can do something else in another app). A key trigger logs (`trigger --log-only <name> key`) and
then fires the named trigger (action 248), so every surface runs the same thing.

It also generates the hints' pieces (#144): the cheat sheet, a floating menu named "Hints" with
a row per trigger (Hyper+H, the cheat-sheet trigger, toggles it); the named trigger hints-close,
which closes BTT notifications titled "Hint…"; an Active App Did Change trigger running
`hints app`; and screen connect/disconnect and lid open/close triggers running `hints setup`,
which updates the cheat sheet's rows to the surfaces this setup has (#152).

The generator owns, in the preset's global triggers, every named trigger, every keyboard
trigger that fires a named trigger and the hints' pieces; anything else is left alone. It updates triggers in place by
UUID (derived from the trigger name), so what BTT adds on export survives a regenerate.

Fails when:
  invalid      a field is missing or wrong, a name or key is used twice, or `run` names a
               command that isn't in dot_local/bin
  unreachable  a setup (docked with the lid closed or open, laptop only) has no surface for it;
               every trigger needs a Hyper key (⌃⌥⇧⌘ + key), the keyboard being in every setup
  reserved     a Hyper key another tool owns
  stale        the preset doesn't match triggers.toml (run `trigger-check --write`)

Usage: trigger-check [--source DIR] [--write] [--list]
Python 3.11+ standard library only (tomllib).
"""
import argparse, html, json, os, re, shlex, subprocess, sys, tomllib, uuid

MODS = [(1 << 18, "⌃"), (1 << 19, "⌥"), (1 << 17, "⇧"), (1 << 20, "⌘")]
HYPER = sum(bit for bit, _ in MODS)
KEYS = {"A": 0, "S": 1, "D": 2, "F": 3, "H": 4, "G": 5, "Z": 6, "X": 7, "C": 8, "V": 9, "B": 11,
        "Q": 12, "W": 13, "E": 14, "R": 15, "Y": 16, "T": 17, "1": 18, "2": 19, "3": 20, "4": 21,
        "6": 22, "5": 23, "=": 24, "9": 25, "7": 26, "-": 27, "8": 28, "0": 29, "]": 30, "O": 31,
        "U": 32, "[": 33, "I": 34, "P": 35, "↩": 36, "L": 37, "J": 38, "'": 39, "K": 40, ";": 41,
        "\\": 42, ",": 43, "/": 44, "N": 45, "M": 46, ".": 47, "⇥": 48, "Space": 49, "`": 50,
        "F13": 105, "F14": 107, "F15": 113, "F16": 106, "F17": 64, "F18": 79, "F19": 80, "F20": 90}
# Hyper keys owned elsewhere (macos/shortcuts.toml): Bartender, the ops menu,
# macOS sysdiagnose.
RESERVED = {"B", "/", "Space", ".", ","}
SETUPS = ("docked-closed", "docked-open", "laptop")
SURFACES = {"key": SETUPS, "ipad": SETUPS,
            "streamdeck": ("docked-closed", "docked-open"), "knob": ("docked-closed", "docked-open"),
            "mouse": ("docked-closed", "docked-open"), "touch": ("docked-open", "laptop")}
NS = uuid.UUID("7d0b7c1e-3b0a-4b51-9a57-2f1d6c0f0143")  # fixed: trigger UUIDs stay stable


def uid(*parts):
    return str(uuid.uuid5(NS, ":".join(parts))).upper()


def parse_keys(keys):
    """'⌃⌥⇧⌘K' -> (key code, modifier flags), or None."""
    flags, rest = 0, keys
    for bit, glyph in MODS:
        if glyph in rest:
            flags |= bit
            rest = rest.replace(glyph, "", 1)
    code = KEYS.get(rest)
    return None if code is None or not flags else (code, flags)


def load(src):
    with open(os.path.join(src, "macos/btt/triggers.toml"), "rb") as f:
        return tomllib.load(f).get("trigger", [])


GLOBAL = "BT.G"


def scopes(t):
    """Where a trigger's keys work: its apps, or everywhere."""
    apps = t.get("apps")
    return list(apps) if isinstance(apps, list) and apps else [GLOBAL]


def overlap(a, b):
    return a == GLOBAL or b == GLOBAL or a == b


def registry_keys(src):
    """Keys in macos/shortcuts.toml, as [((code, flags), scope, what owns them)]."""
    path = os.path.join(src, "macos/shortcuts.toml")
    if not os.path.exists(path):
        return []
    with open(path, "rb") as f:
        reg = tomllib.load(f).get("shortcut", [])
    return [(parse_keys(e["keys"]), GLOBAL if e.get("scope", "global") == "global" else e["scope"],
             f"{e['owner']}'s {e.get('action', '')}".strip())
            for e in reg if parse_keys(e.get("keys", ""))]


def validate(src, triggers):
    problems, names, keys_seen = [], set(), []
    taken = registry_keys(src)
    for t in triggers:
        n = t.get("name", "?")
        where = f"trigger {n}"
        if not isinstance(n, str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]*", n):
            problems.append(f"invalid: {where}: name must be lowercase letters, digits and dashes")
        if n in names:
            problems.append(f"invalid: {where}: name used twice")
        if n in HINTS_NAMES:
            problems.append(f"invalid: {where}: {n} is one of the hints' own pieces")
        names.add(n)
        for field in ("action", "hint"):
            if not isinstance(t.get(field), str) or not t[field].strip():
                problems.append(f"invalid: {where}: needs {field}")
        if ("run" in t) == ("btt" in t):
            problems.append(f"invalid: {where}: needs exactly one of run or btt")
        if "run" in t:
            try:
                cmd = shlex.split(t["run"])[0]
            except (AttributeError, ValueError, IndexError):
                problems.append(f"invalid: {where}: run must be a command line, like \"keep-awake toggle\"")
            else:
                bin_dir = os.path.join(src, "dot_local/bin")
                if not any(os.path.exists(os.path.join(bin_dir, f"executable_{cmd}{ext}")) for ext in ("", ".tmpl")):
                    problems.append(f"invalid: {where}: run: {cmd!r} isn't in dot_local/bin")
        if "btt" in t and not (isinstance(t["btt"], dict) and isinstance(t["btt"].get("action"), int)
                               and isinstance(t["btt"].get("data", {}), dict)
                               and isinstance(t["btt"].get("fields", {}), dict)
                               and all(k in ACTION_FIELDS for k in t["btt"].get("fields", {}))):
            problems.append(f"invalid: {where}: btt must be {{ action = <BTTPredefinedActionType>, data = {{ ... }}, "
                            f"fields = {{ ... }} }}; fields are the action's own keys: {', '.join(sorted(ACTION_FIELDS))}")
        keys, fires = t.get("keys", []), t.get("fires", [])
        if not isinstance(keys, list) or not all(isinstance(k, str) for k in keys):
            problems.append(f"invalid: {where}: keys must be a list, like [\"⌃⌥⇧⌘K\"]")
            keys = []
        if not isinstance(fires, list):
            problems.append(f"invalid: {where}: fires must be a list, like [\"streamdeck\"]")
            fires = []
        hyper = False
        for k in keys:
            parsed = parse_keys(k)
            if parsed is None:
                problems.append(f"invalid: {where}: can't read keys {k!r}")
                continue
            mine = scopes(t) if isinstance(t.get("apps", []), list) else [GLOBAL]
            others = sorted({other for keys, scope, other in keys_seen
                             if keys == parsed and any(overlap(scope, m) for m in mine)})
            if others:
                problems.append(f"invalid: {where}: {k} is also {', '.join(others)}'s")
            keys_seen += [(parsed, m, n) for m in mine]
            for owner in sorted({what for keys, scope, what in taken
                                 if keys == parsed and any(overlap(scope, m) for m in mine)}):
                problems.append(f"conflict: {where}: {k} is {owner} in macos/shortcuts.toml")
            if parsed[1] == HYPER:
                hyper = True
                key = k.replace("⌃", "").replace("⌥", "").replace("⇧", "").replace("⌘", "")
                if key in RESERVED:
                    problems.append(f"reserved: {where}: Hyper+{key} belongs elsewhere (see macos/shortcuts.toml)")
        apps = t.get("apps", [])
        if not isinstance(apps, list) or not all(isinstance(x, str) and x for x in apps):
            problems.append(f"invalid: {where}: apps must be a list of bundle IDs, like [\"us.zoom.xos\"]")
        for s in fires:
            if s not in SURFACES or s == "key":
                problems.append(f"invalid: {where}: unknown surface {s!r} (one of {', '.join(sorted(set(SURFACES) - {'key'}))})")
        # The keyboard is the floor: it's the one surface in every setup, so every trigger has a
        # Hyper key whatever else fires it.
        if not hyper:
            problems.append(f"unreachable: {where}: no Hyper key (⌃⌥⇧⌘ + key); the keyboard is the one surface in every setup")
        surfaces = (["key"] if hyper else []) + [s for s in fires if s in SURFACES]
        for setup in SETUPS:
            if not any(setup in SURFACES[s] for s in surfaces):
                problems.append(f"unreachable: {where}: nothing fires it {setup}")
    return problems


def shell_action(script, parent, uuid_, order):
    return {"BTTIsPureAction": True, "BTTOrder": order, "BTTPredefinedActionType": 206,
             "BTTShellTaskActionConfig": "/bin/bash:::-c:::-:::",
            "BTTShellTaskActionScript": script, "BTTTriggerParentUUID": parent, "BTTUUID": uuid_}


# A BTT action's own top-level keys that `fields` may set (Send Shortcut to Specific App, 128).
ACTION_FIELDS = {"BTTShortcutToSend", "BTTShortcutApp", "BTTShortcutAppUnderCursor", "BTTShortcutSwitchToAppFirst",
                 "BTTLayoutIndependentActionChar"}


def wanted(triggers):
    """The generated triggers as (BTT section, trigger), in order (generate() sets their BTTOrder)."""
    out, order = [], 0
    for t in triggers:
        n = t["name"]
        tid = uid("named", n)
        if "run" in t:
            parts = shlex.split(t["run"])
            script = 'exec "$HOME/.local/bin/' + parts[0] + '"' + "".join(" " + shlex.quote(p) for p in parts[1:])
            act = shell_action(script, tid, uid("named", n, "action"), 0)
        else:
            act = {"BTTIsPureAction": True, "BTTOrder": 0, "BTTPredefinedActionType": t["btt"]["action"],
                   "BTTTriggerParentUUID": tid, "BTTUUID": uid("named", n, "action")}
            if t["btt"].get("data"):
                act["BTTAdditionalActionData"] = dict(t["btt"]["data"])
            act.update(t["btt"].get("fields", {}))
        out.append((GLOBAL, {"BTTActionsToExecute": [act], "BTTGestureNotes": t["action"], "BTTOrder": order,
                             "BTTNamedTriggerAIDescription": t["hint"],
                             "BTTTriggerClass": "BTTTriggerTypeOtherTriggers", "BTTTriggerName": n,
                             "BTTTriggerType": 643, "BTTUUID": tid}))
        order += 1
        for k, scope in ((k, scope) for k in t.get("keys", []) for scope in scopes(t)):
            code, flags = parse_keys(k)
            kid = uid("key", n, k) if scope == GLOBAL else uid("key", n, k, scope)
            log = f'"$HOME/.local/bin/trigger" --log-only {n} key'
            out.append((scope, {"BTTActionsToExecute": [
                            shell_action(log, kid, uid("key", n, k, "log") if scope == GLOBAL else uid("key", n, k, scope, "log"), 0),
                            {"BTTIsPureAction": True, "BTTNamedTriggerToTrigger": n, "BTTOrder": 1, "BTTPredefinedActionType": 248,
                             "BTTTriggerParentUUID": kid,
                             "BTTUUID": uid("key", n, k, "fire") if scope == GLOBAL else uid("key", n, k, scope, "fire")}],
                        "BTTAutoAdaptToKeyboardLayout": 0, "BTTGestureNotes": t["action"], "BTTOrder": order,
                        "BTTShortcutKeyCode": code, "BTTShortcutKeyboardType": 0,
                        "BTTShortcutModifierKeys": flags, "BTTTriggerClass": "BTTTriggerTypeKeyboardShortcut",
                        "BTTTriggerOnDown": 1, "BTTTriggerType": 0, "BTTUUID": kid}))
            order += 1
    return out + [(GLOBAL, p) for p in hints_pieces(triggers)]


# The hints' pieces (#144), with fixed UUIDs.
MENU = "Hints"
HINTS_NAMES = {"hints-close", "hints-next", "hints-mute"}  # generated here; not for triggers.toml
SETUP_EVENTS = {792: "screen connected", 793: "screen disconnected", 683: "lid closed", 684: "lid opened"}
INTERNAL = {uid("hints", "menu"), uid("hints", "close"), uid("hints", "app-change")} | {
    uid("hints", "setup", str(e)) for e in SETUP_EVENTS}
ROW_H, GAP, PAD, WIDTH = 30, 2, 6, 460


def key_label(t):
    for k in t.get("keys", []):
        parsed = parse_keys(k)
        if parsed and parsed[1] == HYPER:
            return "Hyper+" + k.replace("⌃", "").replace("⌥", "").replace("⇧", "").replace("⌘", "")
    return (t.get("keys") or [""])[0]


SURFACE_NAMES = {"streamdeck": "Stream Deck", "knob": "knob", "mouse": "mouse", "touch": "touch",
                 "ipad": "iPad"}


def row_html(text, header=False):
    color = "rgba(255,255,255,0.6)" if header else "white"
    return ("<html><body style='text-align:left;'><span style='font-size:14px; "
            f"color:{color}; font-family:-apple-system;'>{text}</span></body></html>")


def row_text(t, surfaces=None):
    """A trigger's cheat-sheet row: its key, what it does, its apps and its other surfaces (all of
    them, or only those in `surfaces`: what this setup has; `hints setup` passes those)."""
    more = ", ".join(SURFACE_NAMES[s] for s in t.get("fires", [])
                     if s in SURFACE_NAMES and (surfaces is None or s in surfaces))
    return (f"<b>{html.escape(key_label(t))}</b>&nbsp;&nbsp;{html.escape(t['action'])}"
            + (f"<span style='color:rgba(255,255,255,0.6);'> · {html.escape(more)}</span>" if more else ""))


def cheat_sheet_rows(triggers):
    """The triggers that get a row (all but the cheat sheet's own)."""
    return [t for t in triggers if t.get("btt", {}).get("data", {}).get("BTTMenuActionMenuID") != MENU]


def row(n, name, text, script, menu_uuid, header=False, shown=True, uuid_key=None):
    """A cheat-sheet row. App rows start hidden: `hints app` shows the front app's."""
    iid = uid("hints", "menu", name) if uuid_key is None else uid("hints", "menu", name, uuid_key)
    item = {"BTTTriggerType": 773, "BTTTriggerClass": "BTTTriggerTypeFloatingMenu",
            "BTTOrder": n, "BTTTriggerParentUUID": menu_uuid, "BTTUUID": iid, "BTTMenuName": name,
            "BTTMenuAvailability": 0,
            "BTTMenuConfig": {"BTTMenuAlwaysUseLightMode": 1, "BTTMenuItemVisibleWhileActive": int(shown),
                              "BTTMenuItemVisibleWhileInactive": int(shown), "BTTMenuItemMinWidth": WIDTH - 2 * PAD,
                              "BTTMenuItemMaxWidth": WIDTH - 2 * PAD, "BTTMenuItemMinHeight": ROW_H,
                              "BTTMenuItemMaxHeight": ROW_H, "BTTMenuItemBackgroundType": 4,
                              "BTTMenuItemBackgroundColor": "0, 0, 0, 0",
                              "BTTMenuItemBackgroundColorHover": "0, 0, 0, 0" if header else "10, 132, 255, 255",
                              "BTTMenuItemCornerRadius": 7, "BTTMenuTextOffsetX": 10,
                              "BTTMenuAttributedText": row_html(text, header)}}
    if script:
        item["BTTMenuItemActions"] = [shell_action(script, iid, uid("hints", "menu", name, "action"), 0)]
    return item


def hints_pieces(triggers):
    menu_uuid = uid("hints", "menu")
    own = [t for t in triggers if t.get("btt", {}).get("data", {}).get("BTTMenuActionMenuID") == MENU]
    title = (key_label(own[0]) + " · " if own else "") + "what you can do"
    rows = [row(0, "Header", html.escape(title), None, menu_uuid, header=True)]
    for t in cheat_sheet_rows(triggers):
        rows.append(row(len(rows), t["name"], row_text(t), f'"$HOME/.local/bin/trigger" {t["name"]} menu', menu_uuid,
                        shown=not t.get("apps")))
    # The hint controls stay last: BTT keeps an existing row's place, so they get new UUIDs (new
    # rows, placed after the rest) whenever the trigger rows change.
    after = ",".join(r["BTTMenuName"] for r in rows)
    for name, text, cmd in (("hints-next", "Next hint", "next"), ("hints-mute", "Mute these hints", "mute")):
        rows.append(row(len(rows), name, text, f'"$HOME/.local/bin/hints" {cmd}', menu_uuid, uuid_key=after))
    # It sizes to the rows shown (content sizing); rows have a fixed width, so only the height moves.
    shown = [r for r in rows if r["BTTMenuConfig"]["BTTMenuItemVisibleWhileActive"]]
    height = 2 * PAD + len(shown) * ROW_H + (len(shown) - 1) * GAP
    menu = {"BTTTriggerType": 767, "BTTTriggerClass": "BTTTriggerTypeFloatingMenu",
            "BTTTriggerName": f"Floating Menu: {MENU}", "BTTMenuName": MENU, "BTTMenuAvailability": 0,
            "BTTUUID": menu_uuid, "BTTGestureNotes": "Hints: cheat sheet (generated from triggers.toml)",
            "BTTMenuConfig": {"BTTMenuPositioningType": 1, "BTTMenuPositionRelativeTo": 3,
                              "BTTMenuAnchorMenu": 4, "BTTMenuAnchorRelation": 4, "BTTMenuLayoutDirection": 6,
                              "BTTMenuSizingBehavior": 3, "BTTMenuFrameWidth": WIDTH, "BTTMenuFrameHeight": height,
                              "BTTMenuVerticalSpacing": GAP, "BTTMenuHorizontalSpacing": GAP,
                              "BTTMenuWindowLevel": 3, "BTTMenuVisibility": 1, "BTTMenuCloseOnOutsideClick": 1,
                              "BTTMenuCloseAfterAction": 1, "BTTMenuDisableDrag": 1, "BTTMenuAlwaysUseLightMode": 1,
                              "BTTMenuItemBackgroundType": 4, "BTTMenuItemBackgroundColor": "28, 28, 30, 200",
                              "BTTMenuItemBlurredBackground": 1, "BTTMenuItemBorderWidth": 1,
                              "BTTMenuItemBorderColor": "255, 255, 255, 46", "BTTMenuItemCornerRadius": 12,
                              "BTTMenuItemPaddingLeft": PAD, "BTTMenuItemPaddingRight": PAD,
                              "BTTMenuItemPaddingTop": PAD, "BTTMenuItemPaddingBottom": PAD},
            "BTTMenuItems": rows}
    close_uuid = uid("hints", "close")
    close = {"BTTTriggerType": 643, "BTTTriggerClass": "BTTTriggerTypeOtherTriggers", "BTTTriggerName": "hints-close",
             "BTTUUID": close_uuid, "BTTGestureNotes": "Hints: close hint notifications",
             "BTTActionsToExecute": [{"BTTIsPureAction": True, "BTTOrder": 0, "BTTPredefinedActionType": 289,
                                      "BTTTriggerParentUUID": close_uuid, "BTTUUID": uid("hints", "close", "action"),
                                      "BTTAdditionalActionData": {"BTTCloseNotificationsMode": "matching",
                                                                  "BTTCloseNotificationsTitleRegex": "^Hint"}}]}
    app_uuid = uid("hints", "app-change")
    app = {"BTTTriggerType": 779, "BTTTriggerClass": "BTTTriggerTypeOtherTriggers", "BTTUUID": app_uuid,
           "BTTGestureNotes": "Hints: the daily hints (hints app)",
           "BTTActionsToExecute": [shell_action('"$HOME/.local/bin/hints" app >/dev/null 2>&1 &', app_uuid,
                                                uid("hints", "app-change", "action"), 0)]}
    setup = []
    for event, what in sorted(SETUP_EVENTS.items()):
        sid = uid("hints", "setup", str(event))
        # A moment's wait: the display list settles after the event.
        setup.append({"BTTTriggerType": event, "BTTTriggerClass": "BTTTriggerTypeOtherTriggers", "BTTUUID": sid,
                      "BTTGestureNotes": f"Hints: {what} (hints setup)",
                      "BTTActionsToExecute": [shell_action('(sleep 2; "$HOME/.local/bin/hints" setup) >/dev/null 2>&1 &',
                                                           sid, uid("hints", "setup", str(event), "action"), 0)]})
    return [menu, close, app] + setup


def generated(t):
    """Whether the generator owns this preset trigger."""
    return t.get("BTTUUID") in INTERNAL or t.get("BTTTriggerType") == 643 or (
        t.get("BTTTriggerClass") == "BTTTriggerTypeKeyboardShortcut"
        and any(a.get("BTTPredefinedActionType") == 248 for a in t.get("BTTActionsToExecute") or []))


LISTS = {"BTTActionsToExecute", "BTTMenuItems", "BTTMenuItemActions"}
# Fields the generator writes that an entry can stop needing (switching run and btt, dropping
# data): cleared from the old trigger first, so they don't linger.
OWNED = {"BTTAdditionalActionData", "BTTShellTaskActionScript", "BTTShellTaskActionConfig",
         "BTTNamedTriggerToTrigger", "BTTPredefinedActionName", "BTTPredefinedActionType"} | ACTION_FIELDS


def merge(old, new):
    """new's keys over old's; actions matched by UUID the same way. Keeps what BTT added, except
    the action's display name when the action itself changed."""
    out = {k: v for k, v in old.items() if k not in OWNED}
    if old.get("BTTPredefinedActionType") == new.get("BTTPredefinedActionType") and "BTTPredefinedActionName" in old:
        out["BTTPredefinedActionName"] = old["BTTPredefinedActionName"]
    out.update(new)
    for k, v in new.items():
        if k in LISTS:  # actions and menu items: matched by UUID
            before = {a.get("BTTUUID"): a for a in old.get(k) or []}
            out[k] = [merge(before.get(a["BTTUUID"], {}), a) for a in v]
            if k == "BTTMenuItems" and before:
                # BTT keeps a row's order on import and numbers only new rows: keep its order,
                # put new rows after the last, and list them as BTT exports them.
                nxt = max(a.get("BTTOrder", 0) for a in before.values()) + 1
                for a in out[k]:
                    if a["BTTUUID"] in before and "BTTOrder" in before[a["BTTUUID"]]:
                        a["BTTOrder"] = before[a["BTTUUID"]]["BTTOrder"]
                    else:
                        a["BTTOrder"], nxt = nxt, nxt + 1
                out[k].sort(key=lambda a: (a.get("BTTOrder", 0), a.get("BTTUUID", "")))  # as btt-sync normalizes
        elif isinstance(v, dict) and isinstance(old.get(k), dict) and k not in OWNED:
            out[k] = {**old[k], **v}  # a menu's config: keep the defaults BTT fills in
    return out


CLASHES = []  # hand-made BTT keyboard triggers on a generated key, found by generate()


def generate(preset, triggers):
    """Returns the preset and what it dropped: generated triggers no longer in triggers.toml,
    or named triggers made in BTT. BTT renumbers triggers 0, 1, 2… on import, so a trigger keeps
    the order it has; a new one goes after the last."""
    sections = {a.get("BTTAppBundleIdentifier"): a for a in preset["BTTPresetContent"]}
    want = {}
    for scope, w in wanted(triggers):
        want.setdefault(scope, []).append(w)
        if scope not in sections:  # an app BTT has no section for yet
            sections[scope] = {"BTTAppBundleIdentifier": scope, "BTTAppName": scope, "BTTTriggers": []}
            preset["BTTPresetContent"].append(sections[scope])
    dropped = []
    for scope, section in sections.items():
        current = section.get("BTTTriggers", [])
        if scope not in want and not any(generated(t) for t in current):
            continue
        kept = [t for t in current if not generated(t)]
        existing = {t.get("BTTUUID"): t for t in current if generated(t)}
        nxt = max([t.get("BTTOrder", 0) for t in current] or [-1]) + 1
        new = []
        for w in want.get(scope, []):
            old = existing.get(w["BTTUUID"], {})
            if "BTTOrder" in old:
                w["BTTOrder"] = old["BTTOrder"]
            else:
                w["BTTOrder"], nxt = nxt, nxt + 1
            new.append(merge(old, w))
        keep = {w["BTTUUID"] for w in new}
        dropped += [t.get("BTTTriggerName") or t.get("BTTGestureNotes") or t.get("BTTUUID")
                    for t in current if generated(t) and t.get("BTTUUID") not in keep]
        mine = {(w.get("BTTShortcutKeyCode"), w.get("BTTShortcutModifierKeys")) for w in new
                if w.get("BTTTriggerClass") == "BTTTriggerTypeKeyboardShortcut"}
        CLASHES.extend(f"{t.get('BTTGestureNotes') or t.get('BTTUUID')} ({scope})" for t in kept
                       if t.get("BTTTriggerClass") == "BTTTriggerTypeKeyboardShortcut"
                       and (t.get("BTTShortcutKeyCode"), t.get("BTTShortcutModifierKeys")) in mine)
        # In BTT's order, as it exports them.
        section["BTTTriggers"] = sorted(kept + new, key=lambda t: t.get("BTTOrder", 0))
    return preset, dropped


def dump(d):
    return json.dumps(d, indent=2, separators=(",", " : "), ensure_ascii=False, sort_keys=True) + "\n"


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--source", help="dotfiles source dir (default: chezmoi source-path)")
    ap.add_argument("--write", action="store_true", help="regenerate the triggers in the preset")
    ap.add_argument("--list", action="store_true", help="print the triggers and their keys")
    a = ap.parse_args()
    src = a.source or os.environ.get("CHEZMOI_SOURCE_DIR") or subprocess.run(
        ["chezmoi", "source-path"], capture_output=True, text=True).stdout.strip()
    triggers = load(src)
    problems = validate(src, triggers)
    if a.list:
        for t in triggers:
            print(f"{t['name']:<16} {', '.join(t.get('keys', [])):<20} {t['action']}")
    if problems:
        print("\n".join(problems))
        print(f"{len(problems)} problem(s)")
        sys.exit(1)
    path = os.path.join(src, "macos/btt/Default.bttpreset")
    with open(path, encoding="utf-8") as f:
        text = f.read()
    d, dropped = generate(json.loads(text), triggers)
    out = dump(d)
    if CLASHES:
        print("\n".join(f"conflict: {c} is a hand-made BTT trigger on a key triggers.toml generates; "
                        "delete it in BTT (or the preset)" for c in CLASHES))
        sys.exit(1)
    for name in dropped:
        print(f"{'dropping' if a.write else 'not in triggers.toml'}: {name} (named triggers and the "
              "keys that fire them come from triggers.toml; add it there to keep it)")
    if a.write:
        if out != text:
            with open(path + ".tmp", "w", encoding="utf-8") as f:
                f.write(out)
            os.replace(path + ".tmp", path)
            print(f"wrote {len(triggers)} triggers to {path}; run btt-sync import")
        else:
            print(f"ok: {len(triggers)} triggers, preset up to date")
        return
    if out != text:
        print("stale: macos/btt/Default.bttpreset doesn't match triggers.toml; run trigger-check --write")
        sys.exit(1)
    print(f"ok: {len(triggers)} triggers, reachable in every setup")


if __name__ == "__main__":
    main()
