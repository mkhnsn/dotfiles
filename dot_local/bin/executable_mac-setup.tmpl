#!/bin/bash
# mac-setup — walk a new Mac through setup, checking each step.
#
# Each step has a check. Steps that pass are ticked; for the first one that fails it
# says what to do, offers to do it when it can, and re-checks before moving on.
# Safe to re-run any time: it picks up where things stand.
#
# Usage:
#   mac-setup            guided run
#   mac-setup --status   checks only, no prompts (exit 1 if anything is left)
#   mac-setup --reset    forget the steps you confirmed by hand
#
# Steps you can only confirm by hand are remembered in ~/.local/state/mac-setup.
# Runbook: unstable-studios/echo-core docs/devices/README.md (New Mac runbook).
# Bash 3.2-compatible (stock macOS).

# check_/help_/act_ functions are called by name ("check_$id").
# shellcheck disable=SC2317,SC2329  # SC2317 on older shellcheck

set -u

[ "$(uname -s)" = "Darwin" ] || { echo "mac-setup: macOS only"; exit 1; }

# MAC_SETUP_BREW overrides where to look for Homebrew (tests).
for b in ${MAC_SETUP_BREW:-/opt/homebrew/bin/brew /usr/local/bin/brew}; do
  [ -x "$b" ] && eval "$("$b" shellenv)" && break
done
export PATH="$HOME/.local/bin:$PATH"

# From chezmoi data (set on `chezmoi init`).
HOSTNAME_WANT="{{ .hostname }}"
{{- if dig "is_server" false . }}
TAG_WANT="tag:echo-core"
ROLE="server"
{{- else }}
TAG_WANT="tag:echo-admin"
ROLE="workstation"
{{- end }}

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mac-setup"
# Overridable for tests (tests/mac-setup.test.sh).
APPS="${MAC_SETUP_APPS:-/Applications}"
TTY="${MAC_SETUP_TTY:-/dev/tty}"
SERIAL="$(ioreg -l | awk -F'"' '/IOPlatformSerialNumber/{print $4; exit}')"
MODE=guided
case "${1:-}" in
  --status) MODE=status ;;
  --reset) rm -rf "$STATE_DIR"; echo "Forgot the steps confirmed by hand."; exit 0 ;;
  -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
  "") ;;
  *) echo "usage: mac-setup [--status|--reset]"; exit 1 ;;
esac
mkdir -p "$STATE_DIR"
if [ "$MODE" = guided ]; then
  # The braces scope 2>/dev/null to this open; a bare `exec 3<x 2>/dev/null` would
  # silence stderr (prompts, gh's login code) for the rest of the run.
  { exec 3<"$TTY"; } 2>/dev/null || { echo "mac-setup: needs a terminal for prompts; use --status"; exit 1; }
fi

if [ -t 1 ]; then G=$'\e[32m'; Y=$'\e[33m'; D=$'\e[2m'; B=$'\e[1m'; R=$'\e[0m'; else G='' Y='' D='' B='' R=''; fi

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
ts_bin() {
  command -v tailscale 2>/dev/null && return 0
  [ -x "$APPS/Tailscale.app/Contents/MacOS/Tailscale" ] && echo "$APPS/Tailscale.app/Contents/MacOS/Tailscale"
}
ts_json() { local t; t="$(ts_bin)" || return 1; [ -n "$t" ] && "$t" status --json --peers=false 2>/dev/null; }
# Per-item steps are "base:item"; their state file is the id with unsafe characters
# replaced. A file for the base alone is from when the step wasn't split, and covers all items.
state_key() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }
confirmed() { [ -f "$STATE_DIR/$(state_key "$1")" ] || [ -f "$STATE_DIR/${1%%:*}" ]; }
workstation() { [ "$ROLE" = workstation ]; }

# Apps with no Homebrew cask: app bundle | where to get it.
VENDOR_APPS="OpenSCAD|https://openscad.org/downloads.html
Festivitas|https://festivitas.app
Cursorful|https://cursorful.com
HueForge|https://shop.thehueforge.com
MASSO Link|https://www.masso.com.au
EXStar Hub|https://www.shining3d.com
3DconnexionSettings|https://3dconnexion.com/drivers"
vendor_steps() { local name
  while IFS='|' read -r name _; do echo "vendor:$name|$name installed|Apps"; done <<EOF2
$VENDOR_APPS
EOF2
}
vendor_url() { printf '%s\n' "$VENDOR_APPS" | awk -F'|' -v n="$1" '$1==n{print $2}'; }
# Apps to sign in to or activate: label | app to open | note.
LICENSES="Microsoft 365 (Office)|Microsoft Word|
Fantastical|Fantastical|
PDF Expert|PDF Expert|
Bartender|Bartender 7|
BetterDisplay|BetterDisplay|
BetterMouse|BetterMouse|Set the mouse to standard scrolling; the trackpad stays natural.
DaisyDisk|DaisyDisk|
Parallels|Parallels Desktop|
LightBurn|LightBurn|
HueForge|HueForge|
Fusion|Autodesk Fusion|
Raycast|Raycast|
Slack|Slack|
Claude|Claude|"
license_field() { printf '%s\n' "$LICENSES" | awk -F'|' -v n="$1" -v f="$2" '$1==n{print $f}'; }
license_steps() { local l
  while IFS='|' read -r l _ _; do echo "license:$l|$l signed in or activated|Apps"; done <<EOF2
$LICENSES
EOF2
}
# Private app exports: label | app | where to restore | old Mac step name
EXPORTS="Stream Deck|Elgato Stream Deck|Preferences > Profiles > Restore
BetterDisplay|BetterDisplay|Settings > Application > Import
BetterMouse|BetterMouse|its settings, restore the configuration backup"
export_field() { printf '%s\n' "$EXPORTS" | awk -F'|' -v n="$1" -v f="$2" '$1==n{print $f}'; }
export_steps() { local l
  while IFS='|' read -r l _ _; do echo "export:$l|$l export restored|Apps"; done <<EOF2
$EXPORTS
EOF2
}

default_browser() {
  defaults read "$HOME/Library/Preferences/com.apple.LaunchServices/com.apple.launchservices.secure" LSHandlers 2>/dev/null |
    awk 'BEGIN{RS="}"} /LSHandlerURLScheme = http;/ { if (match($0,/LSHandlerRoleAll = "[^"]*"/)) print substr($0,RSTART+20,RLENGTH-21) }'
}

# ---- Checks: each returns 0 when the step is done ----------------------------------

check_user()       { [ "$(id -u)" -ne 0 ] && [ -n "${HOME:-}" ]; }
check_mdm()        { profiles status -type enrollment 2>/dev/null | grep -q "MDM enrollment: Yes"; }
# Servers run without FileVault so they recover from restarts unattended (echo-core two-machine plan).
check_filevault()  { workstation || return 0; fdesetup status 2>/dev/null | grep -q "FileVault is On"; }
PROFILES_WANT="macOS: Firewall|macOS: NinjaOne privacy permissions|macOS: Terminal privacy permissions"
profiles_missing() { local p n; p="$(system_profiler SPConfigurationProfileDataType 2>/dev/null)"
                     printf '%s\n' "$PROFILES_WANT" | tr '|' '\n' | while read -r n; do printf '%s' "$p" | grep -qF "$n" || echo "$n"; done; }
check_profiles()   { [ -z "$(profiles_missing)" ]; }
# SimpleMDM's rename sets the computer name and, from it, the local hostname ("MikeBook Pro"
# -> "MikeBook-Pro"); chezmoi's hostname data is the local-hostname form.
check_hostname()   { [ "$(scutil --get LocalHostName 2>/dev/null)" = "$(printf '%s' "$HOSTNAME_WANT" | tr ' ' '-')" ]; }
check_ninja()      { pgrep -f NinjaRMMAgent/programfiles/ninjarmm-macagent >/dev/null; }
check_escrow()     { workstation || return 0; confirmed "escrow:$1"; }
# Ninja Backup installs lockhart only once backup is deployed to the device in Ninja.
LOCKHART="/Applications/NinjaRMMAgent/programfiles/lockhart/bin/lockhart"
check_ninja_backup(){ workstation || return 0; [ -x "${MAC_SETUP_LOCKHART:-$LOCKHART}" ]; }
check_ninja_backup_run(){ workstation || return 0; check_ninja_backup && confirmed ninja_backup_run; }
# Ask Homebrew's own doctor checks, which are what make it refuse stale tools.
check_clt()        { xcode-select -p >/dev/null 2>&1 || return 1
                     command -v brew >/dev/null 2>&1 || return 0
                     brew doctor check_for_installed_developer_tools check_if_supported_sdk_available >/dev/null 2>&1; }
check_brew()       { command -v brew >/dev/null 2>&1; }
check_rosetta()    { [ "$(uname -m)" != arm64 ] || arch -x86_64 /usr/bin/true 2>/dev/null; }
check_onepassword(){ command -v op >/dev/null 2>&1 && op account list 2>/dev/null | grep -q .; }
OP_AGENT="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
check_op_ssh()     { workstation || return 0; [ -e "$OP_AGENT" ]; }
check_op_browser() { workstation || return 0; confirmed "op_browser:$1"; }
# After a dotfiles update changes .chezmoi.toml.tmpl, chezmoi warns until `chezmoi init` runs.
chezmoi_config_stale() { chezmoi verify --exclude=scripts,templates 2>&1 | grep -q "config file template has changed"; }
check_chezmoi()    { local s; s="$(chezmoi source-path 2>/dev/null)" && [ -d "$s/.git" ] && ! chezmoi_config_stale &&
                     chezmoi verify --exclude=scripts,templates >/dev/null 2>&1; }
check_brewfile()   { brew bundle check --no-upgrade --file "$(chezmoi source-path)/Brewfile" >/dev/null 2>&1; }
check_gh()         { gh auth status >/dev/null 2>&1; }
# With Desktop & Documents in iCloud on, iCloud Drive's Desktop and Documents are links to the
# home folders; off, they're plain folders (or missing) and the home folders stay local.
ICLOUD_DRIVE="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
check_icloud_docs(){ workstation || return 0; local d
                     for d in Desktop Documents; do [ "$(readlink "$ICLOUD_DRIVE/$d" 2>/dev/null)" = "$HOME/$d" ] || return 1; done; }
check_icloud_local(){ workstation || return 0; [ "$(defaults read com.apple.bird optimize-storage 2>/dev/null)" != 1 ]; }
check_doppler()    { doppler me >/dev/null 2>&1; }
check_tailscale()  { ts_json | grep -Eq '"BackendState": *"Running"'; }
# The console machine name is the first label of DNSName (HostName is the OS hostname).
check_ts_name()    { [ "$(ts_json | sed -n 's/.*"DNSName": *"\([^."]*\)\..*/\1/p' | head -1)" = "$(lower "$HOSTNAME_WANT")" ]; }
check_ts_tag()     { ts_json | grep -q "\"$TAG_WANT\""; }
# Remote Login (macOS sshd), limited to you through the com.apple.access_ssh group.
# Tailscale SSH isn't an option: the Tailscale app build on macOS can't run its SSH server.
ssh_listening()    { nc -z -G 2 127.0.0.1 22 >/dev/null 2>&1; }
check_ssh_server() { ssh_listening && dscl . -read /Groups/com.apple.access_ssh >/dev/null 2>&1 &&
                     dsmemberutil checkmembership -U "$(id -un)" -G com.apple.access_ssh 2>/dev/null | grep -q "is a member"; }
check_btt()        { workstation || return 0; [ -d "$APPS/BetterTouchTool.app" ] && [ ! -d "$(brew --prefix 2>/dev/null)/Caskroom/bettertouchtool" ]; }
check_btt_preset() { workstation || return 0; pgrep -x BetterTouchTool >/dev/null &&
                     osascript -e 'tell application "BetterTouchTool" to get_triggers' 2>/dev/null | grep -qi litra; }
check_remote()     { confirmed remote; }
# Casks whose app is already installed in a way Homebrew can't take over (see brew-why).
ws_skip()          { command -v brew-why >/dev/null 2>&1 && brew-why --skip --brewfile "$(chezmoi source-path)/Brewfile.workstation" 2>/dev/null; }
check_ws_apps()    { workstation || return 0
                     HOMEBREW_BUNDLE_CASK_SKIP="$(ws_skip)" brew bundle check --no-upgrade --file "$(chezmoi source-path)/Brewfile.workstation" >/dev/null 2>&1; }
check_vendor()     { workstation || return 0; [ -d "$APPS/$1.app" ]; }
check_gridfinity() { workstation || return 0; [ -d "$APPS/gridfinity-studio.app" ]; }
# Confirmations saved before the US spelling ("licence:<app>", "licences") still count.
check_license()    { workstation || return 0; confirmed "license:$1" || confirmed "licence:$1" || confirmed licences; }
check_app_prefs()  { workstation || return 0; app-prefs check >/dev/null 2>&1; }
EXPORTS_DIR="${MAC_SETUP_ONEDRIVE:-$HOME/Library/CloudStorage/OneDrive-UnstableStudios}/Apps/Mac app exports"
check_onedrive()   { workstation || return 0; [ -d "${MAC_SETUP_ONEDRIVE:-$HOME/Library/CloudStorage/OneDrive-UnstableStudios}" ]; }
# BetterMouse wasn't in the combined step, so the old confirmation doesn't cover it.
check_export()     { workstation || return 0; confirmed "export:$1" || { [ "$1" != BetterMouse ] && confirmed app_exports; }; }
check_vm()         { workstation || return 0; confirmed vm; }
check_defaults()   { mac-defaults --check >/dev/null 2>&1; }
# Time Machine to echo-nas: the fast local restore (Ninja Backup is the off-site copy).
# destinationinfo works without Full Disk Access; latestbackup doesn't.
check_timemachine(){ workstation || return 0; tmutil destinationinfo 2>/dev/null | grep -q '^Name'; }
# VM disks change constantly, so every hourly backup would re-copy them. The valuable data
# (VCarve) has its own copy (~/VCarve/Backup); the VM rebuilds from Intune. A sticky
# exclusion on the folder covers VMs added later.
check_tm_no_vms()  { workstation || return 0; [ ! -d "$HOME/Parallels" ] || tmutil isexcluded "$HOME/Parallels" 2>/dev/null | grep -q '^\[Excluded\]'; }
check_browser()    { workstation || return 0; [ "$(default_browser)" = com.google.chrome ]; }

# ---- Help: what to do when a check fails ------------------------------------------

help_user()       { echo "Run this in Terminal as yourself, not as root or from Ninja's terminal (it's root)."; }
help_mdm()        { echo "Not enrolled. Erase the Mac and set it up again so ADE enrolls it (check the serial is assigned to SimpleMDM - macOS in ABM)."; }
help_filevault()  { echo "Turn on FileVault: System Settings > Privacy & Security > FileVault. The MDM profile escrows the key."; }
help_profiles()   { echo "MDM profiles missing: $(profiles_missing | paste -sd, - | sed 's/,/, /g'). Check the device is in its SimpleMDM group (Terminals for workstations) and push profiles from its device page."; }
help_hostname()   { echo "This Mac should be named $HOSTNAME_WANT. Rename it in SimpleMDM (device page > Rename), which sets the computer name. Replacing a Mac: rename the old one first so the names don't clash."; }
help_ninja()      { echo "NinjaOne agent not running. SimpleMDM installs it; check the app install on the device page, or reinstall the agent pkg."; }
help_ninja_backup(){ echo "In NinjaOne: Organization > Unstable Studios > Backup > Deployment, enable this Mac (per device; leave All workstations unticked). Ninja then installs its backup agent; MDM already grants it Full Disk Access."; }
help_ninja_backup_run(){ echo "In NinjaOne, open this Mac and run the 'UnSt - Mac home folder' backup plan once. Confirm it finishes without errors."; }
help_escrow()     { case "$1" in
                      filevault) echo "In SimpleMDM, open this Mac ($SERIAL) and reveal the FDE Recovery Key. Save it in 1Password, in one item named after the Mac and serial." ;;
                      *) echo "In SimpleMDM, open this Mac ($SERIAL) and reveal the Activation Lock Bypass Code. Save it in the same 1Password item as the FileVault key." ;;
                    esac; }
help_clt()        { echo "Command Line Tools missing or stale (Homebrew refuses old ones)."; }
help_brew()       { echo "Homebrew isn't installed."; }
help_rosetta()     { echo "Rosetta isn't installed. Parallels' setup and Intel-only apps need it."; }
help_onepassword(){ echo "1Password app and CLI integration: sign in to 1Password, then Settings > Developer > Integrate with 1Password CLI. The first time op runs, macOS asks to let your terminal access data from other apps: allow it (MDM can't pre-approve this one)."; }
help_op_ssh()      { echo "Turn on the 1Password SSH agent (git signs commits through it): 1Password > Settings > Developer > Use the SSH agent."; }
help_op_browser()  { case "$1" in
                       chrome) echo "Sign in to your Google profile in Chrome. Chrome Sync installs the 1Password extension." ;;
                       connect) echo "In 1Password: Settings > Browser > Connect with 1Password in the browser." ;;
                       *) echo "In 1Password: Settings > General > Show Quick Access: Cmd+Shift+Space." ;;
                     esac; }
help_chezmoi()    { if chezmoi_config_stale; then echo "The dotfiles' config template changed: chezmoi init regenerates ~/.config/chezmoi/chezmoi.toml (it keeps your answers)."; else echo "Dotfiles not applied, or out of date."; fi; }
help_brewfile()   { echo "Brewfile packages missing."; }
help_icloud_docs() { echo "Turn on Desktop & Documents in iCloud: System Settings > your name > iCloud > Drive > Desktop & Documents Folders. MDM can only allow it, not switch it on; Setup Assistant offers it too. Files from your other Macs' Desktop and Documents then appear here."; }
help_icloud_local(){ echo "Turn off Optimize Mac Storage: System Settings > your name > iCloud. Desktop and Documents then stay downloaded, so Ninja Backup backs up real files (with Optimize on, iCloud swaps older files for placeholders that the backup can't read)."; }
help_gh()         { echo "GitHub CLI not signed in. The action runs gh auth login (HTTPS); signing in with SSH works too."; }
help_doppler()    { echo "Doppler CLI not signed in."; }
help_tailscale()  { echo "Tailscale isn't connected. Install the app, open it and sign in; turn on its CLI in the app's settings if 'tailscale' isn't found."; }
help_ts_name()    { echo "Tailscale machine name should be $(lower "$HOSTNAME_WANT"). Rename it: admin console > Machines > ... > Edit machine name (turn off auto-generate). Replacing a Mac: rename the old machine first, or the new one gets a -1 suffix."; }
help_ssh_server() { echo "Turn on Remote Login for your user only, so your other Macs can reach this one (VM copies, rsync). The action turns on sshd and limits it to $(id -un); same as System Settings > General > Sharing > Remote Login with 'Only these users'. Leave 'Allow full disk access for remote users' off."; }
help_ts_tag()     { echo "Add $TAG_WANT in the Tailscale admin console: Machines > $(lower "$HOSTNAME_WANT") > ... > Edit ACL tags."; }
help_btt()        { echo "Install BetterTouchTool from https://folivora.ai (not Homebrew) and activate the license."; }
help_btt_preset() { if pgrep -x BetterTouchTool >/dev/null; then echo "Import the BTT preset from the dotfiles. It asks for Accessibility once.";
                    else echo "BetterTouchTool isn't running, so its triggers aren't either. Open it, and turn on Launch on startup in its settings."; fi; }
help_ws_apps()    { echo "Apps from Brewfile.workstation are missing. App Store apps need you signed in to the App Store first (open App Store > Sign In)."
                    command -v brew-why >/dev/null 2>&1 && brew-why --brewfile "$(chezmoi source-path)/Brewfile.workstation" 2>/dev/null | sed 's/^/    /'; true; }
help_vendor()     { echo "$1 has no Homebrew cask. Download it from $(vendor_url "$1") and install it."; }
help_gridfinity() { echo "gridfinity-studio, from the latest GitHub release of unstable-studios/gridfinity-studio."; }
help_license()    { local n; n="$(license_field "$1" 3)"; echo "Open $1 and sign in or enter its license.${n:+ $n}"; }
help_app_prefs()   { echo "Saved app settings (macos/prefs) differ here. Quit these apps first; a running app writes its own settings back:"; app-prefs diff 2>/dev/null | sed 's/^/    /'; }
help_onedrive()    { echo "Sign in to OneDrive with your Unstable Studios account (mike@unstablestudios.com). The private app exports sync through it."; }
help_export()      { echo "Restore $1 from its export in OneDrive (Unstable Studios) > Apps > Mac app exports: $(export_field "$1" 3). Make the export on the old Mac first."; }
help_vm()          { cat <<'EOV'
Windows VM (VCarve), on the old Mac: shut it down (not suspended), then in Parallels: File > Pack ("vWindows 11.pvmp", about half the size) and write its checksum: shasum -a 256 "vWindows 11.pvmp" | cut -d' ' -f1 > "vWindows 11.sha256.txt".
      Copy both to ~/Parallels here: rsync -a --partial ~/Parallels/vWindows\ 11.* <this-mac>:Parallels/ (needs Remote Login and the dotfiles' authorized_keys here), or an external SSD.
      Here: shasum -a 256 "vWindows 11.pvmp" must match the .txt. Double-click the .pvmp to unpack, choose "I moved it" (keeps Windows activation and VCarve's license), start Windows and open VCarve. Then delete the .pvmp on both Macs.
      Answer y if there's no VM to move.
EOV
}
help_timemachine() { echo "Back up to echo-nas with Time Machine. echo-nas isn't announced on the local network, so it never shows in Add Backup Disk; add it by address (asks for the NAS account's password, in 1Password): sudo tmutil setdestination -a -p \"smb://<nas-user>@echo-nas/backups\". Then tmutil startbackup. It's the local, whole-Mac restore; Ninja Backup is the off-site one."; }
help_tm_no_vms()  { echo "Keep virtual machines out of Time Machine: tmutil addexclusion ~/Parallels (no admin needed). VM disks change constantly, so each backup would re-copy them."; }
help_defaults()   { echo "macOS settings or the Dock differ from the dotfiles:"; mac-defaults --diff 2>/dev/null | sed 's/^/    /'; }
help_browser()    { echo "Make Google Chrome the default browser. macOS shows a dialog: choose Use Chrome, then press Enter here."; }
help_remote()     { echo "Start a Ninja Remote session to this Mac and approve Screen Recording for ncstreamer (MDM can't grant it)."; }

# ---- Actions: what this script can do itself (optional) --------------------------

act_clt() {
  if [ -d /Library/Developer/CommandLineTools ]; then
    echo "Removing the old Command Line Tools (asks for your password)…"
    sudo rm -rf /Library/Developer/CommandLineTools
  fi
  xcode-select --install
  echo "Click Install in the window that opened, and wait for it to finish."
}
act_brew()        { /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" && eval "$(/opt/homebrew/bin/brew shellenv)"; }
act_rosetta()      { sudo softwareupdate --install-rosetta --agree-to-license; }
act_onepassword() { command -v op >/dev/null 2>&1 || brew install --cask 1password 1password-cli; open -a 1Password; }
act_op_ssh()       { open -a 1Password; }
act_op_browser()   { case "$1" in chrome) open -a "Google Chrome" ;; *) open -a 1Password ;; esac; }
act_license()      { open -a "$(license_field "$1" 2)" 2>/dev/null || echo "    $1 isn't installed yet."; }
act_onedrive()     { open -a OneDrive; }
act_export()       { open "$EXPORTS_DIR" 2>/dev/null; open -a "$(export_field "$1" 2)" 2>/dev/null; }
act_chezmoi() {
  if chezmoi_config_stale; then chezmoi init; return; fi
  if [ -d "$(chezmoi source-path 2>/dev/null)/.git" ]; then chezmoi update
  else bash -c "$(curl -fsSL https://raw.githubusercontent.com/mkhnsn/dotfiles/main/install.sh)"; fi
}
act_ssh_server() {
  local me; me="$(id -un)"
  echo "Turning on Remote Login for $me (asks for your password)…"
  # launchctl, not systemsetup: systemsetup needs Full Disk Access for the terminal.
  sudo launchctl enable system/com.openssh.sshd
  sudo launchctl bootstrap system /System/Library/LaunchDaemons/ssh.plist 2>/dev/null || true
  dscl . -read /Groups/com.apple.access_ssh >/dev/null 2>&1 ||
    sudo dseditgroup -o create -r "SSH Service ACL" com.apple.access_ssh
  sudo dseditgroup -o edit -a "$me" -t user com.apple.access_ssh
}
act_brewfile()    { chezmoi apply; }
act_gh()          { gh auth login --web --git-protocol https; }
act_doppler()     { doppler login; }
act_tailscale()   { [ -d "$APPS/Tailscale.app" ] || brew install --cask tailscale-app; open -a Tailscale; }
act_btt()         { open "https://folivora.ai"; }
act_ws_apps()     { HOMEBREW_CASK_OPTS="--adopt" HOMEBREW_BUNDLE_CASK_SKIP="$(ws_skip)" brew bundle --file "$(chezmoi source-path)/Brewfile.workstation"; }
act_vendor()      { open "$(vendor_url "$1")"; }
act_gridfinity() {
  local tmp; tmp="$(mktemp -d)"
  gh release download -R unstable-studios/gridfinity-studio --pattern '*arm64-mac.zip' -D "$tmp" &&
    ditto -x -k "$tmp"/*arm64-mac.zip "$APPS" && echo "Installed gridfinity-studio"
  rm -rf "$tmp"
}
act_app_prefs()    { app-prefs apply; }
act_timemachine() { open "x-apple.systempreferences:com.apple.Time-Machine-Settings.extension"; }
act_tm_no_vms()   { tmutil addexclusion "$HOME/Parallels"; }
act_defaults()    { mac-defaults; }
act_browser()     { defaultbrowser chrome; }
act_btt_preset()  { open -a BetterTouchTool; sleep 3; btt-sync import; }

# ---- Steps, in order: id | title | phase -------------------------------------------

STEPS="user|Running as your own user|Basics
mdm|Enrolled in SimpleMDM|MDM
filevault|FileVault on (workstations)|MDM
profiles|MDM profiles installed|MDM
hostname|Computer name is $HOSTNAME_WANT|MDM
ninja|NinjaOne agent running|MDM
escrow:filevault|FileVault key saved to 1Password|MDM
escrow:activation_lock|Activation Lock code saved to 1Password|MDM
clt|Command Line Tools current|Tools
brew|Homebrew installed|Tools
rosetta|Rosetta installed|Tools
onepassword|1Password CLI connected|Tools
op_ssh|1Password SSH agent on|Tools
op_browser:chrome|Chrome signed in to your Google profile|Tools
op_browser:connect|1Password connected to the browser|Tools
op_browser:quick_access|1Password Quick Access on Cmd+Shift+Space|Tools
chezmoi|Dotfiles applied|Dotfiles
brewfile|Brewfile packages installed|Dotfiles
gh|GitHub CLI signed in|Accounts
doppler|Doppler signed in|Accounts
icloud_docs|Desktop & Documents in iCloud|Accounts
icloud_local|iCloud keeps files downloaded (Optimize Mac Storage off)|Accounts
tailscale|Tailscale connected|Network
ts_name|Tailscale name is $(lower "$HOSTNAME_WANT")|Network
