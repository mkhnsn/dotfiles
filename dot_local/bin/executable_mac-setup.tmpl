MANUAL=" escrow remote ninja_backup_run license hueforge_plugins op_browser export vm raycast_sync raycast_local zoom widgets "   # steps confirmed by hand, remembered in $STATE_DIR

has_fn() { type "$1" >/dev/null 2>&1; }
# Print the prompt ourselves: `read -p` only shows it when input is a terminal.
ask() { printf '%s' "$1" >&2; read -r ans <&3 || ans=q; }

run_step() {
  # "base:item" ids run check_base/help_base/act_base with the item as their argument.
  local id="$1" title="$2" ans base="${1%%:*}" item=""
  case "$id" in *:*) item="${id#*:}" ;; esac
  while :; do
    if "check_$base" "$item"; then printf '  %s✓%s %s\n' "$G" "$R" "$title"; return 0; fi
    if [ "$MODE" = status ]; then printf '  %s○%s %s\n' "$Y" "$R" "$title"; return 1; fi

    printf '\n  %s→ %s%s\n' "$B" "$title" "$R"
    printf '    %s\n' "$("help_$base" "$item")"
    if has_fn "act_$base"; then
      ask "    Do it now? [Y/n/s=skip/q=quit] "
      case "$ans" in
        n|N) ;;
        s|S) printf '    %sskipped%s\n' "$D" "$R"; return 1 ;;
        q|Q) exit 1 ;;
        *) "act_$base" "$item" <&3 ;;
      esac
    fi
    case "$MANUAL" in
      *" $base "*)
        ask "    Done? [y/N/q] "
        case "$ans" in y|Y) touch "$STATE_DIR/$(state_key "$id")" ;; q|Q) exit 1 ;; *) return 1 ;; esac ;;
      *)
        ask "    Enter to re-check, s to skip, q to quit: "
        case "$ans" in s|S) printf '    %sskipped%s\n' "$D" "$R"; return 1 ;; q|Q) exit 1 ;; esac ;;
    esac
  done
}

printf '%smac-setup%s  %s (%s), %s\n' "$B" "$R" "$(scutil --get ComputerName 2>/dev/null)" "$SERIAL" "$(sw_vers -productVersion)"
printf '%sRole: %s (is_server in ~/.config/chezmoi/chezmoi.toml; change it and run chezmoi apply)%s\n' "$D" "$ROLE" "$R"
left=0 phase_prev=""
while IFS='|' read -r id title phase; do
  [ "$phase" != "$phase_prev" ] && printf '\n%s%s%s\n' "$D" "$phase" "$R" && phase_prev="$phase"
  run_step "$id" "$title" || left=$((left+1))
done <<EOF
$STEPS
EOF

echo
if [ "$left" -eq 0 ]; then
  printf '%sAll done.%s Soak for a week or two: a Ninja Backup run completes, a restore works, alerts arrive.\n' "$G" "$R"
else
  printf '%s%d step(s) left.%s Run mac-setup again any time.\n' "$Y" "$left" "$R"
  [ "$MODE" = status ] && exit 1
fi
exit 0
