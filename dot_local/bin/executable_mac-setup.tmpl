#!/bin/bash
# mac-setup — walk a new Mac through setup, checking each step.
#
# Each step has a check. Steps that pass are ticked; for the first one that fails it
# says what to do, offers to do it when it can, and re-checks before moving on.
# Safe to re-run any time: it picks up where things stand.
#
# Usage:
#   mac-setup            guided run
#   mac-setup --status   checks only, no prompts (exit 1 if anything is left)
#   mac-setup --reset    forget the steps you confirmed by hand
#
# Steps you can only confirm by hand are remembered in ~/.local/state/mac-setup.
# Runbook: unstable-studios/echo-core docs/devices/README.md (New Mac runbook).
# Bash 3.2-compatible (stock macOS).

# check_/help_/act_ functions are called by name ("check_$id").
# shellcheck disable=SC2317,SC2329  # SC2317 on older shellcheck

set -u

[ "$(uname -s)" = "Darwin" ] || { echo "mac-setup: macOS only"; exit 1; }

# MAC_SETUP_BREW overrides where to look for Homebrew (tests).
for b in ${MAC_SETUP_BREW:-/opt/homebrew/bin/brew /usr/local/bin/brew}; do
  [ -x "$b" ] && eval "$("$b" shellenv)" && break
done
export PATH="$HOME/.local/bin:$PATH"

# From chezmoi data (set on `chezmoi init`).
HOSTNAME_WANT="{{ .hostname }}"
{{- if dig "is_server" false . }}
TAG_WANT="tag:echo-core"
ROLE="server"
GH_TITLE="GitHub CLI without your personal login"
DOPPLER_TITLE="Doppler without your personal login"
{{- else }}
TAG_WANT="tag:echo-admin"
ROLE="workstation"
GH_TITLE="GitHub CLI signed in"
DOPPLER_TITLE="Doppler signed in"
{{- end }}

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mac-setup"
# Overridable for tests (tests/mac-setup.test.sh).
APPS="${MAC_SETUP_APPS:-/Applications}"
TTY="${MAC_SETUP_TTY:-/dev/tty}"
SERIAL="$(ioreg -l | awk -F'"' '/IOPlatformSerialNumber/{print $4; exit}')"
MODE=guided
case "${1:-}" in
  --status) MODE=status ;;
  --reset) rm -rf "$STATE_DIR"; echo "Forgot the steps confirmed by hand."; exit 0 ;;
  -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
  "") ;;
  *) echo "usage: mac-setup [--status|--reset]"; exit 1 ;;
esac
mkdir -p "$STATE_DIR"
if [ "$MODE" = guided ]; then
  # The braces scope 2>/dev/null to this open; a bare `exec 3<x 2>/dev/null` would
  # silence stderr (prompts, gh's login code) for the rest of the run.
  { exec 3<"$TTY"; } 2>/dev/null || { echo "mac-setup: needs a terminal for prompts; use --status"; exit 1; }
fi

if [ -t 1 ]; then G=$'\e[32m'; Y=$'\e[33m'; D=$'\e[2m'; B=$'\e[1m'; R=$'\e[0m'; else G='' Y='' D='' B='' R=''; fi

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
ts_bin() {
  command -v tailscale 2>/dev/null && return 0
  # Servers: the root-owned copy the echo-core playbook runs tailscaled from.
  [ -x /usr/local/libexec/tailscale/tailscale ] && echo /usr/local/libexec/tailscale/tailscale && return 0
  [ -x "$APPS/Tailscale.app/Contents/MacOS/Tailscale" ] && echo "$APPS/Tailscale.app/Contents/MacOS/Tailscale"
}
ts_json() { local t; t="$(ts_bin)" || return 1; [ -n "$t" ] && "$t" status --json --peers=false 2>/dev/null; }
# Per-item steps are "base:item"; their state file is the id with unsafe characters
# replaced. A file for the base alone is from when the step wasn't split, and covers all items.
state_key() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }
confirmed() { [ -f "$STATE_DIR/$(state_key "$1")" ] || [ -f "$STATE_DIR/${1%%:*}" ]; }
workstation() { [ "$ROLE" = workstation ]; }

# Apps with no Homebrew cask: app bundle | where to get it | download file name (extended
# regex, case-insensitive) that act_vendor looks for in ~/Downloads to install from.
VENDOR_APPS="OpenSCAD|https://openscad.org/downloads.html|openscad
Festivitas|https://festivitas.app|festivitas
Cursorful|https://cursorful.com|cursorful
HueForge|https://shop.thehueforge.com/apps/download|^hueforge_macos
MASSO Link|https://docs.masso.com.au/getting-started-guides/machining-with-masso/wi-fi-connectivity/masso_link|masso_link
EXStar Hub|https://www.einstar.com/pages/download-center-einstar-rockit|exstar.?hub
3DconnexionSettings|https://3dconnexion.com/drivers|3dxware|3dconnexion"
vendor_steps() { local name
  while IFS='|' read -r name _; do echo "vendor:$name|$name installed|Apps"; done <<EOF2
$VENDOR_APPS
EOF2
}
vendor_url() { printf '%s\n' "$VENDOR_APPS" | awk -F'|' -v n="$1" '$1==n{print $2}'; }
vendor_pattern() { printf '%s\n' "$VENDOR_APPS" | awk -F'|' -v n="$1" '$1==n{print $3}'; }
DOWNLOADS="${MAC_SETUP_DOWNLOADS:-$HOME/Downloads}"
# HueForge plugins you have licenses for (installed by hand inside HueForge).
HUEFORGE_PLUGINS="FlatForge, HugeForge"
# The newest finished download (.dmg, .zip or .pkg) in ~/Downloads matching the app's pattern.
vendor_download() { local p f best=""; p="$(vendor_pattern "$1")"; [ -n "$p" ] || return 1
  for f in "$DOWNLOADS"/*; do
    [ -f "$f" ] || continue
    printf '%s\n' "${f##*/}" | grep -iE '\.(dmg|zip|pkg)$' | grep -qiE -- "$p" || continue
    { [ -z "$best" ] || [ "$f" -nt "$best" ]; } && best="$f"
  done
  [ -n "$best" ] && echo "$best"; }
# Install an app from a download: copy its .app into /Applications, or run its .pkg.
# Anything else (an installer app, several apps) is opened in Finder to finish by hand.
install_download() { local f="$1" app="$2" dir tmp mnt="" found
  case "$f" in
    *.pkg|*.PKG) echo "    Installing $(basename "$f") (asks for your password)..."; sudo installer -pkg "$f" -target / ; return ;;
    *.zip|*.ZIP) tmp="$(mktemp -d)"; ditto -x -k "$f" "$tmp" || return 1; dir="$tmp" ;;
    *.dmg|*.DMG) mnt="$(mktemp -d)"; hdiutil attach -nobrowse -readonly -mountpoint "$mnt" "$f" >/dev/null || return 1; dir="$mnt" ;;
  esac
  found="$(find "$dir" -maxdepth 2 -name "$app.app" -prune 2>/dev/null | head -1)"
  if [ -n "$found" ]; then
    echo "    Copying $app.app to $APPS..."; ditto "$found" "$APPS/$app.app"
  elif found="$(find "$dir" -maxdepth 2 -name '*.pkg' 2>/dev/null | head -1)"; [ -n "$found" ]; then
    echo "    Installing $(basename "$found") (asks for your password)..."; sudo installer -pkg "$found" -target /
  else
    echo "    No $app.app in $(basename "$f"); opening it so you can finish the install."; open "$dir"; return 0
  fi
  [ -n "$mnt" ] && hdiutil detach -quiet "$mnt"
  return 0
}
# Apps to sign in to or activate: label | app to open | note.
LICENSES="Microsoft 365 (Office)|Microsoft Word|
Fantastical|Fantastical|
PDF Expert|PDF Expert|
Bartender|Bartender 7|
BetterDisplay|BetterDisplay|
BetterMouse|BetterMouse|
DaisyDisk|DaisyDisk|
Parallels|Parallels Desktop|
LightBurn|LightBurn|
Fusion|Autodesk Fusion|
Raycast|Raycast|
Slack|Slack|
Claude|Claude|"
license_field() { printf '%s\n' "$LICENSES" | awk -F'|' -v n="$1" -v f="$2" '$1==n{print $f}'; }
license_steps() { local l
  while IFS='|' read -r l _ _; do echo "license:$l|$l signed in or activated|Apps"; done <<EOF2
$LICENSES
EOF2
}
# Private app exports: label | app | where to restore | old Mac step name
EXPORTS="Stream Deck|Elgato Stream Deck|Preferences > Profiles > Restore
BetterDisplay|BetterDisplay|Settings > Application > Import
HueForge|HueForge|its configuration import (the export from the old Mac's HueForge)
Claude Code|Claude|claude-sync import (memories and prompt history; claude-sync export on the old Mac)"
export_field() { printf '%s\n' "$EXPORTS" | awk -F'|' -v n="$1" -v f="$2" '$1==n{print $f}'; }
export_steps() { local l
  while IFS='|' read -r l _ _; do echo "export:$l|$l export restored|Apps"; done <<EOF2
$EXPORTS
EOF2
}

default_browser() {
  defaults read "$HOME/Library/Preferences/com.apple.LaunchServices/com.apple.launchservices.secure" LSHandlers 2>/dev/null |
    awk 'BEGIN{RS="}"} /LSHandlerURLScheme = http;/ { if (match($0,/LSHandlerRoleAll = "[^"]*"/)) print substr($0,RSTART+20,RLENGTH-21) }'
}

# ---- Checks: each returns 0 when the step is done ----------------------------------

check_user()       { [ "$(id -u)" -ne 0 ] && [ -n "${HOME:-}" ]; }
check_mdm()        { profiles status -type enrollment 2>/dev/null | grep -q "MDM enrollment: Yes"; }
# Servers run without FileVault so they recover from restarts unattended (echo-core two-machine plan).
check_filevault()  { workstation || return 0; fdesetup status 2>/dev/null | grep -q "FileVault is On"; }
PROFILES_WANT="macOS: Firewall|macOS: NinjaOne privacy permissions|macOS: Terminal privacy permissions"
profiles_missing() { local p n; p="$(system_profiler SPConfigurationProfileDataType 2>/dev/null)"
                     printf '%s\n' "$PROFILES_WANT" | tr '|' '\n' | while read -r n; do printf '%s' "$p" | grep -qF "$n" || echo "$n"; done; }
check_profiles()   { [ -z "$(profiles_missing)" ]; }
# SimpleMDM's rename sets the computer name and, from it, the local hostname ("MikeBook Pro"
# -> "MikeBook-Pro"); chezmoi's hostname data is the local-hostname form.
check_hostname()   { [ "$(scutil --get LocalHostName 2>/dev/null)" = "$(printf '%s' "$HOSTNAME_WANT" | tr ' ' '-')" ]; }
check_ninja()      { pgrep -f NinjaRMMAgent/programfiles/ninjarmm-macagent >/dev/null; }
check_escrow()     { workstation || return 0; confirmed "escrow:$1"; }
# Ninja Backup installs lockhart only once backup is deployed to the device in Ninja.
LOCKHART="/Applications/NinjaRMMAgent/programfiles/lockhart/bin/lockhart"
check_ninja_backup(){ workstation || return 0; [ -x "${MAC_SETUP_LOCKHART:-$LOCKHART}" ]; }
check_ninja_backup_run(){ workstation || return 0; check_ninja_backup && confirmed ninja_backup_run; }
# Ask Homebrew's own doctor checks, which are what make it refuse stale tools.
check_clt()        { xcode-select -p >/dev/null 2>&1 || return 1
                     command -v brew >/dev/null 2>&1 || return 0
                     brew doctor check_for_installed_developer_tools check_if_supported_sdk_available >/dev/null 2>&1; }
check_brew()       { command -v brew >/dev/null 2>&1; }
check_rosetta()    { [ "$(uname -m)" != arm64 ] || arch -x86_64 /usr/bin/true 2>/dev/null; }
check_onepassword(){ command -v op >/dev/null 2>&1 && op account list 2>/dev/null | grep -q .; }
OP_AGENT="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
check_op_ssh()     { workstation || return 0; [ -e "$OP_AGENT" ]; }
# Claude Code <-> Home Assistant: session hooks post to a webhook (URL from 1Password), and the
# homeassistant MCP server (~/.local/bin/ha-mcp, read-only) is registered for every project.
CLAUDE_HA_URL_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/claude-ha/webhook-url"
CLAUDE_HA_REF="op://Infrastructure/HA webhook - Claude sessions/credential"
check_claude_ha()  { workstation || return 0; [ -s "$CLAUDE_HA_URL_FILE" ]; }
check_ha_mcp()     { workstation || return 0; grep -q '"homeassistant"' "$HOME/.claude.json" 2>/dev/null &&
                       security find-generic-password -s ha-mcp -a echo-homeassistant >/dev/null 2>&1; }
check_op_browser() { workstation || return 0; confirmed "op_browser:$1"; }
# After a dotfiles update changes .chezmoi.toml.tmpl, chezmoi warns until `chezmoi init` runs.
chezmoi_config_stale() { chezmoi verify --exclude=scripts,templates 2>&1 | grep -q "config file template has changed"; }
check_chezmoi()    { local s; s="$(chezmoi source-path 2>/dev/null)" && [ -d "$s/.git" ] && ! chezmoi_config_stale &&
                     chezmoi verify --exclude=scripts,templates >/dev/null 2>&1; }
check_brewfile()   { brew bundle check --no-upgrade --file "$(chezmoi source-path)/Brewfile" >/dev/null 2>&1; }
# Servers don't carry your personal logins (the Mac has no FileVault): no GitHub login, or a
# fine-grained token scoped to what runs there. `gh auth status` masks the token but keeps its
# prefix: gho_ is a web login, ghp_ a classic token, github_pat_ a fine-grained one.
gh_personal()      { gh auth status 2>&1 | grep -Eq 'Token: gh[op]_'; }
check_gh()         { if workstation; then gh auth status >/dev/null 2>&1; else ! gh_personal; fi; }
# With Desktop & Documents in iCloud on, iCloud Drive's Desktop and Documents are links to the
# home folders; off, they're plain folders (or missing) and the home folders stay local.
ICLOUD_DRIVE="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
check_icloud_docs(){ workstation || return 0; local d
                     for d in Desktop Documents; do [ "$(readlink "$ICLOUD_DRIVE/$d" 2>/dev/null)" = "$HOME/$d" ] || return 1; done; }
check_icloud_local(){ workstation || return 0; [ "$(defaults read com.apple.bird optimize-storage 2>/dev/null)" != 1 ]; }
# Servers: no personal Doppler login or personal token; only service tokens/accounts. Scope "/"
# both here and in act_doppler, so the check and the sign-out see the same token.
doppler_personal() { local t; t="$(doppler me --json --scope / 2>/dev/null | sed -n 's/.*"type": *"\([^"]*\)".*/\1/p' | head -1)"
                     case "$t" in ""|service_token|service_account) return 1 ;; *) return 0 ;; esac; }
check_doppler()    { if workstation; then doppler me >/dev/null 2>&1; else ! doppler_personal; fi; }
check_tailscale()  { ts_json | grep -Eq '"BackendState": *"Running"'; }
# Servers run the open-source tailscaled from the echo-core playbook (decision 0006); the app
# only connects after someone signs in, and the two variants can't run side by side.
check_ts_app()     { workstation || [ ! -d "$APPS/Tailscale.app" ]; }
# The console machine name is the first label of DNSName (HostName is the OS hostname).
check_ts_name()    { [ "$(ts_json | sed -n 's/.*"DNSName": *"\([^."]*\)\..*/\1/p' | head -1)" = "$(lower "$HOSTNAME_WANT")" ]; }
check_ts_tag()     { ts_json | grep -q "\"$TAG_WANT\""; }
# Remote Login (macOS sshd), limited to you through the com.apple.access_ssh group.
# Tailscale SSH isn't used: the app build on workstations can't run its SSH server, and
# servers (tailscaled) keep Remote Login until Tailscale SSH has been tried there.
ssh_listening()    { nc -z -G 2 127.0.0.1 22 >/dev/null 2>&1; }
check_ssh_server() { ssh_listening && dscl . -read /Groups/com.apple.access_ssh >/dev/null 2>&1 &&
                     dsmemberutil checkmembership -U "$(id -un)" -G com.apple.access_ssh 2>/dev/null | grep -q "is a member"; }
# A copy in ~/Applications (the installer's per-user choice) counts as not installed: other
# accounts can't use it. The action moves it to /Applications.
btt_user_copy()    { [ -d "$HOME/Applications/BetterTouchTool.app" ] && [ ! -d "$APPS/BetterTouchTool.app" ] &&
                     [ ! -d "$(brew --prefix 2>/dev/null)/Caskroom/bettertouchtool" ]; }
check_btt()        { workstation || return 0; [ -d "$APPS/BetterTouchTool.app" ] && [ ! -d "$(brew --prefix 2>/dev/null)/Caskroom/bettertouchtool" ]; }
# BTT's master "Enable window snapping" switch isn't part of presets; it's stored only when off.
check_btt_snapping(){ workstation || return 0; [ "$(defaults read com.hegenberg.BetterTouchTool windowSnappingEnabled 2>/dev/null)" != 0 ]; }
# The preset's global keyboard shortcuts (keys and modifiers) and move/resize modifier keys that
# BTT doesn't match: none imported yet, or an import from before the preset changed. Prints how
# many are missing.
btt_missing()      { osascript -e 'tell application "BetterTouchTool" to get_triggers' 2>/dev/null |
                     "${MAC_SETUP_PYTHON:-/usr/bin/python3}" -c '
import json, sys
keys = lambda ts: {(t.get("BTTShortcutKeyCode"), t.get("BTTShortcutModifierKeys")) for t in ts
                   if t.get("BTTTriggerClass") == "BTTTriggerTypeKeyboardShortcut"}
preset = json.load(open(sys.argv[1]))
want = keys(t for a in preset.get("BTTPresetContent", []) if a.get("BTTAppBundleIdentifier") == "BT.G"
            for t in a.get("BTTTriggers", []))
try: have = keys(json.load(sys.stdin))
except ValueError: have = set()
import subprocess
def flag(k):
    r = subprocess.run(["defaults", "read", "com.hegenberg.BetterTouchTool", k], capture_output=True, text=True)
    return r.stdout.strip() == "1"
g = preset.get("BTTGeneralSettings", {})
mods = {m + j: g.get(m + j) in (True, 1) for m in ("control", "opt", "shift", "cmd") for j in ("Move", "Resize")}
print(len(want - have) + sum(flag(k) != v for k, v in mods.items()))' "$(chezmoi source-path)/macos/btt/Default.bttpreset" 2>/dev/null || echo 1; }
check_btt_preset() { workstation || return 0; pgrep -x BetterTouchTool >/dev/null && [ "$(btt_missing)" = 0 ]; }
check_btt_mcp()    { workstation || return 0; nc -z -G 2 127.0.0.1 64832 >/dev/null 2>&1; }
check_raycast_sync(){ workstation || return 0; confirmed raycast_sync; }
check_raycast_local(){ workstation || return 0; confirmed raycast_local; }
check_zoom()       { workstation || return 0; confirmed zoom; }
# Raycast's Generate TAP runs echo-m365's New-Tap.ps1, which needs that repo's saved Graph
# sign-in (~/.mg/mg.authrecord.<TenantId>.json) to be its AdminAccount. Both come from the
# repo's tenant.psd1; the record holds the account name, not a token.
# Same lookup as generate-tap: find-repo, then the ghq path.
ECHO_M365="${MAC_SETUP_ECHO_M365:-$(find-repo echo-m365 2>/dev/null | sed -n 's/.*→ //p' | head -1)}"
ECHO_M365="${ECHO_M365:-${GHQ_ROOT:-$HOME/src}/github.com/unstable-studios/echo-m365}"
m365_setting()     { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*['\"]\([^'\"]*\)['\"].*/\1/p" "$ECHO_M365/tenant.psd1" 2>/dev/null | head -1; }
check_m365_admin() { workstation || return 0; local tid admin
                     tid="$(m365_setting TenantId)" admin="$(m365_setting AdminAccount)"
                     [ -n "$tid" ] && [ -n "$admin" ] &&
                       tr -d ' \t\n' < "$HOME/.mg/mg.authrecord.$tid.json" 2>/dev/null | grep -qiF "\"username\":\"$admin\""; }
check_widgets()    { workstation || return 0; confirmed widgets; }
check_remote()     { confirmed remote; }
# Casks whose app is already installed in a way Homebrew can't take over (see brew-why).
ws_skip()          { command -v brew-why >/dev/null 2>&1 && brew-why --skip --brewfile "$(chezmoi source-path)/Brewfile.workstation" 2>/dev/null; }
check_ws_apps()    { workstation || return 0
                     HOMEBREW_BUNDLE_CASK_SKIP="$(ws_skip)" brew bundle check --no-upgrade --file "$(chezmoi source-path)/Brewfile.workstation" >/dev/null 2>&1; }
check_vendor()     { workstation || return 0; [ -d "$APPS/$1.app" ]; }
# Apps replaced by another: Rectangle (window management is BTT), Bartender 6 (Bartender 7 shares
# its settings file), Docker Desktop (Colima + the docker CLI).
REPLACED_APPS="Rectangle|Bartender 6|Docker"
replaced_present() { local IFS='|' a; for a in $REPLACED_APPS; do [ -d "$APPS/$a.app" ] && echo "$a"; done; }
# Their casks too: dragging the app to the Trash leaves Homebrew's record and its links (a
# dangling zsh completion breaks compinit).
REPLACED_CASKS="rectangle docker-desktop docker"  # docker: docker-desktop's old name
replaced_casks()   { local c room; room="$(brew --prefix 2>/dev/null)/Caskroom"; for c in $REPLACED_CASKS; do [ -d "$room/$c" ] && echo "$c"; done; }
check_replaced()   { workstation || return 0; [ -z "$(replaced_present)" ] && [ -z "$(replaced_casks)" ]; }
# "Runs at login" is Homebrew's launch agent for colima; colima status alone also passes for a
# one-off `colima start`, and fails for a minute or two while the first start builds the VM.
colima_at_login()  { brew services info colima --json 2>/dev/null | grep -Eq '"registered": *true'; }
check_containers() { workstation || return 0; colima_at_login && colima status >/dev/null 2>&1; }
check_ollama()     { workstation || return 0; ollama list >/dev/null 2>&1; }
check_gridfinity() { workstation || return 0; [ -d "$APPS/gridfinity-studio.app" ]; }
# Confirmations saved before the US spelling ("licence:<app>", "licences") still count.
check_hueforge_plugins() { workstation || return 0; confirmed hueforge_plugins; }
check_license()    { workstation || return 0; confirmed "license:$1" || confirmed "licence:$1" || confirmed licences; }
check_app_prefs()  { workstation || return 0; app-prefs check >/dev/null 2>&1; }
check_spacemouse() { workstation || return 0; 3dx-sync check >/dev/null 2>&1; }
EXPORTS_DIR="${MAC_SETUP_ONEDRIVE:-$HOME/Library/CloudStorage/OneDrive-UnstableStudios}/Apps/Mac app exports"
check_onedrive()   { workstation || return 0; [ -d "${MAC_SETUP_ONEDRIVE:-$HOME/Library/CloudStorage/OneDrive-UnstableStudios}" ]; }
# Each Mac schedules its own exports (the schedule doesn't sync) into its own folder, so one Mac's
# backups don't count for another and auto-delete doesn't prune another Mac's files.
RAYCAST_EXPORTS="$EXPORTS_DIR/Raycast/$HOSTNAME_WANT"
check_raycast_backup(){ workstation || return 0; [ -n "$(find "$RAYCAST_EXPORTS" -name '*.rayconfig' -mtime -8 2>/dev/null | head -1)" ]; }
# Claude Code counts as restored once any project memory is here (or you confirmed there was none).
check_export()     { workstation || return 0; confirmed "export:$1" && return 0
                     case "$1" in
                       "Claude Code") [ -n "$(find "$HOME/.claude/projects" -path '*/memory/*.md' 2>/dev/null | head -1)" ] ;;
                       *) confirmed app_exports ;;
                     esac; }
check_vm()         { workstation || return 0; confirmed vm; }
# Homebrew's cask is Stream Deck 7.x; its MCP server (Claude Code's StreamDeck) needs 8, a beta
# installed over it from elgato.com. Same signal as the apply summary: the MCP helper exists.
# The major version (from the app's Info.plist, XML) is only for the help text.
streamdeck_major() { sed -n '/CFBundleShortVersionString/{n;s/.*<string>\([0-9]*\).*/\1/p;}' "$APPS/Elgato Stream Deck.app/Contents/Info.plist" 2>/dev/null; }
check_streamdeck() { workstation || return 0; [ -x "$APPS/Elgato Stream Deck.app/Contents/Helpers/streamdeck-mcp" ]; }
# Dock and Finder for daily use; dockutil comes from Brewfile.workstation, which servers skip.
check_defaults()   { workstation || return 0; mac-defaults --check >/dev/null 2>&1; }
# Time Machine to echo-nas: the fast local restore (Ninja Backup is the off-site copy).
# destinationinfo works without Full Disk Access; latestbackup doesn't.
# A destination alone isn't enough: tmutil setdestination leaves automatic backups off. The
# setting needs Full Disk Access to read; when it can't be read, the destination check stands.
TM_PREFS="${MAC_SETUP_TM_PREFS:-/Library/Preferences/com.apple.TimeMachine}"
check_timemachine(){ workstation || return 0; tmutil destinationinfo 2>/dev/null | grep -q '^Name' || return 1
                     local auto; auto="$(defaults read "$TM_PREFS" AutoBackup 2>/dev/null)"
                     [ "$auto" != 0 ]; }
# VM disks change constantly, so every hourly backup would re-copy them. The valuable data
# (VCarve) has its own copy (~/VCarve/Backup); the VM rebuilds from Intune. A sticky
# exclusion on the folder covers VMs added later.
check_tm_no_vms()  { workstation || return 0; [ ! -d "$HOME/Parallels" ] || tmutil isexcluded "$HOME/Parallels" 2>/dev/null | grep -q '^\[Excluded\]'; }
check_browser()    { workstation || return 0; [ "$(default_browser)" = com.google.chrome ]; }

# ---- Help: what to do when a check fails ------------------------------------------

help_user()       { echo "Run this in Terminal as yourself, not as root or from Ninja's terminal (it's root)."; }
help_mdm()        { echo "Not enrolled. Erase the Mac and set it up again so ADE enrolls it (check the serial is assigned to SimpleMDM - macOS in ABM)."; }
help_filevault()  { echo "Turn on FileVault: System Settings > Privacy & Security > FileVault. The MDM profile escrows the key."; }
