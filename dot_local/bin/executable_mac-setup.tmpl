# ---- Actions: what this script can do itself (optional) --------------------------

act_clt() {
  if [ -d /Library/Developer/CommandLineTools ]; then
    echo "Removing the old Command Line Tools (asks for your password)…"
    sudo rm -rf /Library/Developer/CommandLineTools
  fi
  xcode-select --install
  echo "Click Install in the window that opened, and wait for it to finish."
}
act_brew()        { /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" && eval "$(/opt/homebrew/bin/brew shellenv)"; }
act_rosetta()      { sudo softwareupdate --install-rosetta --agree-to-license; }
act_onepassword() { command -v op >/dev/null 2>&1 || brew install --cask 1password 1password-cli; open -a 1Password; }
act_op_ssh()       { open -a 1Password; }
act_claude_ha()    {
  local id; id="$(op read "$CLAUDE_HA_REF")" || return 1
  mkdir -p "$(dirname "$CLAUDE_HA_URL_FILE")"
  (umask 077; printf 'http://echo-homeassistant:8123/api/webhook/%s\n' "$id" > "$CLAUDE_HA_URL_FILE")
}
act_ha_mcp()       {
  command -v claude >/dev/null 2>&1 || brew install --cask claude-code || return 1
  "$HOME/.local/bin/ha-mcp" --store-token || return 1
  # Actions get the terminal (/dev/tty) as stdin; claude (Bun) can't watch /dev/tty on macOS
  # and dies with "EINVAL: invalid argument, kqueue". It needs no input here.
  grep -q '"homeassistant"' "$HOME/.claude.json" 2>/dev/null ||
    claude mcp add --scope user homeassistant -- "$HOME/.local/bin/ha-mcp" </dev/null
}
act_op_browser()   { case "$1" in chrome) open -a "Google Chrome" ;; autofill) open -b com.apple.systempreferences ;; *) open -a 1Password ;; esac; }
act_license()      { open -a "$(license_field "$1" 2)" 2>/dev/null || echo "    $1 isn't installed yet."; }
act_onedrive()     { open -a OneDrive; }
act_export()       { [ "$1" = "Claude Code" ] && { claude-sync import; return; }
                     open "$EXPORTS_DIR" 2>/dev/null; open -a "$(export_field "$1" 2)" 2>/dev/null; }
act_chezmoi() {
  if chezmoi_config_stale; then chezmoi init; return; fi
  if [ -d "$(chezmoi source-path 2>/dev/null)/.git" ]; then chezmoi update
  else bash -c "$(curl -fsSL https://raw.githubusercontent.com/mkhnsn/dotfiles/main/install.sh)"; fi
}
act_ssh_server() {
  local me; me="$(id -un)"
  echo "Turning on Remote Login for $me (asks for your password)…"
  # launchctl, not systemsetup: systemsetup needs Full Disk Access for the terminal.
  sudo launchctl enable system/com.openssh.sshd
  sudo launchctl bootstrap system /System/Library/LaunchDaemons/ssh.plist 2>/dev/null || true
  dscl . -read /Groups/com.apple.access_ssh >/dev/null 2>&1 ||
    sudo dseditgroup -o create -r "SSH Service ACL" com.apple.access_ssh
  sudo dseditgroup -o edit -a "$me" -t user com.apple.access_ssh
}
act_brewfile()    { chezmoi apply; }
act_gh()          { if workstation; then gh auth login --web --git-protocol https
                    elif [ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]; then echo "    Unset GH_TOKEN/GITHUB_TOKEN first (see above)."
                    else gh auth logout --hostname github.com; fi; }
act_doppler()     { if workstation; then doppler login; else doppler logout --yes --scope /; fi; }
{{- if not (dig "is_server" false .) }}
act_tailscale()   { [ -d "$APPS/Tailscale.app" ] || brew install --cask tailscale-app; open -a Tailscale; }
{{- end }}
act_ts_app()      { if brew list --cask tailscale-app >/dev/null 2>&1; then brew uninstall --cask tailscale-app
                    else echo "    Not from Homebrew: quit Tailscale, move it from /Applications to the Trash and approve removing its system extension."; return 0; fi &&
                    echo "    Restart now, then run the echo-core playbook from your Mac."; }
act_streamdeck()  { open "https://www.elgato.com/downloads"; }
act_btt() {
  if btt_user_copy; then
    osascript -e 'quit app "BetterTouchTool"' 2>/dev/null; pkill -f BTTRelaunch 2>/dev/null; sleep 2
    # Reopen the old copy if the move fails (a standard user can't write to /Applications).
    mv "$HOME/Applications/BetterTouchTool.app" "$APPS/" || { open "$HOME/Applications/BetterTouchTool.app"; return 1; }
    open "$APPS/BetterTouchTool.app"
  else
    open "https://folivora.ai"
  fi
}
act_ws_apps()     { HOMEBREW_CASK_OPTS="--adopt" HOMEBREW_BUNDLE_CASK_SKIP="$(ws_skip)" brew bundle --file "$(chezmoi source-path)/Brewfile.workstation"; }
act_vendor()      { local f; f="$(vendor_download "$1")"
                    if [ -z "$f" ]; then
                      open "$(vendor_url "$1")"
                      echo "    Waiting for the download in $DOWNLOADS (Enter to stop waiting)..."
                      while [ -z "$f" ]; do read -r -t 3 _; [ $? -le 128 ] && return 0; f="$(vendor_download "$1")"; done
                    fi
                    install_download "$f" "$1"; }
act_hueforge_plugins() { local z; for z in "$DOWNLOADS"/*Plugin_MacOS*.zip; do [ -f "$z" ] && open -a HueForge "$z"; done
                    echo "    If HueForge didn't offer to install them, use Plugins > Install Plugin."; }
act_containers()   {
  colima_at_login || brew services start colima || return 1
  # Docker Desktop set these up; with Homebrew's docker they come from here.
  /usr/bin/python3 - "$(brew --prefix)/lib/docker/cli-plugins" <<'PYEOF'
import json, os, sys
p = os.path.expanduser("~/.docker/config.json"); os.makedirs(os.path.dirname(p), exist_ok=True)
c = json.load(open(p)) if os.path.exists(p) else {}
dirs = c.setdefault("cliPluginsExtraDirs", [])
if sys.argv[1] not in dirs: dirs.append(sys.argv[1])
c["currentContext"] = "colima"; c["credsStore"] = "osxkeychain"
json.dump(c, open(p, "w"), indent=2)
PYEOF
  local i=0
  printf '    Waiting for Colima to start'
  while ! colima status >/dev/null 2>&1 && [ "$i" -lt "${MAC_SETUP_COLIMA_WAIT:-180}" ]; do printf .; sleep 5; i=$((i+5)); done
  echo
}
act_ollama()       { brew services start ollama; }
act_gridfinity() {
  local tmp; tmp="$(mktemp -d)"
  gh release download -R unstable-studios/gridfinity-studio --pattern '*arm64-mac.zip' -D "$tmp" &&
    ditto -x -k "$tmp"/*arm64-mac.zip "$APPS" && echo "Installed gridfinity-studio"
  rm -rf "$tmp"
}
act_app_prefs()    { app-prefs apply --restart; }
act_spacemouse()   { 3dx-sync import; }
# echo-nas login in 1Password, by item ID (whichever signed-in account holds it).
NAS_ITEM="2qikhkiio3v4omtmac72nbe64y"
nas_field() {  # nas_field <field>: the field from the first account that has the item
  local a v
  for a in $(op account list --format json 2>/dev/null | sed -n 's/.*"user_uuid": *"\([^"]*\)".*/\1/p'); do
    v="$(op item get "$NAS_ITEM" --account "$a" --fields "label=$1" --reveal 2>/dev/null)" && [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  done
  return 1
}
act_timemachine() {
  local user
  # Destination already there (added by hand, or an earlier run): only automatic backups are off.
  if tmutil destinationinfo 2>/dev/null | grep -q '^Name'; then
    echo "    Turning on automatic backups (asks for your Mac password)…"
    sudo tmutil enable && echo "    Automatic backups on."
    return
  fi
  user="$(nas_field username)" || { echo "    Couldn't read the NAS login from 1Password (item $NAS_ITEM). Unlock 1Password and try again."; return 1; }
  # tmutil -p reads the password from the keyboard only. The clipboard keeps it out of the
  # process list and out of sudo's log, which records the whole command line.
  nas_field password | pbcopy
  ( sleep "${MAC_SETUP_CLIP_SECONDS:-45}"; pbcopy </dev/null ) &
  echo "    NAS password is on the clipboard for 45 seconds: paste it at the NAS password prompt."
  sudo tmutil setdestination -a -p "smb://$user@echo-nas/backups" && sudo tmutil enable &&
    tmutil startbackup && echo "    Automatic backups on; first backup started."
}
act_tm_no_vms()   { tmutil addexclusion "$HOME/Parallels"; }
act_defaults()    { mac-defaults; }
act_browser()     { defaultbrowser chrome; }
act_btt_preset()  { open -a BetterTouchTool; sleep 3; btt-sync import; }
act_btt_mcp()     { open -a BetterTouchTool; }
act_raycast_sync(){ open -a Raycast; }
act_raycast_backup(){ check_onedrive || { echo "    Sign in to OneDrive first."; return 1; }
                     mkdir -p "$RAYCAST_EXPORTS"; open -a Raycast; }
act_raycast_local(){ open -a Raycast; }
act_zoom()        { open -a zoom.us; }
act_m365_admin()  { [ -f "$ECHO_M365/tenant.psd1" ] || return 1
                    ( cd "$ECHO_M365" && pwsh -NoProfile -File scripts/Connect-Tenant.ps1 -Disconnect &&
                      pwsh -NoProfile -File scripts/Connect-Tenant.ps1 ); }
act_widgets()     { open "x-apple.systempreferences:com.apple.Desktop-Settings.extension"; }

