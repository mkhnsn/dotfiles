#!/usr/bin/env bash
set -euo pipefail

log() { printf '[finish-install] %s\n' "$*"; }

LIST="$HOME/.config/vscode/extensions.minimal.txt"
[[ -n "${DOTFILES_FULL:-}" ]] && LIST="$HOME/.config/vscode/extensions.full.txt"

STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/vscode-extensions.installed"
mkdir -p "$(dirname "$STAMP")"

if [[ -f "$STAMP" ]]; then
  log "VS Code extensions already installed (remove $STAMP to re-run)"
  exit 0
fi

if ! command -v code >/dev/null 2>&1; then
  log "VS Code CLI ('code') not found in PATH yet."
  log "Open VS Code once (Remote) and try again."
  exit 0
fi

log "Installing VS Code extensions from: $LIST"
while IFS= read -r ext; do
  [[ -z "$ext" || "$ext" =~ ^# ]] && continue
  log "  - $ext"
  code --install-extension "$ext" >/dev/null 2>&1 || log "    (failed; continuing)"
done < "$LIST"

touch "$STAMP"
log "finish-install complete."