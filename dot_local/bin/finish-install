#!/usr/bin/env bash
set -euo pipefail

# finish-install
# Non-interactive helper that can be run *after* a Codespace/Remote session is fully up.
#
# Responsibilities:
# - Install VS Code extensions from a list (minimal or full)
#
# Safe defaults:
# - Never prompts
# - Bails cleanly if VS Code CLI is not ready yet
# - Uses stamp files so it can be re-run safely

log() { printf '[finish-install] %s\n' "$*"; }
warn() { printf '[finish-install] WARN: %s\n' "$*"; }

usage() {
  cat <<'USAGE'
finish-install [--force] [--force-extensions] [--dry-run]

Defaults:
  - Install VS Code extensions from:
      ~/.config/vscode/extensions.minimal.txt
      ~/.config/vscode/extensions.full.txt (when DOTFILES_FULL is set)

Flags:
  --force            Same as --force-extensions
  --force-extensions Force extension install
  --dry-run          Print what would happen without changing anything
USAGE
}

FORCE_EXT=0
DRY_RUN=0

for arg in "${@:-}"; do
  case "$arg" in
    --force) FORCE_EXT=1 ;;
    --force-extensions) FORCE_EXT=1 ;;
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) warn "Unknown arg: $arg"; usage; exit 2 ;;
  esac
done

LIST="$HOME/.config/vscode/extensions.minimal.txt"
[[ -n "${DOTFILES_FULL:-}" ]] && LIST="$HOME/.config/vscode/extensions.full.txt"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
EXT_STAMP="$STATE_DIR/vscode-extensions.installed"
mkdir -p "$STATE_DIR"

# --- install extensions (safe to re-run; but stamped) ---
install_extensions() {
  if [[ -f "$EXT_STAMP" && "$FORCE_EXT" -eq 0 ]]; then
    log "VS Code extensions already installed (remove $EXT_STAMP or use --force-extensions to re-run)"
    return 0
  fi

  if [[ ! -f "$LIST" ]]; then
    warn "Extension list not found: $LIST (skipping)"
    return 0
  fi

  if ! command -v code >/dev/null 2>&1; then
    log "VS Code CLI ('code') not found in PATH yet."
    log "Open VS Code once (Remote) and try again."
    return 0
  fi

  log "Installing VS Code extensions from: $LIST"

  local ok=0
  while IFS= read -r ext; do
    [[ -z "$ext" || "$ext" =~ ^# ]] && continue
    log "  - $ext"

    if [[ "$DRY_RUN" -eq 1 ]]; then
      continue
    fi

    if code --install-extension "$ext" >/dev/null 2>&1; then
      ok=1
    else
      warn "failed to install: $ext (continuing)"
    fi
  done < "$LIST"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "(dry-run) not stamping"
    return 0
  fi

  if [[ "$ok" -eq 1 ]]; then
    touch "$EXT_STAMP"
    log "Extensions installed (stamped: $EXT_STAMP)"
  else
    warn "No extensions installed successfully; not stamping. Re-run later."
  fi
}

# --- run ---
install_extensions

log "finish-install complete."