#!/usr/bin/env python3
"""mode: switch work modes (macos/modes.toml); Hyper+1–5 run `mode <name>`, Hyper+0 `mode next`.

Docked (an external display), a mode lives on a desktop of its own. Switching goes to
the mode's desktop; a mode without one (never opened, or its desktop closed since) takes the
desktop you're on, unless another mode has it: then add a desktop in Mission Control and switch
there. It opens the mode's apps on that desktop and lays them out in the mode's columns on the
main display. Apps that can have a window on each desktop (Chrome, VS Code) get a new window
there; others are moved there. Nothing depends on a set number of desktops. (Scripts can't add a
desktop reliably: BTT's Add New Space does nothing on current macOS, and Mission Control's + only
appears on hover.)

Anywhere else (travel: the laptop screen, maybe a portable display), each of the mode's apps goes
full screen, which gives each its own space.

  mode <name>    switch to that mode
  mode next      the next mode in macos/modes.toml
  mode apply     lay the current mode out again, if its desktop is the one in front (BTT runs this
                 after a display change, once the setup settles)
  mode get       the current mode
  mode list      the modes and their keys

BTT does the window work (go to a desktop by ID, move a window to a desktop, place it in a grid
cell, enter full screen). SkyLight, the window server framework yabai and Hammerspoon read, gives
the live desktop list. State: ~/.local/state/mode.json. Python 3.11+ standard library only.
"""
import ctypes, ctypes.util, fcntl, importlib.machinery, importlib.util, json, os, plistlib, subprocess, sys, tempfile, time
import urllib.request

try:
    import tomllib
except ModuleNotFoundError:
    # BTT runs scripts with a bare PATH, which finds macOS's Python 3.9 (no tomllib).
    if not os.environ.get("MODE_REEXEC"):
        os.environ["MODE_REEXEC"] = "1"
        for py in ("/opt/homebrew/bin/python3", "/usr/local/bin/python3"):
            if os.path.exists(py) and os.path.realpath(py) != os.path.realpath(sys.executable):
                os.execv(py, [py, *sys.argv])
    sys.exit("mode: needs Python 3.11 or later (brew install python)")

STATE_DIR = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
STATE = os.path.join(STATE_DIR, "mode.json")
LOCK = os.path.join(STATE_DIR, "mode.lock")
MIN_WIDTH = 2560  # a docked main display narrower than this is the KVM's placeholder: leave it
HA_URL = os.environ.get("HOMEASSISTANT_URL", "http://echo-homeassistant:8123")


# ---- config and state ---------------------------------------------------------------------------
def source_dir():
    d = os.environ.get("CHEZMOI_SOURCE_DIR") or os.path.expanduser("~/.local/share/chezmoi")
    if os.path.isdir(d):
        return d
    return subprocess.run(["chezmoi", "source-path"], capture_output=True, text=True).stdout.strip()


def load_config(src=None):
    with open(os.path.join(src or source_dir(), "macos/modes.toml"), "rb") as f:
        return tomllib.load(f)


def validate(cfg):
    """Problems in modes.toml, as strings."""
    problems, apps, names, keys = [], cfg.get("apps", {}), set(), set()
    for aid, a in apps.items():
        if not isinstance(a.get("name"), str) or not a["name"]:
            problems.append(f"apps.{aid}: needs name")
        if "new_window" in a and not (isinstance(a["new_window"], list) and all(isinstance(x, str) for x in a["new_window"])):
            problems.append(f"apps.{aid}: new_window must be a command, like [\"open\", \"-na\", \"App\"]")
    for m in cfg.get("mode", []):
        n = m.get("name", "?")
        if n in names:
            problems.append(f"mode {n}: name used twice")
        names.add(n)
        if not isinstance(m.get("title"), str):
            problems.append(f"mode {n}: needs title")
        if m.get("key") in keys:
            problems.append(f"mode {n}: key {m.get('key')} used twice")
        keys.add(m.get("key"))
        if "scene" in m and not (isinstance(m["scene"], str) and m["scene"].startswith("scene.")):
            problems.append(f"mode {n}: scene must be a Home Assistant scene, like \"scene.meeting_lights\"")
        layout = m.get("layout")
        if not isinstance(layout, list) or not layout:
            problems.append(f"mode {n}: needs a layout")
            continue
        for entry in layout:
            if not (isinstance(entry, list) and len(entry) == 2):
                problems.append(f"mode {n}: layout entries are [app, cell]")
                continue
            if entry[0] not in apps:
                problems.append(f"mode {n}: no app {entry[0]!r} in [apps]")
            if parse_cell(entry[1]) is None:
                problems.append(f"mode {n}: can't read cell {entry[1]!r} (like \"1-2/3\")")
    return problems


def parse_cell(cell):
    """'1-2/3' -> (first column, span, columns); None if it isn't one."""
    try:
        cols, of = cell.split("/")
        first, _, last = cols.partition("-")
        first, last, of = int(first), int(last or first), int(of)
    except (AttributeError, ValueError):
        return None
    return (first, last - first + 1, of) if 1 <= first <= last <= of else None


def load_state():
    try:
        with open(STATE) as f:
            s = json.load(f)
    except (OSError, ValueError):
        s = {}
    if not isinstance(s, dict):
        s = {}
    if not isinstance(s.get("spaces"), dict):
        s["spaces"] = {}
    return s


def save_state(s):
    fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=".mode.")
    with os.fdopen(fd, "w") as f:
        json.dump(s, f, indent=2, sort_keys=True)
        f.write("\n")
    os.replace(tmp, STATE)


# ---- the Mac --------------------------------------------------------------------------------------
def hints_module():
    """hints, next to this script: its setup detection."""
    here = os.path.dirname(os.path.realpath(__file__))
    for name in ("hints", "executable_hints"):
        path = os.path.join(here, name)
        if os.path.exists(path):
            loader = importlib.machinery.SourceFileLoader("hints_mod", path)
            mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("hints_mod", loader))
            loader.exec_module(mod)
            return mod
    return None


def detect_setup():
    if os.environ.get("MODE_SETUP"):
        return os.environ["MODE_SETUP"]
    h = hints_module()
    return h.detect_setup() if h else None


def main_display_width():
    if os.environ.get("MODE_MAIN_WIDTH"):
        return int(os.environ["MODE_MAIN_WIDTH"])
    try:
        cg = ctypes.CDLL(ctypes.util.find_library("CoreGraphics"))
        cg.CGMainDisplayID.restype = ctypes.c_uint32
        cg.CGDisplayPixelsWide.restype = ctypes.c_size_t
        return int(cg.CGDisplayPixelsWide(cg.CGMainDisplayID()))
    except (OSError, TypeError, AttributeError):
        return 0


def managed_spaces():
    """The live desktop list per display, from SkyLight (the window server; com.apple.spaces on disk
    lags behind). Falls back to com.apple.spaces. MODE_SPACES (a plist path) overrides it (tests)."""
    if os.environ.get("MODE_SPACES"):
        with open(os.environ["MODE_SPACES"], "rb") as f:
            return plistlib.load(f)
    try:
        sl = ctypes.CDLL("/System/Library/PrivateFrameworks/SkyLight.framework/SkyLight")
        cf = ctypes.CDLL(ctypes.util.find_library("CoreFoundation"))
        sl.SLSMainConnectionID.restype = ctypes.c_int
        sl.SLSCopyManagedDisplaySpaces.restype = ctypes.c_void_p
        sl.SLSCopyManagedDisplaySpaces.argtypes = [ctypes.c_int]
        cf.CFPropertyListCreateData.restype = ctypes.c_void_p
        cf.CFPropertyListCreateData.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_long, ctypes.c_ulong, ctypes.c_void_p]
        cf.CFDataGetLength.restype = ctypes.c_long
        cf.CFDataGetLength.argtypes = [ctypes.c_void_p]
        cf.CFDataGetBytePtr.restype = ctypes.c_void_p
        cf.CFDataGetBytePtr.argtypes = [ctypes.c_void_p]
        cf.CFRelease.argtypes = [ctypes.c_void_p]
        spaces = sl.SLSCopyManagedDisplaySpaces(sl.SLSMainConnectionID())
        if spaces:
            data = cf.CFPropertyListCreateData(None, spaces, 200, 0, None)  # binary plist
            if not data:  # something in it isn't a plist type
                cf.CFRelease(spaces)
                raise ValueError("desktop list isn't a plist")
            raw = ctypes.string_at(cf.CFDataGetBytePtr(data), cf.CFDataGetLength(data))
            cf.CFRelease(data)
            cf.CFRelease(spaces)
            return plistlib.loads(raw)
    except (OSError, AttributeError, TypeError, ValueError, plistlib.InvalidFileException):
        pass
    out = subprocess.run(["defaults", "export", "com.apple.spaces", "-"], capture_output=True).stdout
    try:
        return plistlib.loads(out)["SpacesDisplayConfiguration"]["Management Data"]["Monitors"]
    except (plistlib.InvalidFileException, KeyError, ValueError):
        return []


def active_space():
    """The space in front (on the display with focus), from SkyLight; None if it can't tell."""
    if os.environ.get("MODE_SPACES"):
        return None
    try:
        sl = ctypes.CDLL("/System/Library/PrivateFrameworks/SkyLight.framework/SkyLight")
        sl.SLSMainConnectionID.restype = ctypes.c_int
        sl.SLSGetActiveSpace.restype = ctypes.c_uint64
        sl.SLSGetActiveSpace.argtypes = [ctypes.c_int]
        return int(sl.SLSGetActiveSpace(sl.SLSMainConnectionID())) or None
    except (OSError, AttributeError):
        return None


def desktops(every_display=False):
    """(desktop space IDs of the display in front, in order; the space in front, which may be a
    full-screen app's rather than a desktop). With every_display, the desktops of all displays.
    Full-screen spaces (type 4) aren't desktops."""
    monitors = [m for m in managed_spaces() if m.get("Spaces")]
    def ids_of(m):
        return [sp.get("ManagedSpaceID") for sp in m["Spaces"] if sp.get("type", 0) == 0]
    if every_display:
        return [i for m in monitors for i in ids_of(m)], None
    active = active_space()
    front = (next((m for m in monitors if (m.get("Current Space") or {}).get("ManagedSpaceID") == active), None)
             or next((m for m in monitors if m.get("Display Identifier") == "Main"), None)
             or (monitors[0] if monitors else None))
    if not front:
        return [], None
    return ids_of(front), active or (front.get("Current Space") or {}).get("ManagedSpaceID")


JXA_APPS = r'''
function run(argv) {
  ObjC.import("AppKit"); ObjC.import("CoreGraphics");
  const names = JSON.parse(argv[0]);
  const wins = ObjC.deepUnwrap(ObjC.castRefToObject($.CGWindowListCopyWindowInfo(
    $.kCGWindowListOptionOnScreenOnly | $.kCGWindowListExcludeDesktopElements, 0))) || [];
  // Match by the app bundle's file name (what `open -a` takes): process names differ ("Code - Insiders").
  const running = {};
  const list = $.NSWorkspace.sharedWorkspace.runningApplications;
  for (let i = 0; i < list.count; i++) {
    const a = list.objectAtIndex(i);
    if (a.bundleURL.isNil()) continue;
    const file = a.bundleURL.lastPathComponent.js.replace(/\.app$/, "");
    running[file] = a.processIdentifier;
  }
  const out = {};
  for (const n of names) {
    const pid = n in running ? running[n] : null;
    out[n] = {running: pid !== null, here: wins.filter(w => w.kCGWindowLayer === 0 && w.kCGWindowOwnerPID === pid).length};
  }
  return JSON.stringify(out);
}'''


def app_state(names):
    """{app name: {"running": bool, "here": windows on the current desktop}}."""
    try:
        r = subprocess.run(["osascript", "-l", "JavaScript", "-e", JXA_APPS, json.dumps(names)],
                           capture_output=True, text=True, timeout=10)
        return json.loads(r.stdout)
    except (ValueError, subprocess.TimeoutExpired):
        return {n: {"running": False, "here": 0} for n in names}


def btt(action):
    """Run one BTT action (JSON) and wait for it."""
    try:
        subprocess.run(["osascript", "-e", "on run argv", "-e",
                        'tell application "BetterTouchTool" to trigger_action (item 1 of argv)', "-e", "end run",
                        json.dumps(action)], capture_output=True, timeout=15)
    except subprocess.TimeoutExpired:
        print(f"mode: BTT didn't answer (action {action['BTTPredefinedActionType']})", file=sys.stderr)


def wait(check, timeout=4.0, step=0.15):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        if check():
            return True
        time.sleep(step)
    return check()


def go_to(space):
    btt({"BTTPredefinedActionType": 550, "BTTAdditionalActionData": {"BTTActionGoToSpaceByID": space}})
    wait(lambda: desktops()[1] == space)
    time.sleep(0.3)  # the switch animation


# BTT's "Move Window To Desktop N" actions.
MOVE_TO_DESKTOP = {**{n: 215 + n for n in range(1, 6)}, **{n: 216 + n for n in range(6, 10)},
                   **{n: 226 + n for n in range(10, 20)}}


def place(cell):
    first, span, of = parse_cell(cell)
    config = {"BTTMoveResizeVersion": 3, "BTTActiveOrHoveredWindow": 0, "BTTScreensToMove": 0, "BTTOriginDisplay": 2,
              "BTTPlacementMode": 1, "BTTGridColumns": of, "BTTGridRows": 1, "BTTGridColumn": first,
              "BTTGridRow": 1, "BTTGridColumnSpan": span, "BTTGridRowSpan": 1, "BTTGridGap": 0,
              "BTTUseVisibleFrame": 1, "BTTCareForStageManager": 0}
    btt({"BTTPredefinedActionType": 251, "BTTActionMoveResizeName": f"mode: {cell}",
         "BTTActionMoveResizeConfig": json.dumps(config)})


def activate(name):
    subprocess.run(["open", "-a", name], capture_output=True)


def notify(text):
    try:
        subprocess.run(["osascript", "-e", "on run argv", "-e",
                        'tell application "BetterTouchTool" to display_notification (item 1 of argv) with title "Mode" sound name ""',
                        "-e", "end run", text], capture_output=True, timeout=10)
    except subprocess.TimeoutExpired:
        pass
    print(text)


def turn_on_scene(scene):
    """A Home Assistant scene, with the token ha-mcp keeps in the Keychain."""
    token = subprocess.run(["security", "find-generic-password", "-s", "ha-mcp", "-a", "echo-homeassistant", "-w"],
                           capture_output=True, text=True).stdout.strip()
    if not token:
        print("mode: no Home Assistant token in the Keychain (ha-mcp --store-token)", file=sys.stderr)
        return
    req = urllib.request.Request(f"{HA_URL}/api/services/scene/turn_on", data=json.dumps({"entity_id": scene}).encode(),
                                 headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    try:
        urllib.request.urlopen(req, timeout=5).close()
    except Exception as e:  # network, HTTP or a bad URL: the mode still switches
        print(f"mode: couldn't turn on {scene}: {type(e).__name__}", file=sys.stderr)


# ---- modes ---------------------------------------------------------------------------------------
def docked(setup):
    """Docked: an external display (lid closed, or open beside it). Travel: the laptop alone."""
    return setup in ("docked-closed", "docked-open")


def bring_here(app, space):
    """A window of the app on the mode's desktop, in front. False if none arrived: then nothing may
    be placed, since BTT places whatever window is in front."""
    name = app["name"]
    if desktops()[1] != space:
        go_to(space)
    st = app_state([name])[name]
    if not st["here"]:
        if app.get("new_window") and st["running"]:
            subprocess.run(app["new_window"], capture_output=True)
        elif not st["running"]:
            activate(name)  # launches here
        else:
            # A one-window app on another desktop: activating it takes us there; send its window
            # back. (A window in full screen can't be moved: it stays, and the check below fails.)
            activate(name)
            wait(lambda: desktops()[1] != space, timeout=2)
            ids, _ = desktops()
            if desktops()[1] in ids and space in ids and ids.index(space) + 1 in MOVE_TO_DESKTOP:
                btt({"BTTPredefinedActionType": MOVE_TO_DESKTOP[ids.index(space) + 1]})
            go_to(space)
        if not wait(lambda: app_state([name])[name]["here"] > 0, timeout=12):
            if desktops()[1] != space:
                go_to(space)
            return False
    activate(name)
    time.sleep(0.2)
    if desktops()[1] != space:  # macOS took us to another of its windows: don't place that one
        go_to(space)
        return False
    return True


def switch(mode, cfg, state):
    apps = cfg["apps"]
    every = desktops(every_display=True)[0]
    if every:  # forget desktops that were closed (on any display)
        state["spaces"] = {m: sid for m, sid in state["spaces"].items() if sid in every}
    setup = detect_setup()
    if setup is None:
        notify("Can't tell which screens are connected; try again in a moment.")
        return False
    if docked(setup):
        ids, current = desktops()
        if not ids:
            notify("Can't read the desktops; try again in a moment.")
            return False
        space = state["spaces"].get(mode["name"])
        if space not in ids:  # never opened, or its desktop was closed: take this one
            if current not in ids:
                notify("This is a full-screen app's space. Go to a desktop and switch again.")
                return False
            owner = next((m for m, sid in state["spaces"].items() if sid == current and m != mode["name"]), None)
            if owner:
                title = next((m["title"] for m in cfg["mode"] if m["name"] == owner), owner)
                notify(f"This desktop is {title}'s. Add a desktop in Mission Control, go there and switch again.")
                return False
            space = current
            state["spaces"][mode["name"]] = space
        missing = []
        for aid, cell in mode["layout"]:
            if bring_here(apps[aid], space):
                place(cell)
            else:
                missing.append(apps[aid]["name"])
        main = apps[mode["layout"][0][0]]["name"]
        if main not in missing:
            activate(main)
            if desktops()[1] != space:
                go_to(space)
        if missing:
            notify(f"{mode['title']}: no window from {', '.join(missing)} here (not open yet, or in full screen).")
    else:
        # Travel: each app full screen, on a space of its own; the main app last, in front.
        for aid, _ in list(reversed(mode["layout"])):
            name = apps[aid]["name"]
            activate(name)
            if not wait(lambda: app_state([name])[name]["running"], timeout=12):
                continue
            time.sleep(1)
            btt({"BTTPredefinedActionType": 112})  # Enter Fullscreen (if it isn't)
            time.sleep(0.8)
    state["current"] = mode["name"]
    if mode.get("scene"):
        turn_on_scene(mode["scene"])
    notify(f"{mode['title']}")
    return True


def apply(cfg, state):
    """Lay the current mode out again on its desktop, if that's the one in front (after a display
    change). Never adds desktops or moves windows between them."""
    mode = next((m for m in cfg["mode"] if m["name"] == state.get("current")), None)
    # Docking fires several display events: one layout is enough. CGDisplayPixelsWide is in
    # points; the ultrawide is 5120 wide, the KVM's placeholder 1920.
    if time.time() - state.get("applied_at", 0) < 10:
        return
    if not mode or not docked(detect_setup()) or main_display_width() < MIN_WIDTH:
        return
    ids, current = desktops()
    if current != state["spaces"].get(mode["name"]):
        return
    front = subprocess.run(["lsappinfo", "front"], capture_output=True, text=True).stdout.strip()
    names = [cfg["apps"][aid]["name"] for aid, _ in mode["layout"]]
    here = app_state(names)
    for aid, cell in mode["layout"]:
        name = cfg["apps"][aid]["name"]
        if here[name]["here"]:
            activate(name)
            time.sleep(0.2)
            if desktops()[1] != current:
                go_to(current)
                continue
            place(cell)
    state["applied_at"] = time.time()
    if front:
        subprocess.run(["lsappinfo", "setfront", front], capture_output=True)


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "get"
    cfg = load_config()
    problems = validate(cfg)
    if problems:
        sys.exit("mode: macos/modes.toml: " + "; ".join(problems))
    modes = cfg["mode"]
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(LOCK, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)  # one switch at a time
    state = load_state()
    if cmd == "get":
        print(state.get("current") or "none")
        return
    if cmd == "list":
        for m in modes:
            print(f"Hyper+{m['key']}  {m['name']:<10} {m['title']}")
        return
    if cmd == "apply":
        apply(cfg, state)
    elif cmd == "next":
        names = [m["name"] for m in modes]
        cur = state.get("current")
        switch(modes[(names.index(cur) + 1) % len(modes) if cur in names else 0], cfg, state)
    elif cmd in [m["name"] for m in modes]:
        try:
            switch(next(m for m in modes if m["name"] == cmd), cfg, state)
        finally:
            save_state(state)  # a desktop it took is remembered even if something failed later
        return
    else:
        print(next(p for p in __doc__.split("\n\n") if p.startswith("  mode ")))
        sys.exit(2)
    save_state(state)


if __name__ == "__main__":
    main()
