#!/bin/sh
# Auth header for Cloudflare's API MCP server (https://mcp.cloudflare.com/mcp), the
# `headersHelper` of the user-scope "cloudflare" server (registered by claude-setup). The
# token is read-only: the server has no read-only switch, so the token is the only limit
# (docs/cloudflare-mcp.md).
#
# Claude Code gives a headersHelper 10 s and runs it on every connect, so the token is never
# read from 1Password at runtime. It's stored once, by `cf-mcp-headers --store-token`:
#   macOS   the login Keychain (service cf-mcp); mac-setup runs it
#   Linux   ~/.config/cf-mcp/token, mode 0600 (no Keychain there)
# `--store-token` reads 1Password; `--store-token -` reads the token on stdin instead, for a
# machine where 1Password can't be reached (echo-turbine over SSH). From a Mac:
#   security find-generic-password -s cf-mcp -a cloudflare-readonly -w |
#     ssh echo-turbine '~/.local/bin/cf-mcp-headers --store-token -'
SERVICE=cf-mcp
ACCOUNT=cloudflare-readonly
REF="op://Automation/Cloudflare MCP read-only Token/credential"
FILE="${XDG_CONFIG_HOME:-$HOME/.config}/cf-mcp/token"
case "${CF_MCP_STORE:-$(uname -s)}" in Darwin|keychain) STORE="keychain" ;; *) STORE="file" ;; esac

valid() { case "$1" in *[!A-Za-z0-9_-]*|"") return 1 ;; esac; }

read_token() {
  if [ "$STORE" = keychain ]; then
    security find-generic-password -s "$SERVICE" -a "$ACCOUNT" -w 2>/dev/null
  else
    cat "$FILE" 2>/dev/null
  fi
}

if [ "${1:-}" = --store-token ]; then
  if [ "${2:-}" = - ]; then IFS= read -r token || [ -n "$token" ]; else token="$(op read "$REF")" || exit 1; fi
  # A Cloudflare token is letters, digits, - and _, so it's safe unquoted below and in JSON.
  valid "$token" || { echo "cf-mcp-headers: unexpected token format" >&2; exit 1; }
  if [ "$STORE" = keychain ]; then
    # The token reaches security on stdin, never in argv where other processes could see it
    # (`security -i` reads the command from stdin; printf is a shell builtin).
    printf 'add-generic-password -U -s %s -a %s -l "Cloudflare read-only token (cf-mcp-headers)" -w %s\n' \
      "$SERVICE" "$ACCOUNT" "$token" | security -i >/dev/null 2>&1
    where="the Keychain ($SERVICE)"
  else
    (umask 077; mkdir -p "$(dirname "$FILE")" && printf '%s\n' "$token" > "$FILE.tmp" && mv "$FILE.tmp" "$FILE") || exit 1
    where="$FILE"
  fi
  [ "$(read_token)" = "$token" ] || {
    echo "cf-mcp-headers: the stored token doesn't match; nothing usable stored" >&2; exit 1; }
  echo "Stored the Cloudflare read-only token in $where."
  exit 0
fi

[ $# -eq 0 ] || { echo "usage: cf-mcp-headers [--store-token [-]]" >&2; exit 2; }
token="$(read_token)"
if [ -z "$token" ]; then
  echo "cf-mcp-headers: no Cloudflare token stored; run: cf-mcp-headers --store-token" >&2
  exit 1
fi
valid "$token" || { echo "cf-mcp-headers: the stored token has unexpected characters" >&2; exit 1; }
printf '{"Authorization": "Bearer %s"}\n' "$token"
