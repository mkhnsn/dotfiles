#!/usr/bin/env python3
"""hints: teaches the controls in macos/btt/triggers.toml, one hint at a time.

BTT runs `hints app` whenever the app in front changes. The first time each day it shows one
general hint (a trigger with no `apps`), and the first time each day you switch to an app it
shows one hint for that app (a trigger listing it in `apps`). Hints are BTT notifications titled
"Hint", closed while their banner is up so they don't pile up in Notification Center. Hyper+H
opens the cheat sheet, whose last rows run `hints next` and `hints mute`.

The setup (docked with the lid closed, docked with the lid open, laptop only) decides which
surfaces a hint and the cheat sheet name: the Stream Deck only when docked, touch only with the
lid open. BTT runs `hints setup` when a screen connects or disconnects and when the lid opens or
closes: it updates the cheat sheet's rows, and the first 3 times in each setup it shows what
works there. `hints app` only keeps the rows current (after a dock with no event, or when BTT
restarted and reloaded them).

Which hint: one you haven't been shown yet, then the one shown least. A trigger fired 3 times
(~/.local/state/triggers.log) is skipped: you know it.

  hints app [bundle-id]      the daily hints, for the app in front (BTT runs this)
  hints setup                the setup changed: update the cheat sheet, maybe say what works now
  hints next [bundle-id]     another hint now, for the app in front (or a general one)
  hints mute [bundle-id|general|setup]   stop hints for an app, the general ones, or the
                             setup-change ones; with no argument,
                             what today's last hint was for, else the app in front (when it has
                             hints), else the general ones
  hints unmute <bundle-id|general|setup>
  hints on | off             all hints (the cheat sheet stays)
  hints status

Runs are serialized with a lock (BTT starts one on every app switch). State:
~/.local/state/hints.json. Python 3.11+ standard library only (tomllib).
"""
import ctypes, ctypes.util, datetime, fcntl, html, importlib.machinery, importlib.util, json, os, re, subprocess, sys, tempfile

try:
    import tomllib
except ModuleNotFoundError:
    # BTT runs scripts with a bare PATH, which finds macOS's Python 3.9 (no tomllib).
    if not os.environ.get("HINTS_REEXEC"):  # once: two old Pythons mustn't exec each other forever
        os.environ["HINTS_REEXEC"] = "1"
        for py in ("/opt/homebrew/bin/python3", "/usr/local/bin/python3"):
            if os.path.exists(py) and os.path.realpath(py) != os.path.realpath(sys.executable):
                os.execv(py, [py, *sys.argv])
    sys.exit("hints: needs Python 3.11 or later (brew install python)")

STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"))
STATE = os.path.join(STATE_DIR, "hints.json")
LOCK = os.path.join(STATE_DIR, "hints.lock")
LOG = os.path.join(STATE_DIR, "triggers.log")
KNOWN_AFTER = 3  # fired this many times: no more hints about it
CLOSE_AFTER = 4  # seconds: BTT can only close a notification while its banner is up (~5 s)
GENERAL = "general"
SETUP = "setup"
SETUP_HINTS = 3  # setup-change hints per setup
SETUP_NAMES = {"docked-closed": "Docked, lid closed", "docked-open": "Docked, lid open", "laptop": "Laptop"}


def trigger_check():
    """trigger-check as a module: the surfaces table and the cheat sheet's row format."""
    here = os.path.dirname(os.path.realpath(__file__))
    for name in ("trigger-check", "executable_trigger-check"):
        path = os.path.join(here, name)
        if os.path.exists(path):
            loader = importlib.machinery.SourceFileLoader("trigger_check", path)
            mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("trigger_check", loader))
            loader.exec_module(mod)
            return mod
    sys.exit("hints: trigger-check isn't next to hints")


TC = trigger_check()


def detect_setup(cg=None):
    """docked-closed, docked-open or laptop, or None when it can't tell. It reads the online
    displays, which include sleeping and mirrored ones (the active list leaves those out): an
    external one means docked; the built-in one, online and awake, means the lid is open.
    HINTS_SETUP overrides it (tests)."""
    if os.environ.get("HINTS_SETUP"):
        return os.environ["HINTS_SETUP"]
    try:
        cg = cg or ctypes.CDLL(ctypes.util.find_library("CoreGraphics"))
        cg.CGDisplayIsBuiltin.restype = ctypes.c_bool
        cg.CGDisplayIsAsleep.restype = ctypes.c_bool
        ids, n = (ctypes.c_uint32 * 16)(), ctypes.c_uint32()
        if cg.CGGetOnlineDisplayList(16, ids, ctypes.byref(n)) != 0 or n.value == 0:
            return None  # no displays at all (asleep, mid-change): don't guess
        displays = [(bool(cg.CGDisplayIsBuiltin(ids[i])), bool(cg.CGDisplayIsAsleep(ids[i]))) for i in range(n.value)]
    except (OSError, TypeError, AttributeError):
        return None
    lid_open = any(b and not asleep for b, asleep in displays)
    if not any(not b for b, _ in displays):
        return "laptop" if lid_open else None
    return "docked-open" if lid_open else "docked-closed"


def surfaces_in(setup):
    """The surfaces this setup has (key is always one)."""
    return {s for s, setups in TC.SURFACES.items() if setup is None or setup in setups}


def source_dir():
    d = os.environ.get("CHEZMOI_SOURCE_DIR") or os.path.expanduser("~/.local/share/chezmoi")
    if os.path.isdir(d):
        return d
    return subprocess.run(["chezmoi", "source-path"], capture_output=True, text=True).stdout.strip()


def load_triggers():
    with open(os.path.join(source_dir(), "macos/btt/triggers.toml"), "rb") as f:
        return [t for t in tomllib.load(f).get("trigger", []) if t.get("hint")]


def load_state():
    try:
        with open(STATE) as f:
            s = json.load(f)
    except (OSError, ValueError):
        s = {}
    if not isinstance(s, dict):
        s = {}
    for key, kind, default in (("enabled", bool, True), ("muted", list, []), ("seen", dict, {}),
                               ("shown_on", dict, {}), ("last", dict, {}), ("setup_shown", dict, {}),
                               ("rows", dict, {})):
        if not isinstance(s.get(key), kind):
            s[key] = default
    return s


def save_state(s):
    fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=".hints.")
    with os.fdopen(fd, "w") as f:
        json.dump(s, f, indent=2, sort_keys=True)
        f.write("\n")
    os.replace(tmp, STATE)


def fired_counts():
    counts = {}
    try:
        with open(LOG) as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 3:
                    counts[parts[1]] = counts.get(parts[1], 0) + 1
    except OSError:
        pass
    return counts


def front_app():
    """(bundle id, name) of the app in front, or (None, None)."""
    try:
        asn = subprocess.run(["lsappinfo", "front"], capture_output=True, text=True).stdout.strip()
        info = subprocess.run(["lsappinfo", "info", "-only", "bundleid", asn], capture_output=True, text=True).stdout
        name = subprocess.run(["lsappinfo", "info", "-only", "name", asn], capture_output=True, text=True).stdout
    except OSError:
        return None, None
    b = re.search(r'bundleID="([^"]+)"', info)
    n = re.match(r'\s*"([^"]+)"', name)
    return (b.group(1) if b else None), (n.group(1) if n else None)


def candidates(triggers, scope):
    if scope == GENERAL:
        return [t for t in triggers if not t.get("apps")]
    return [t for t in triggers if scope in t.get("apps", [])]


def pick(triggers, scope, state, counts):
    """The next hint for a scope (GENERAL or a bundle id), or None."""
    pool = [t for t in candidates(triggers, scope) if counts.get(t["name"], 0) < KNOWN_AFTER]
    if not pool:
        return None
    order = {t["name"]: i for i, t in enumerate(triggers)}
    return min(pool, key=lambda t: (state["seen"].get(t["name"], 0), order[t["name"]]))


def show(t, scope, app_name, state, setup=None):
    title = "Hint" if scope == GENERAL else f"Hint: {app_name or scope}"
    have = surfaces_in(setup if setup is not None else detect_setup())
    also = [TC.SURFACE_NAMES[s] for s in t.get("fires", []) if s in TC.SURFACE_NAMES and s in have]
    body = t["hint"] + (f" (or the {' or '.join(also)})" if also else "") + " · Hyper+H for all"
    notify(title, body)
    state["seen"][t["name"]] = state["seen"].get(t["name"], 0) + 1
    state["last"] = {"scope": scope, "on": datetime.date.today().isoformat()}


def notify(title, body):
    script = ['on run argv',
              'tell application "BetterTouchTool" to display_notification (item 2 of argv) '
              'with title (item 1 of argv) sound name ""',
              'end run']
    args = ["osascript"] + sum((["-e", line] for line in script), []) + [title, body]
    try:
        subprocess.run(args, capture_output=True, timeout=10)
    except subprocess.TimeoutExpired:
        pass
    # Close it after a few seconds (named trigger hints-close: BTT's Close Notifications, by title).
    subprocess.Popen(["/bin/sh", "-c", f"sleep {CLOSE_AFTER}; osascript -e 'tell application "
                      "\"BetterTouchTool\" to trigger_named_async_without_response \"hints-close\"'"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_app(args, state):
    if not state["enabled"]:
        return
    bundle, name = (args[0], args[0]) if args else front_app()
    triggers, counts = load_triggers(), fired_counts()
    today = datetime.date.today().isoformat()
    setup = detect_setup()
    refresh_rows(setup, triggers, state)
    for scope in (GENERAL, bundle):
        if not scope or scope in state["muted"] or state["shown_on"].get(scope) == today:
            continue
        t = pick(triggers, scope, state, counts)
        if scope != GENERAL and not candidates(triggers, scope):
            continue  # no hints for this app: nothing to remember
        state["shown_on"][scope] = today
        if t:
            show(t, scope, name, state, setup)


def btt_pid():
    r = subprocess.run(["pgrep", "-x", "BetterTouchTool"], capture_output=True, text=True)
    return r.stdout.split()[0] if r.stdout.split() else None


def refresh_rows(setup, triggers, state):
    """Rewrite the rows when they're for another setup, or BTT restarted (it reloads the preset's)."""
    if not setup:
        return
    pid = btt_pid()
    if state.get("rows") != {"setup": setup, "btt": pid}:
        update_cheat_sheet(triggers, setup)
        state["rows"] = {"setup": setup, "btt": pid}


def update_cheat_sheet(triggers, setup):
    """Rewrite the cheat sheet's rows for this setup (BTT keeps it until the next import)."""
    have = surfaces_in(setup)
    for t in TC.cheat_sheet_rows(triggers):
        payload = json.dumps({"BTTMenuAttributedText": TC.row_html(TC.row_text(t, have))})
        script = ['on run argv',
                  'tell application "BetterTouchTool" to update_menu_item menu_name (item 1 of argv) '
                  'item_name (item 2 of argv) json (item 3 of argv)',
                  'end run']
        try:
            r = subprocess.run(["osascript"] + sum((["-e", line] for line in script), []) + [TC.MENU, t["name"], payload],
                               capture_output=True, text=True, timeout=10)
            if r.returncode:
                print(f"hints: couldn't update the cheat sheet row {t['name']}: {r.stderr.strip()}", file=sys.stderr)
        except subprocess.TimeoutExpired:
            print("hints: BTT didn't answer; the cheat sheet keeps its rows", file=sys.stderr)
            return


def setup_changed(setup, triggers, state):
    first = "setup" not in state  # the first run on this Mac: just note where it is
    state["setup"] = setup
    refresh_rows(setup, triggers, state)
    shown = state["setup_shown"].get(setup, 0)
    if first or not state["enabled"] or SETUP in state["muted"] or shown >= SETUP_HINTS:
        return
    live = [TC.SURFACE_NAMES[s] for s in ("streamdeck", "knob", "mouse", "touch", "ipad") if s in surfaces_in(setup)]
    used = [s for s in live if any(TC.SURFACE_NAMES.get(f) == s for t in triggers for f in t.get("fires", []))]
    what = (", ".join(used) + " and the Hyper keys") if used else "the Hyper keys"
    notify(f"Hint: {SETUP_NAMES.get(setup, setup)}", f"Here: {what} work. Hyper+H for all.")
    state["setup_shown"][setup] = shown + 1
    state["last"] = {"scope": SETUP, "on": datetime.date.today().isoformat()}


def cmd_setup(_, state):
    setup = detect_setup()
    triggers = load_triggers()
    if setup and setup != state.get("setup"):
        setup_changed(setup, triggers, state)
    else:
        refresh_rows(setup, triggers, state)


def cmd_next(args, state):
    bundle, name = (args[0], args[0]) if args else front_app()
    triggers, counts = load_triggers(), fired_counts()
    for scope in (bundle, GENERAL):
        if scope and candidates(triggers, scope):
            t = pick(triggers, scope, state, counts) or min(
                candidates(triggers, scope), key=lambda t: state["seen"].get(t["name"], 0))
            show(t, scope, name, state)
            return
    print("hints: no hints yet; add a hint to a trigger in triggers.toml")


def cmd_mute(args, state):
    if args:
        scope = args[0]
    elif state["last"].get("on") == datetime.date.today().isoformat():
        scope = state["last"]["scope"]  # the hint on screen, or the one shown last today
    else:
        bundle = front_app()[0]
        scope = bundle if bundle and candidates(load_triggers(), bundle) else GENERAL
    if scope not in state["muted"]:
        state["muted"].append(scope)
    print(f"muted {scope}; hints unmute {scope} brings it back")
    what = {GENERAL: "general controls", SETUP: "setup changes"}.get(scope, scope)
    notify("Hints muted", f"No more hints for {what}. "
           f"hints unmute {scope} brings them back.")


def cmd_unmute(args, state):
    if not args:
        sys.exit("usage: hints unmute <bundle-id|general|setup>")
    if args[0] in state["muted"]:
        state["muted"].remove(args[0])
        print(f"unmuted {args[0]}")
    else:
        print(f"{args[0]} wasn't muted")


def cmd_status(_, state):
    print(f"hints: {'on' if state['enabled'] else 'off'}")
    print(f"muted: {', '.join(state['muted']) or 'nothing'}")
    print(f"setup: {detect_setup() or 'unknown'}")
    triggers, counts = load_triggers(), fired_counts()
    for t in triggers:
        n = counts.get(t["name"], 0)
        known = " (known)" if n >= KNOWN_AFTER else ""
        print(f"  {t['name']:<16} shown {state['seen'].get(t['name'], 0)}, fired {n}{known}")


def main():
    args = sys.argv[1:]
    cmd = args.pop(0) if args else "status"
    if cmd not in ("app", "setup", "next", "mute", "unmute", "status", "on", "off"):
        print(next(p for p in __doc__.split("\n\n") if p.startswith("  hints ")))
        sys.exit(2)
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(LOCK, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)  # one run at a time: read, decide, show, write
    state = load_state()
    if cmd in ("on", "off"):
        state["enabled"] = cmd == "on"
        print(f"hints {cmd}")
    else:
        {"app": cmd_app, "setup": cmd_setup, "next": cmd_next, "mute": cmd_mute, "unmute": cmd_unmute,
         "status": cmd_status}[cmd](args, state)
    if cmd != "status":
        save_state(state)


if __name__ == "__main__":
    main()
