#!/usr/bin/env python3
"""app-prefs — carry chosen app settings between Macs, allow-list only.

  app-prefs export [domain...]   save allow-listed keys from this Mac into the repo
  app-prefs apply  [domain...]   merge the saved keys into this Mac's settings
  app-prefs apply --restart [domain...]   same, but quit running apps that differ and reopen them
  app-prefs check                exit 0 if every saved key matches this Mac
  app-prefs diff                 list domains and key names that differ (never values)

Exit codes: 0 done, 1 some apps were running and skipped (or check found differences),
2 error.

macos/prefs/allowlist holds `domain<TAB>pattern` lines (fnmatch patterns on key names).
Only matching keys are exported, so licenses, purchase records and app state never reach
the repo; the repo is public, so add a key only after checking it holds no secret.
apply merges (defaults export, update, defaults import): keys not in the repo, such as a
license on the new Mac, are kept. A running app is skipped, since it would write its own
settings back when it quits; quit it and run apply again.

BetterMouse (DEVICE_LISTS) is compared by content: its values are nested binary plists, and
- the maps in PAIR_FIELDS are saved as flat [key, value, ...] lists in a new order on every
  save, so they're compared as unordered pairs;
- it keeps one entry per mouse per connection (Bolt receiver, Bluetooth) and adds them as
  devices reconnect, so check only asks that each saved device is here with the same
  settings, and apply updates or adds the saved devices and keeps ones only this Mac has.
"""
import fnmatch
import json
import os
import plistlib
import subprocess
import sys
import time

DEFAULTS = os.environ.get("APP_PREFS_DEFAULTS", "defaults")  # overridable for tests

# domain -> {key: list field inside the key's nested plist}; list items are matched by "name".
DEVICE_LISTS = {
    "com.naotanhaocan.BetterMouse": {"mice": "mice", "keyboards": "keyboards", "logikeys": "logiKeybs"},
}
# Fields BetterMouse saves as flat [key, value, key, value, ...] maps, in a new order each time.
# btn (an app's button mappings, in appitems) has the same shape; one mapping can't show a
# reorder yet, so it's listed on that shape alone.
PAIR_FIELDS = {"twDirInv", "twSpeed", "quirks", "id1b04List", "btn"}


def decode(value):
    """A nested binary plist (bytes) as data; anything else as it is."""
    if isinstance(value, bytes) and value.startswith(b"bplist"):
        try:
            return plistlib.loads(value)
        except Exception:
            return value
    return value


def canon(value, field=None):
    """Comparable form of a decoded value; PAIR_FIELDS lists ignore their pair order."""
    if isinstance(value, dict):
        return {k: canon(v, k) for k, v in value.items()}
    if isinstance(value, list):
        items = [canon(v) for v in value]
        if field in PAIR_FIELDS and len(items) % 2 == 0:
            # JSON with sorted keys, so dicts inside a pair compare by content, not key order.
            return sorted(json.dumps(items[i:i + 2], sort_keys=True, default=repr) for i in range(0, len(items), 2))
        return items
    return value


def device_id(item):
    name = item.get("name") if isinstance(item, dict) else None
    return repr(sorted(name.items())) if isinstance(name, dict) else None


def by_device(items):
    """Devices grouped by name, in order; entries sharing a name (or with none) stay apart."""
    groups = {}
    for item in items:
        groups.setdefault(device_id(item), []).append(item)
    return groups


def device_field(domain, key):
    return DEVICE_LISTS.get(domain, {}).get(key)


def same(domain, key, saved, live):
    """Whether this Mac already has the saved value (see the device-list note above)."""
    if domain not in DEVICE_LISTS:
        return saved == live
    s, l = decode(saved), decode(live)
    field = device_field(domain, key)
    if not (field and isinstance(s, dict) and isinstance(l, dict)):
        return canon(s) == canon(l)
    rest = lambda d: canon({k: v for k, v in d.items() if k != field})
    if rest(s) != rest(l):
        return False
    # Each saved device must be here with the same settings; devices only here don't count.
    here = by_device(l.get(field, []))
    for dev, items in by_device(s.get(field, [])).items():
        pool = [canon(i) for i in here.get(dev, [])]
        for item in items:
            c = canon(item)
            if c not in pool:
                return False
            pool.remove(c)
    return True


def merged(domain, key, saved, live):
    """The value to write: saved, with device lists merged into what's here."""
    field = device_field(domain, key)
    s, l = decode(saved), decode(live)
    if not (field and isinstance(s, dict) and isinstance(l, dict) and isinstance(saved, bytes)):
        return saved
    saved_groups = by_device(s.get(field, []))
    items, placed = [], set()
    for item in l.get(field, []):
        dev = device_id(item)
        if dev is None or dev not in saved_groups:
            items.append(item)           # only on this Mac (or unnamed): keep it
        elif dev not in placed:
            items.extend(saved_groups[dev])  # saved entries for this device replace the Mac's
            placed.add(dev)
    for dev, group in saved_groups.items():
        if dev is None:
            items.extend(i for i in group if canon(i) not in [canon(x) for x in items])
        elif dev not in placed:
            items.extend(group)
    out = dict(s)
    out[field] = items
    return plistlib.dumps(out, fmt=plistlib.FMT_BINARY)


def fail(msg):
    print(f"app-prefs: {msg}", file=sys.stderr)
    sys.exit(2)


def prefs_dir():
    d = os.environ.get("APP_PREFS_DIR")
    if d:
        return d
    # chezmoi sets CHEZMOI_SOURCE_DIR for its scripts; `chezmoi source-path` returns
    # nothing when called from inside a running `chezmoi apply`.
    src = os.environ.get("CHEZMOI_SOURCE_DIR") or subprocess.run(
        ["chezmoi", "source-path"], capture_output=True, text=True).stdout.strip()
    if not src:
        fail("can't find the dotfiles source (set CHEZMOI_SOURCE_DIR or APP_PREFS_DIR)")
    return os.path.join(src, "macos", "prefs")


def allowlist(base):
    rules = {}
    path = os.path.join(base, "allowlist")
    if not os.path.exists(path):
        fail(f"no allowlist at {path}")
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            domain, _, pattern = line.partition("\t")
            if not pattern:
                fail(f"allowlist line needs domain<TAB>pattern: {line!r}")
            rules.setdefault(domain.strip(), []).append(pattern.strip())
    return rules


def read_domain(domain):
    r = subprocess.run([DEFAULTS, "export", domain, "-"], capture_output=True)
    if r.returncode != 0 or not r.stdout.strip():
        return {}
    return plistlib.loads(r.stdout)


def write_domain(domain, data):
    subprocess.run([DEFAULTS, "import", domain, "-"], input=plistlib.dumps(data, fmt=plistlib.FMT_XML), check=True)


def running(domain):
    r = subprocess.run(["lsappinfo", "find", f"bundleid={domain}"], capture_output=True, text=True)
    return bool(r.stdout.strip())


QUIT_WAIT = int(os.environ.get("APP_PREFS_QUIT_WAIT", "20"))  # seconds; overridable for tests


def quit_app(domain, wait=QUIT_WAIT):
    """Ask the app to quit (it saves its own settings first); True once it's gone."""
    r = subprocess.run(["osascript", "-e", f'tell application id "{domain}" to quit'], capture_output=True, text=True)
    if r.returncode != 0:
        # Most often -1743: this terminal isn't allowed to control the app
        # (System Settings > Privacy & Security > Automation).
        print(f"{domain}: couldn't ask it to quit: {r.stderr.strip()}")
        return False
    for _ in range(wait * 2):
        if not running(domain):
            return True
        time.sleep(0.5)
    return False


def allowed(key, patterns):
    return any(fnmatch.fnmatchcase(key, p) for p in patterns)


def saved_path(base, domain):
    return os.path.join(base, f"{domain}.plist")


def load_saved(base, domain):
    p = saved_path(base, domain)
    if not os.path.exists(p):
        return None
    with open(p, "rb") as f:
        return plistlib.load(f)


def pick(rules, names):
    unknown = [n for n in names if n not in rules]
    if unknown:
        fail(f"not in the allowlist: {', '.join(unknown)}")
    return names or sorted(rules)


def cmd_export(base, rules, names):
    for domain in pick(rules, names):
        live = read_domain(domain)
        kept = {k: v for k, v in live.items() if allowed(k, rules[domain])}
        if not kept:
            print(f"{domain}: no allow-listed keys on this Mac, skipped")
            continue
        with open(saved_path(base, domain), "wb") as f:
            plistlib.dump(kept, f, fmt=plistlib.FMT_XML, sort_keys=True)
        print(f"{domain}: saved {len(kept)} of {len(live)} keys")


def cmd_apply(base, rules, names, restart=False):
    skipped = 0
    for domain in pick(rules, names):
        saved = load_saved(base, domain)
        if saved is None:
            continue
        # Never apply a key the allowlist no longer covers.
        saved = {k: v for k, v in saved.items() if allowed(k, rules[domain])}
        reopen = False
        if running(domain):
            if not restart:
                print(f"{domain}: app is running, skipped (quit it, then run app-prefs apply)")
                skipped += 1
                continue
            if all(same(domain, k, v, read_domain(domain).get(k)) for k, v in saved.items()):
                print(f"{domain}: already matches")
                continue
            if not quit_app(domain):
                print(f"{domain}: app didn't quit, skipped (quit it, then run app-prefs apply)")
                skipped += 1
                continue
            reopen = True
        live = read_domain(domain)
        for k, v in saved.items():
            live[k] = merged(domain, k, v, live.get(k))
        write_domain(domain, live)
        print(f"{domain}: applied {len(saved)} keys" + (", reopening the app" if reopen else ""))
        if reopen:
            subprocess.run(["open", "-g", "-b", domain], capture_output=True)
    return 1 if skipped else 0


def differences(base, rules):
    out = []
    for domain in sorted(rules):
        saved = load_saved(base, domain)
        if saved is None:
            continue
        live = read_domain(domain)
        keys = sorted(k for k, v in saved.items() if allowed(k, rules[domain]) and not same(domain, k, v, live.get(k)))
        if keys:
            out.append((domain, keys))
    return out


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd, names = argv[0], argv[1:]
    base = prefs_dir()
    rules = allowlist(base)
    if cmd == "export":
        cmd_export(base, rules, names)
        return 0
    if cmd == "apply":
        restart = "--restart" in names
        return cmd_apply(base, rules, [n for n in names if n != "--restart"], restart)
    if cmd == "check":
        return 1 if differences(base, rules) else 0
    if cmd == "diff":
        for domain, keys in differences(base, rules):
            print(f"  {domain}: {', '.join(keys)}")
        return 0
    print("usage: app-prefs export|apply|check|diff [domain...]", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
