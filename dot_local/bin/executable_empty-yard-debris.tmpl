#!/bin/bash
# empty-yard-debris — delete local branches whose remote branch is gone, in the current repo.
#
# Fetches with --prune, finds local branches whose upstream was deleted (typically
# after a PR merged), and checks each one against the default branch:
#   merged    - already in the default branch           -> deleted
#   squashed  - squash-merged into the default branch   -> deleted
#   unmerged  - has work the default branch doesn't     -> kept (unless -f)
#
# Usage: empty-yard-debris [-n] [-y] [-f] [--no-fetch]
#   -n, --dry-run   Show what would be deleted, change nothing
#   -y, --yes       Don't ask for confirmation
#   -f, --force     Also delete unmerged gone branches (their commits become unreachable)
#   --no-fetch      Use the remote state from the last fetch
#   -h, --help
#
# For many repos at once: git-sweep --gone

set -u

{{ template "git-branches.sh" }}

DRY=0; YES=0; FORCE=0; FETCH=1
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) DRY=1 ;;
    -y|--yes) YES=1 ;;
    -f|--force) FORCE=1 ;;
    --no-fetch) FETCH=0 ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown option: $1 (try --help)" >&2; exit 2 ;;
  esac
  shift
done

if [ -t 1 ]; then
  C0=$'\033[0m'; CB=$'\033[1m'; CG=$'\033[32m'; CY=$'\033[33m'; CR=$'\033[31m'; CD=$'\033[2m'
else
  C0=; CB=; CG=; CY=; CR=; CD=
fi

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "Not in a git repository." >&2; exit 1; }
cd "$(git rev-parse --show-toplevel)" || exit 1

if [ $FETCH -eq 1 ]; then
  if [ -n "$(git remote)" ]; then
    git fetch --all --prune --quiet || echo "${CY}Fetch failed; using the last known remote state.${C0}" >&2
  else
    echo "No remotes configured, so no branch can be gone." ; exit 0
  fi
fi

db=$(default_branch)
[ -z "$db" ] && { echo "Couldn't find a default branch (main/master/trunk/develop)." >&2; exit 1; }
base=$(base_ref "$db")
cur=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)

gone=$(gone_branches)
if [ -z "$gone" ]; then
  echo "No local branches with a deleted remote branch. Nothing to do."
  exit 0
fi

DELETE=""; KEEP=""; nd=0; nk=0
echo "${CB}Branches whose remote is gone${C0} ${CD}(compared with $base)${C0}"
while IFS= read -r b; do
  [ -z "$b" ] && continue
  [ "$b" = "$db" ] && continue
  st=$(branch_merge_state "$b" "$base")
  case "$st" in
    merged)   label="${CG}merged${C0}" ;;
    squashed) label="${CG}squash-merged${C0}" ;;
    *)        label="${CR}NOT merged${C0}" ;;
  esac
  note=""; [ "$b" = "$cur" ] && note=" ${CD}(current branch)${C0}"
  if [ "$st" != unmerged ] || [ $FORCE -eq 1 ]; then
    DELETE="$DELETE$b
"; nd=$((nd+1)); action="delete"
  else
    KEEP="$KEEP$b
"; nk=$((nk+1)); action="${CY}keep${C0}"
  fi
  printf '  %-45s %-24s %s%s\n' "$b" "$label" "$action" "$note"
done <<< "$gone"

echo
if [ $nd -eq 0 ]; then
  echo "Nothing safe to delete. $nk unmerged branch(es) kept; rerun with -f to delete them anyway."
  exit 0
fi

if [ $DRY -eq 1 ]; then
  echo "Dry run: would delete $nd branch(es), keep $nk."
  exit 0
fi

if [ $YES -eq 0 ]; then
  if [ ! -t 0 ]; then echo "Not a terminal; rerun with -y to delete without asking." >&2; exit 1; fi
  printf 'Delete %d branch(es)? [y/N] ' "$nd"
  read -r yn
  case "$yn" in [Yy]*) ;; *) echo "Nothing deleted."; exit 0 ;; esac
fi

# If we're standing on a branch we're about to delete, step off it first.
if [ -n "$cur" ] && printf '%s' "$DELETE" | grep -qxF -- "$cur"; then
  if [ -n "$(git status --porcelain)" ]; then
    echo "${CY}Keeping current branch '$cur': it has uncommitted changes.${C0}"
    DELETE=$(printf '%s' "$DELETE" | grep -vxF -- "$cur")
  elif git switch --quiet "$db"; then
    echo "Switched to $db (was on $cur)."
    git merge --ff-only --quiet "$base" 2>/dev/null
  else
    echo "${CY}Couldn't switch to $db; keeping current branch '$cur'.${C0}"
    DELETE=$(printf '%s' "$DELETE" | grep -vxF -- "$cur")
  fi
fi

deleted=0; failed=0
while IFS= read -r b; do
  [ -z "$b" ] && continue
  if git branch -D --quiet -- "$b" 2>/dev/null; then
    deleted=$((deleted+1)); echo "  ${CD}deleted${C0} $b"
  else
    failed=$((failed+1)); echo "  ${CY}couldn't delete${C0} $b (checked out in another worktree?)"
  fi
done <<< "$DELETE"

echo
echo "${CB}Deleted $deleted branch(es)${C0}, kept $nk unmerged$( [ $failed -gt 0 ] && echo ", $failed failed")."
[ $nk -gt 0 ] && [ $FORCE -eq 0 ] && echo "${CD}Unmerged branches still have work; review them, or rerun with -f to delete anyway.${C0}"
exit 0
