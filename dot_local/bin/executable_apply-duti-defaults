#!/usr/bin/env bash
# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Apply Dotfiles Defaults (duti)
# @raycast.mode silent
# Optional parameters:
# @raycast.packageName Dotfiles
# @raycast.icon 🗂️
# @raycast.description Apply ~/.duti file associations using duti

set -euo pipefail

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "apply-duti-defaults: macOS only"
  exit 1
fi

if ! command -v duti >/dev/null 2>&1; then
  echo "apply-duti-defaults: duti not installed (brew install duti)"
  exit 1
fi

if [[ ! -f "$HOME/.duti" ]]; then
  echo "apply-duti-defaults: ~/.duti not found"
  exit 1
fi

duti "$HOME/.duti"
echo "apply-duti-defaults: applied ~/.duti"