#!/usr/bin/env bash
set -euo pipefail

{{ if and (eq .chezmoi.os "linux") .full_setup -}}

command -v dnf >/dev/null 2>&1 || exit 0

{{ template "sudo-once.sh" "fedora-desktop" }}

DE="${XDG_CURRENT_DESKTOP:-}"
DE_lower="${DE,,}"

# ---- GNOME tweaks & themes ----
if [[ "$DE_lower" == *gnome* ]] || command -v gnome-shell >/dev/null 2>&1; then
  echo "fedora-desktop: GNOME detected, installing tweaks..."
  $SUDO dnf install -y gnome-tweaks gnome-themes-extra 2>/dev/null || true

  # Disable GNOME Software autostart (slow, eats RAM — we manage packages via dnf/flatpak)
  AUTOSTART_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
  mkdir -p "$AUTOSTART_DIR"
  GNOME_SW_DESKTOP="$AUTOSTART_DIR/org.gnome.Software.desktop"
  if [[ ! -f "$GNOME_SW_DESKTOP" ]]; then
    cat > "$GNOME_SW_DESKTOP" << 'EOF'
[Desktop Entry]
Type=Application
Name=GNOME Software
Hidden=true
EOF
    echo "fedora-desktop: disabled GNOME Software autostart"
  fi

  # GNOME Extension Manager (via Flatpak)
  if command -v flatpak >/dev/null 2>&1; then
    if ! flatpak list --app 2>/dev/null | grep -q 'com.mattjakeman.ExtensionManager'; then
      echo "fedora-desktop: installing Extension Manager (Flatpak)..."
      # System install via sudo: without it flatpak asks polkit, which fails over SSH.
      $SUDO flatpak install -y --noninteractive flathub com.mattjakeman.ExtensionManager ||
        { todo "Extension Manager: flatpak install failed; run 'sudo flatpak install flathub com.mattjakeman.ExtensionManager'"; RETRY_NEXT_APPLY=1; }
    fi
  fi
fi

# ---- Deja Dup backup tool ----
if command -v flatpak >/dev/null 2>&1; then
  if ! flatpak list --app 2>/dev/null | grep -q 'org.gnome.DejaDup'; then
    echo "fedora-desktop: installing Deja Dup (Flatpak)..."
    # System install via sudo: without it flatpak asks polkit, which fails over SSH.
    $SUDO flatpak install -y --noninteractive flathub org.gnome.DejaDup ||
      { todo "Deja Dup: flatpak install failed; run 'sudo flatpak install flathub org.gnome.DejaDup'"; RETRY_NEXT_APPLY=1; }
  fi
else
  $SUDO dnf install -y deja-dup 2>/dev/null || true
fi

{{ end -}}
